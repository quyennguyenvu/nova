# nova.yaml — project layout descriptor for `nova add`.
#
# `nova add <type> <name>` reads this file to decide WHERE each scaffolded
# component lives and WHICH stack variant to render (e.g. the {db} package for
# repositories, the DI engine for wiring). It is generated by `nova new` to
# record this project's choices; edit it freely if you move directories or
# change conventions. Delete it and `nova add` falls back to nova's built-in
# canonical layout — but then it can't know your stack, so keeping it is best.
#
# Placeholders expanded per component name: {lower} {snake} {title} {db} {cache}

version: 1
module: {{ .ModuleName }}

# Technology choices this project was generated with.
stack:
  http_framework: {{ if .HTTPFramework }}{{ .HTTPFramework }}{{ else }}none{{ end }}
  database: {{ if .Database }}{{ .Database }}{{ else }}none{{ end }}
  query_gen: {{ if .QueryGen }}{{ .QueryGen }}{{ else }}none{{ end }}
  cache: {{ if .Cache }}{{ .Cache }}{{ else }}none{{ end }}
  di: {{ .DI }}
  message_queue: {{ if .MessageQueue }}{{ .MessageQueue }}{{ else }}none{{ end }}

# Where each component type's files are written. Each entry may set:
#   dir     — target directory (required)
#   file    — output filename; omit to let the generator name files
#   package — Go package override
layout:
  entity:
    dir: internal/domain/entity
    file: "{snake}.go"
    package: entity
  port:
    dir: internal/domain
    file: "{snake}.go"
    package: domain
  usecase:
    dir: internal/usecase/{lower}
    package: "{lower}"
  repository:
    dir: internal/adapter/repository/{db}
    file: "{snake}_repository.go"
    package: "{db}"
  cache:
    dir: internal/adapter/repository/redis
    file: "{snake}_cache.go"
    package: redis
  handler:
    dir: internal/transport/http/v1/{lower}
    package: "{lower}"
  grpc:
    dir: internal/transport/grpc
    file: "{snake}.go"
    package: grpc
  worker:
    dir: internal/transport/worker/v1/{lower}
    package: "{lower}"
  publisher:
    dir: internal/adapter/pubsub
    file: "{snake}_publisher.go"
    package: pubsub
  migration:
    dir: sqlc/migrations
  query:
    dir: sqlc/query
    file: "{snake}.sql"
