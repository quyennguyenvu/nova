// Package observability defines the cross-cutting telemetry ports used across
// the application. Logger is the canonical structured-logging surface that
// internal/infrastructure/logger satisfies; pkg/logctx threads it through
// context and inner layers (usecase, repository) depend on it via logctx.From.
//
// Tracing and metrics are intentionally not modelled as ports here: the
// OpenTelemetry package-level APIs (otel.Tracer / otel.Meter) and ctx-threaded
// span context already serve as the seam. Add per-need ports when a layer
// actually needs to be tested without OTel — not before.
package observability

// Logger is the minimal structured-logging surface the application relies on.
// kv arguments are alternating string keys and any values; odd-length input is
// dropped by the implementation. With returns a child logger so inner layers
// can attach extra structured fields without touching the concrete impl.
//
// The human-readable text is the msg argument — never also pass it as a
// "message" kv key, and avoid the reserved field names the implementation adds
// automatically ("time", "level", "caller"); reusing any of them emits a
// duplicate field in the output.
type Logger interface {
	Debug(msg string, kv ...any)
	Info(msg string, kv ...any)
	Warn(msg string, kv ...any)
	Error(msg string, kv ...any)
	With(key string, value any) Logger
}

// Nop returns a Logger that discards everything. It is the port-level default
// so callers that resolve a logger from context (see pkg/logctx) can fall back
// without importing a concrete implementation or nil-checking on every call.
func Nop() Logger { return nopLogger{} }

type nopLogger struct{}

func (nopLogger) Debug(string, ...any)    {}
func (nopLogger) Info(string, ...any)     {}
func (nopLogger) Warn(string, ...any)     {}
func (nopLogger) Error(string, ...any)    {}
func (nopLogger) With(string, any) Logger { return nopLogger{} }
