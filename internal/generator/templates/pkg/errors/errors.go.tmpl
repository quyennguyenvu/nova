// Package errors provides HTTP-focused application errors with a lightweight
// caller-info trace, designed for one-line logging at the transport boundary.
//
// Each Wrap captures the call site (file:line, func, optional context message).
// Frames accumulate innermost-first as the error travels up the layers, so the
// outermost layer can log a single line that points to where the error came
// from and the path it took to get out — without dumping a full stack.
//
// For i18n, the usecase layer attaches a locale.Locale (+ args) to the AppError
// with the L constructor; the HTTP status is derived from the code itself (see
// localeHTTPStatus). The transport boundary resolves the language from request
// context and substitutes args into the translated template — so business code
// never names a language.
//
//	// repository
//	if err := db.Exec(...); err != nil {
//	    return errors.Wrap(err, "insert user")
//	}
//
//	// usecase — locale-aware
//	if existing != nil {
//	    return errors.L(locale.UserEmailExists, input.Email)
//	}
//
//	// transport — log ONCE; translate at write time
//	appErr := errors.ToAppError(err)
//	logger.Error("request failed",
//	    "code",  appErr.Code,
//	    "err",   appErr.Error(),
//	    "trace", appErr.Trace())
//	writeJSON(w, appErr.Code, appErr) // body is translated using ctx language
package errors

import (
	"context"
	stderrors "errors"
	"fmt"
	"net/http"
	"path/filepath"
	"runtime"
	"strings"

	"{{.ModuleName}}/pkg/locale"
)

// Sentinel errors. Use errors.Is to detect kind across wrapped chains.
var (
	ErrNotFound      = stderrors.New("not found")
	ErrAlreadyExists = stderrors.New("already exists")
	ErrInvalid       = stderrors.New("invalid")
	ErrUnauthorized  = stderrors.New("unauthorized")
	ErrForbidden     = stderrors.New("forbidden")
	ErrConflict      = stderrors.New("conflict")
	ErrInternal      = stderrors.New("internal")
)

// Re-export std helpers so callers only import this package.
var (
	Is     = stderrors.Is
	As     = stderrors.As
	Unwrap = stderrors.Unwrap
	Join   = stderrors.Join
)

// Frame is a single caller-info entry captured at wrap time.
type Frame struct {
	File string
	Line int
	Msg  string
}

func (f Frame) String() string {
	loc := fmt.Sprintf("%s:%d", shortFile(f.File), f.Line)

	if f.Msg != "" {
		return fmt.Sprintf("%s (%s)", loc, f.Msg)
	}
	return loc
}

// shortFile renders a captured caller path as "package/file" (the directory
// holding the file + the file), e.g. "user/service.go" — matching the logger's
// caller format so a trace entry and a log "caller" field read the same way,
// without leaking absolute build paths.
func shortFile(file string) string {
	if file == "" || file == "?" {
		return file
	}
	return filepath.Base(filepath.Dir(file)) + "/" + filepath.Base(file)
}

// AppError is the HTTP-mappable error returned to clients at the transport
// boundary. It carries the inner cause and a trail of caller frames captured
// each time the error was wrapped (innermost first).
//
// When Locale is non-zero, the transport boundary translates it into Message
// using the request language and Args; otherwise Message is used as-is.
type AppError struct {
	Code    int           `json:"code"`
	Message string        `json:"message"`
	Locale  locale.Locale `json:"locale,omitempty"`
	Args    []any         `json:"-"`
	Err     error         `json:"-"`
	frames  []Frame
}

func (e *AppError) Error() string {
	switch {
	case e.Err != nil && e.Message == "":
		// Locale-coded errors carry their user-facing text out of band (it's
		// translated at the transport boundary), so Message is empty here —
		// return the inner cause alone instead of a stray leading ": ".
		return e.Err.Error()
	case e.Err != nil:
		return fmt.Sprintf("%s: %v", e.Message, e.Err)
	default:
		return e.Message
	}
}

func (e *AppError) Unwrap() error { return e.Err }

// WithCause attaches an inner diagnostic cause to e without altering its
// client-facing classification (Code/Locale/Message). The cause is never
// rendered to the client — it surfaces only in the access log's
// app_err/app_trace, so an otherwise-opaque 4xx (a body-parse or validation
// failure mapped to a generic locale message) stays traceable by request_id.
// Returns e for chaining; a nil cause or nil receiver is a no-op.
func (e *AppError) WithCause(err error) *AppError {
	if e != nil && err != nil {
		e.Err = err
	}
	return e
}

// Frames returns the caller-info trail, innermost first.
func (e *AppError) Frames() []Frame { return e.frames }

// Origin returns the innermost frame — where the error first originated.
func (e *AppError) Origin() Frame {
	if len(e.frames) == 0 {
		return Frame{}
	}
	return e.frames[0]
}

// Trace returns a compact one-line trail "file:line(msg) → file:line(msg)"
// suitable for a single structured log field at the transport boundary.
func (e *AppError) Trace() string {
	if len(e.frames) == 0 {
		return ""
	}
	parts := make([]string, len(e.frames))
	for i, f := range e.frames {
		parts[i] = f.String()
	}
	return strings.Join(parts, " → ")
}

func captureFrame(skip int, msg string) Frame {
	_, file, line, ok := runtime.Caller(skip + 1)
	if !ok {
		return Frame{File: "?", Msg: msg}
	}

	return Frame{File: file, Line: line, Msg: msg}
}

// Wrap attaches a caller frame (with an optional context message) to err.
// If err is already an *AppError, the frame is appended and Code/Message/
// Locale/Args are preserved so the originating layer's classification stays
// authoritative.
// If err is a plain or sentinel error, it is classified into HTTP terms.
// Returns nil if err is nil — safe to use as `return errors.Wrap(err, "...")`.
func Wrap(err error, message string) *AppError {
	if err == nil {
		return nil
	}
	return wrapAt(err, message, 1)
}

// Wrapf is Wrap with fmt.Sprintf-style formatting for the context message.
func Wrapf(err error, format string, args ...any) *AppError {
	if err == nil {
		return nil
	}
	return wrapAt(err, fmt.Sprintf(format, args...), 1)
}

func wrapAt(err error, message string, skip int) *AppError {
	f := captureFrame(skip+1, message)
	var app *AppError
	if As(err, &app) {
		frames := make([]Frame, len(app.frames), len(app.frames)+1)
		copy(frames, app.frames)
		frames = append(frames, f)
		return &AppError{
			Code:    app.Code,
			Message: app.Message,
			Locale:  app.Locale,
			Args:    app.Args,
			Err:     err,
			frames:  frames,
		}
	}
	base := classify(err)
	base.Err = err
	base.frames = []Frame{f}
	return base
}

// localeHTTPStatus is the single source of truth mapping every HTTP-facing
// locale code to its response status. Both error-construction paths read it via
// httpStatusForLocale: L() (the usecase-facing constructor) and classify() (the
// bare locale.Locale path that reaches the transport boundary). Holding the
// mapping in one table — instead of duplicating it across per-status
// constructors and a parallel switch — means a code has exactly one status, so
// the two paths cannot drift. A code absent from the table resolves to 500; add
// new codes here as you introduce them.
var localeHTTPStatus = map[locale.Locale]int{
	// 400 Bad Request — malformed or invalid client input.
	locale.InvalidRequest: http.StatusBadRequest,

	// 401 Unauthorized — missing or invalid authentication.
	locale.Unauthorized:       http.StatusUnauthorized,
	locale.InvalidCredentials: http.StatusUnauthorized,

	// 403 Forbidden — authenticated but not permitted.
	locale.Forbidden: http.StatusForbidden,

	// 404 Not Found.
	locale.RecordNotFound: http.StatusNotFound,
	locale.UserNotFound:   http.StatusNotFound,

	// 405 Method Not Allowed.
	locale.MethodNotAllowed: http.StatusMethodNotAllowed,

	// 408 Request Timeout.
	locale.RequestTimeout: http.StatusRequestTimeout,

	// 409 Conflict — state, version, or limit conflicts.
	locale.UserEmailExists: http.StatusConflict,
	locale.Conflict:        http.StatusConflict,

	// 413 Content Too Large.
	locale.PayloadTooLarge: http.StatusRequestEntityTooLarge,

	// 415 Unsupported Media Type.
	locale.UnsupportedMediaType: http.StatusUnsupportedMediaType,

	// 422 Unprocessable Entity — semantic validation failure.
	locale.ValidationFailed: http.StatusUnprocessableEntity,

	// 429 Too Many Requests — rate limited.
	locale.TooManyRequests: http.StatusTooManyRequests,

	// 500 Internal Server Error.
	locale.InternalError: http.StatusInternalServerError,

	// 501 Not Implemented — stubbed/unfinished feature.
	locale.Unimplemented: http.StatusNotImplemented,

	// 502 Bad Gateway — invalid response from an upstream dependency.
	locale.BadGateway: http.StatusBadGateway,

	// 503 Service Unavailable — overloaded or down for maintenance.
	locale.ServiceUnavailable: http.StatusServiceUnavailable,

	// 504 Gateway Timeout — upstream dependency timed out.
	locale.GatewayTimeout: http.StatusGatewayTimeout,
}

// httpStatusForLocale returns the HTTP status for a locale code, defaulting to
// 500 for any code not present in localeHTTPStatus.
func httpStatusForLocale(code locale.Locale) int {
	if status, ok := localeHTTPStatus[code]; ok {
		return status
	}
	return http.StatusInternalServerError
}

// classify maps a non-AppError into an *AppError, always locale-coded so the
// transport boundary can translate the client-facing message — no bare strings
// leak out. Recognises:
//   - *locale.LocaleError → its own Locale + Args.
//   - the package sentinel errors → their canonical locale code.
//   - anything else → InternalError (500).
//
// The original error stays reachable as the AppError's cause (set by the
// caller), so its text still surfaces in the access log's app_err/app_trace.
func classify(err error) *AppError {
	var le *locale.LocaleError
	if As(err, &le) {
		return &AppError{
			Code:   httpStatusForLocale(le.Code),
			Locale: le.Code,
			Args:   le.Args,
		}
	}
	switch {
	case Is(err, ErrNotFound):
		return &AppError{Code: http.StatusNotFound, Locale: locale.RecordNotFound}
	case Is(err, ErrAlreadyExists), Is(err, ErrConflict):
		return &AppError{Code: http.StatusConflict, Locale: locale.Conflict}
	case Is(err, ErrInvalid):
		return &AppError{Code: http.StatusBadRequest, Locale: locale.InvalidRequest}
	case Is(err, ErrUnauthorized):
		return &AppError{Code: http.StatusUnauthorized, Locale: locale.Unauthorized}
	case Is(err, ErrForbidden):
		return &AppError{Code: http.StatusForbidden, Locale: locale.Forbidden}
	default:
		return &AppError{Code: http.StatusInternalServerError, Locale: locale.InternalError}
	}
}

// ToAppError normalises any error into an *AppError suitable for HTTP responses.
// If err is already an *AppError, it is returned as-is so its frames are preserved.
func ToAppError(err error) *AppError {
	if err == nil {
		return nil
	}
	var app *AppError
	if As(err, &app) {
		return app
	}
	base := classify(err)
	base.Err = err
	return base
}

// LogFields renders err as structured log key/values for a single diagnostic
// log line, using the SAME field names the HTTP access log emits (app_code,
// app_err, app_trace, app_locale) so an error reads identically whether it
// surfaced from an HTTP request or a worker. Returns nil for a nil error.
//
// Use it anywhere outside the HTTP access-log path that owns its own error
// line — chiefly the Kafka workers, which have no transport middleware to fold
// the cause + trace in for them:
//
//	log.Error("kafka: handle message", errors.LogFields(err)...)
func LogFields(err error) []any {
	if err == nil {
		return nil
	}
	app := ToAppError(err)
	fields := []any{"app_code", app.Code, "app_err", app.Error()}
	if app.Locale != 0 {
		fields = append(fields, "app_locale", int(app.Locale))
	}
	if trace := app.Trace(); trace != "" {
		fields = append(fields, "app_trace", trace)
	}
	return fields
}

// L builds a locale-coded AppError whose message is translated at the transport
// boundary via the request's Accept-Language; Args are substituted into the
// translated template via fmt.Sprintf. The HTTP status is derived from the code
// through localeHTTPStatus — the single source of truth — so callers never
// restate it and a code maps to exactly one status everywhere it is raised.
func L(code locale.Locale, args ...any) *AppError {
	return newAtL(httpStatusForLocale(code), code, args)
}

func newAtL(httpCode int, code locale.Locale, args []any) *AppError {
	return &AppError{
		Code:   httpCode,
		Locale: code,
		Args:   args,
		frames: []Frame{captureFrame(2, "")},
	}
}

// --- AppError context stash --------------------------------------------------
//
// The Logging middleware needs to log the AppError that the handler emitted,
// but the response is written after the middleware's outbound ctx has
// already been observed — and contexts are immutable, so we can't replumb
// ctx upward. PrepareAppErrorContext installs a mutable slot in ctx; a
// handler or error writer calls StashAppError into that slot; the
// middleware reads it via AppErrorFromContext once the handler returns.

type appErrSlot struct{ err *AppError }
type appErrSlotKey struct{}

// PrepareAppErrorContext installs a mutable slot in ctx. Call once per request
// from a transport middleware before invoking inner handlers.
func PrepareAppErrorContext(ctx context.Context) context.Context {
	return context.WithValue(ctx, appErrSlotKey{}, &appErrSlot{})
}

// StashAppError records app in the slot installed by PrepareAppErrorContext.
// No-op if the slot is absent (e.g. background ctx or test ctx).
func StashAppError(ctx context.Context, app *AppError) {
	if s, ok := ctx.Value(appErrSlotKey{}).(*appErrSlot); ok {
		s.err = app
	}
}

// AppErrorFromContext returns the stashed AppError, or nil if none was stashed.
func AppErrorFromContext(ctx context.Context) *AppError {
	s, ok := ctx.Value(appErrSlotKey{}).(*appErrSlot)
	if !ok {
		return nil
	}
	return s.err
}
