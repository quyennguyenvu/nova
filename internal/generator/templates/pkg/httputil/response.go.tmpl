// Package httputil holds the HTTP response envelope and per-framework writers.
//
// All success and error responses share a single shape:
//
//	{
//	  "success": true|false,
//	  "data":    <payload>,           // present on success
//	  "error":   { "code": int, "message": string }, // present on error
//	  "meta":    { "page": int, "per_page": int, "total": int } // optional pagination
//	}
package httputil

import (
	"net/http"

	"{{.ModuleName}}/pkg/errors"
	"{{.ModuleName}}/pkg/locale"
)

// Response is the single envelope for every HTTP response.
type Response struct {
	Success bool       `json:"success"`
	Data    any        `json:"data,omitempty"`
	Error   *ErrorBody `json:"error,omitempty"`
	Meta    *Meta      `json:"meta,omitempty"`
}

// ErrorBody is the machine-readable error payload.
//
// Code is the stable application error identifier (HTTP status when sourced from
// *errors.AppError; locale code when sourced from *locale.LocaleError).
type ErrorBody struct {
	Code    int    `json:"code"`
	Message string `json:"message"`
}

// Meta holds pagination metadata.
type Meta struct {
	Page    int `json:"page,omitempty"`
	PerPage int `json:"perPage,omitempty"`
	Total   int `json:"total,omitempty"`
}

// SuccessResponse builds a success envelope around data.
func SuccessResponse(data any) Response {
	return Response{Success: true, Data: data}
}

// ErrorResponseFromApp builds an error envelope from an *errors.AppError,
// translating the message into lang when the AppError carries a Locale code.
//
// When app.Locale is non-zero the response uses the locale code as the
// machine-readable identifier (more specific than the HTTP status) and the
// message is the translated template with Args substituted. Otherwise the
// envelope falls back to app.Code + app.Message as-is.
//
// A nil app is treated as a generic 500 in the requested language.
func ErrorResponseFromApp(app *errors.AppError, lang locale.Language) Response {
	if app == nil {
		return Response{
			Success: false,
			Error: &ErrorBody{
				Code:    http.StatusInternalServerError,
				Message: locale.Translate(lang, locale.InternalError),
			},
		}
	}
	if app.Locale != 0 {
		return Response{
			Success: false,
			Error: &ErrorBody{
				Code:    int(app.Locale),
				Message: locale.Translate(lang, app.Locale, app.Args...),
			},
		}
	}
	return Response{
		Success: false,
		Error:   &ErrorBody{Code: app.Code, Message: app.Message},
	}
}
