// fakeRepo is an in-memory domain.UserRepository: enough for the service to
// run end to end without a database.
type fakeRepo struct {
	mu     sync.Mutex
	nextID int64
	users  map[int64]*entity.User
}

func newFakeRepo() *fakeRepo { return &fakeRepo{nextID: 1, users: map[int64]*entity.User{}} }

func (r *fakeRepo) Create(_ context.Context, u *entity.User) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	for _, existing := range r.users {
		if strings.EqualFold(existing.Email, u.Email) {
			return errors.Wrapf(errors.ErrAlreadyExists, "fake: email=%s", u.Email)
		}
	}
	u.ID = r.nextID
	r.nextID++
	now := time.Now()
	u.CreatedAt, u.UpdatedAt = now, now
	cp := *u
	r.users[u.ID] = &cp
	return nil
}

func (r *fakeRepo) GetByID(_ context.Context, id int64) (*entity.User, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	u, ok := r.users[id]
	if !ok {
		return nil, errors.Wrapf(errors.ErrNotFound, "fake: id=%d", id)
	}
	cp := *u
	return &cp, nil
}

func (r *fakeRepo) GetByEmail(_ context.Context, email string) (*entity.User, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	for _, u := range r.users {
		if strings.EqualFold(u.Email, email) {
			cp := *u
			return &cp, nil
		}
	}
	return nil, errors.Wrapf(errors.ErrNotFound, "fake: email=%s", email)
}

func (r *fakeRepo) Update(_ context.Context, u *entity.User) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	cp := *u
	r.users[u.ID] = &cp
	return nil
}

func (r *fakeRepo) Delete(_ context.Context, id int64) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	delete(r.users, id)
	return nil
}

// sorted returns copies ordered by id; callers hold the lock.
func (r *fakeRepo) sorted() []*entity.User {
	out := make([]*entity.User, 0, len(r.users))
	for _, u := range r.users {
		cp := *u
		out = append(out, &cp)
	}
	sort.Slice(out, func(i, j int) bool { return out[i].ID < out[j].ID })
	return out
}

func (r *fakeRepo) List(_ context.Context, f domain.UserFilter) ([]*entity.User, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	all := r.sorted()
	start := min(int(f.Offset), len(all))
	end := min(start+int(f.Limit), len(all))
	return all[start:end], nil
}

func (r *fakeRepo) Count(_ context.Context, _ domain.UserFilter) (int64, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	return int64(len(r.users)), nil
}

func (r *fakeRepo) ListAfter(_ context.Context, cursor int64, limit int32) ([]*entity.User, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	var out []*entity.User
	for _, u := range r.sorted() {
		if u.ID > cursor && len(out) < int(limit) {
			out = append(out, u)
		}
	}
	return out, nil
}

type fakeHasher struct{}

func (fakeHasher) Hash(plain string) (string, error) { return "h:" + plain, nil }

func (fakeHasher) Verify(hash, plain string) error {
	if hash != "h:"+plain {
		return errors.ErrUnauthorized
	}
	return nil
}

