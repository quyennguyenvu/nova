// newTokenService builds a real RS256 signer/verifier over a throwaway key,
// so the test exercises the same token path a client would.
func newTokenService(t *testing.T) *jwtsec.TokenService {
	t.Helper()
	key, err := rsa.GenerateKey(rand.Reader, 2048)
	if err != nil {
		t.Fatal(err)
	}
	pubDER, err := x509.MarshalPKIXPublicKey(&key.PublicKey)
	if err != nil {
		t.Fatal(err)
	}
	svc, err := jwtsec.NewTokenService(config.JWTConfig{
		PrivateKey: base64.StdEncoding.EncodeToString(pem.EncodeToMemory(&pem.Block{
			Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(key),
		})),
		PublicKey: base64.StdEncoding.EncodeToString(pem.EncodeToMemory(&pem.Block{
			Type: "PUBLIC KEY", Bytes: pubDER,
		})),
		Issuer:         "test",
		Audience:       "test",
		AccessTokenTTL: time.Hour,
	})
	if err != nil {
		t.Fatal(err)
	}
	return svc
}

type testEnv struct {
	srv    *Server
	client userv1.UserServiceClient
	health healthpb.HealthClient
}

// newTestEnv serves the full transport (interceptors, auth, health) over an
// in-process listener and returns clients for it.
func newTestEnv(t *testing.T) *testEnv {
	t.Helper()
	locale.NewMapping()
	tokenSvc := newTokenService(t)
	svc := usersvc.NewService(newFakeRepo(), fakeHasher{}, tokenSvc, noopTx{}{{if .HasMessageQueue}}, fakePublisher{}{{end}})
	handler := NewUserHandler(svc, validator.New(validator.WithRequiredStructEnabled()))
	srv := New(config.GRPCConfig{Reflection: true}, observability.Nop(), tokenSvc, []Registrar{handler})

	lis := bufconn.Listen(1 << 20)
	go func() { _ = srv.GRPC.Serve(lis) }()
	t.Cleanup(srv.GRPC.Stop)

	conn, err := grpc.NewClient("passthrough:///bufnet",
		grpc.WithContextDialer(func(ctx context.Context, _ string) (net.Conn, error) { return lis.DialContext(ctx) }),
		grpc.WithTransportCredentials(insecure.NewCredentials()),
	)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = conn.Close() })
	return &testEnv{srv: srv, client: userv1.NewUserServiceClient(conn), health: healthpb.NewHealthClient(conn)}
}

func withToken(ctx context.Context, token string) context.Context {
	return metadata.AppendToOutgoingContext(ctx, "authorization", "Bearer "+token)
}

func wantCode(t *testing.T, err error, want codes.Code) {
	t.Helper()
	if got := status.Code(err); got != want {
		t.Fatalf("code = %s, want %s (err: %v)", got, want, err)
	}
}

func TestUserServiceEndToEnd(t *testing.T) {
	env := newTestEnv(t)
	ctx := t.Context()

	ada, err := env.client.CreateUser(ctx, &userv1.CreateUserRequest{
		Email: "ada@example.com", Name: "Ada", Password: "hunter2-pass",
	})
	if err != nil {
		t.Fatalf("create: %v", err)
	}
	if ada.GetUser().GetId() != 1 || ada.GetUser().GetEmail() != "ada@example.com" {
		t.Fatalf("create: unexpected user %v", ada.GetUser())
	}
	_, err = env.client.CreateUser(ctx, &userv1.CreateUserRequest{
		Email: "ada@example.com", Name: "Ada", Password: "hunter2-pass",
	})
	wantCode(t, err, codes.AlreadyExists)
	_, err = env.client.CreateUser(ctx, &userv1.CreateUserRequest{
		Email: "not-an-email", Name: "Ada", Password: "hunter2-pass",
	})
	wantCode(t, err, codes.InvalidArgument)

	_, err = env.client.Login(ctx, &userv1.LoginRequest{Email: "ada@example.com", Password: "wrong-password"})
	wantCode(t, err, codes.Unauthenticated)
	login, err := env.client.Login(ctx, &userv1.LoginRequest{Email: "ada@example.com", Password: "hunter2-pass"})
	if err != nil {
		t.Fatalf("login: %v", err)
	}
	if login.GetAccessToken() == "" || login.GetTokenType() != "Bearer" {
		t.Fatalf("login: unexpected response %v", login)
	}

	_, err = env.client.GetUser(ctx, &userv1.GetUserRequest{Id: 1})
	wantCode(t, err, codes.Unauthenticated)
	authed := withToken(ctx, login.GetAccessToken())
	got, err := env.client.GetUser(authed, &userv1.GetUserRequest{Id: 1})
	if err != nil || got.GetUser().GetName() != "Ada" {
		t.Fatalf("get: %v %v", got.GetUser(), err)
	}

	bob, err := env.client.CreateUser(ctx, &userv1.CreateUserRequest{
		Email: "bob@example.com", Name: "Bob", Password: "hunter2-pass",
	})
	if err != nil {
		t.Fatalf("create bob: %v", err)
	}
	_, err = env.client.UpdateUser(authed, &userv1.UpdateUserRequest{Id: bob.GetUser().GetId(), Name: "Mallory"})
	wantCode(t, err, codes.PermissionDenied)
	upd, err := env.client.UpdateUser(authed, &userv1.UpdateUserRequest{Id: 1, Name: "Ada L"})
	if err != nil || upd.GetUser().GetName() != "Ada L" {
		t.Fatalf("update: %v %v", upd.GetUser(), err)
	}

	list, err := env.client.ListUsers(authed, &userv1.ListUsersRequest{Page: 1, PerPage: 10})
	if err != nil || len(list.GetUsers()) != 2 || list.GetMeta().GetTotalRecord() != 2 {
		t.Fatalf("list: %d users, meta %v, err %v", len(list.GetUsers()), list.GetMeta(), err)
	}
	pub, err := env.client.ListPublicUsers(ctx, &userv1.ListPublicUsersRequest{Limit: 10})
	if err != nil || len(pub.GetUsers()) != 2 || pub.GetHasMore() {
		t.Fatalf("public list: %d users, has_more %v, err %v", len(pub.GetUsers()), pub.GetHasMore(), err)
	}

	if _, err = env.client.DeleteUser(authed, &userv1.DeleteUserRequest{Id: 1}); err != nil {
		t.Fatalf("delete: %v", err)
	}
	_, err = env.client.GetUser(authed, &userv1.GetUserRequest{Id: 1})
	wantCode(t, err, codes.NotFound)
}

func TestHealthFollowsLifecycle(t *testing.T) {
	env := newTestEnv(t)
	resp, err := env.health.Check(t.Context(), &healthpb.HealthCheckRequest{})
	if err != nil || resp.GetStatus() != healthpb.HealthCheckResponse_SERVING {
		t.Fatalf("health before shutdown: %v %v", resp.GetStatus(), err)
	}
	env.srv.Health.Shutdown()
	resp, err = env.health.Check(t.Context(), &healthpb.HealthCheckRequest{})
	if err != nil || resp.GetStatus() != healthpb.HealthCheckResponse_NOT_SERVING {
		t.Fatalf("health after shutdown: %v %v", resp.GetStatus(), err)
	}
}

func TestAcceptLanguageTranslates(t *testing.T) {
	env := newTestEnv(t)
	ctx := metadata.AppendToOutgoingContext(t.Context(), "accept-language", "vi")
	_, err := env.client.Login(ctx, &userv1.LoginRequest{Email: "nobody@example.com", Password: "whatever-pass"})
	st := status.Convert(err)
	if want := locale.Translate(locale.LangVi, locale.InvalidCredentials); st.Code() != codes.Unauthenticated ||
		st.Message() != want {
		t.Fatalf("got %s %q, want Unauthenticated %q", st.Code(), st.Message(), want)
	}
}
