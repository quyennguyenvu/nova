package user

import (
	"github.com/go-chi/chi/v5"

	jwtsec "{{.ModuleName}}/internal/infrastructure/jwt"
	"{{.ModuleName}}/internal/transport/http/middleware"
)

// Routes is the user feature's HTTP route registrar. It implements the
// transport/http.Registrar interface — mounted at /api/v1 by the app.
type Routes struct {
	handler  *Handler
	verifier *jwtsec.Verifier
}

func NewRoutes(h *Handler, verifier *jwtsec.Verifier) *Routes {
	return &Routes{handler: h, verifier: verifier}
}

// Prefix is the API version subtree this feature mounts under.
func (*Routes) Prefix() string { return "/api/v1" }

// Register mounts /users with a public POST (registration) and an
// authenticated subgroup for reads + writes. chi.Router.Group introduces a
// child router that owns the Auth middleware so it never bleeds into siblings.
func (r *Routes) Register(router chi.Router) {
	router.Route("/users", func(sub chi.Router) {
		sub.Post("/", r.handler.Create)

		sub.Group(func(protected chi.Router) {
			protected.Use(middleware.Auth(r.verifier))
			protected.Get("/", r.handler.List)
			protected.Get("/{id}", r.handler.GetByID)
			protected.Put("/{id}", r.handler.Update)
			protected.Delete("/{id}", r.handler.Delete)
		})
	})
}
