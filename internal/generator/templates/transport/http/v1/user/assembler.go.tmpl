package user

import (
	usersvc "{{.ModuleName}}/internal/usecase/user"
)

// ToUserResponse projects a use-case Output into the HTTP response shape.
func ToUserResponse(out *usersvc.Output) *UserResponse {
	return &UserResponse{
		ID:        out.ID,
		Email:     out.Email,
		Name:      out.Name,
		CreatedAt: out.CreatedAt,
		UpdatedAt: out.UpdatedAt,
	}
}

// ToUserListResponse projects a list of use-case Outputs into HTTP response shapes.
func ToUserListResponse(outs []*usersvc.Output) []*UserResponse {
	responses := make([]*UserResponse, len(outs))
	for i, out := range outs {
		responses[i] = ToUserResponse(out)
	}
	return responses
}
