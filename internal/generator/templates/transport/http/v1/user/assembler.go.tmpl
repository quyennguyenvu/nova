package user

import (
	usersvc "{{.ModuleName}}/internal/usecase/user"
	"{{.ModuleName}}/pkg/httputil"
)

// ToUserResponse projects a use-case Output into the HTTP response shape.
func ToUserResponse(out *usersvc.Output) *UserResponse {
	return &UserResponse{
		ID:        out.ID,
		Email:     out.Email,
		Name:      out.Name,
		CreatedAt: out.CreatedAt,
		UpdatedAt: out.UpdatedAt,
	}
}

// ToUserListResponse projects the items of a use-case ListOutput into HTTP
// response shapes — the envelope's `data` payload.
func ToUserListResponse(out *usersvc.ListOutput) []*UserResponse {
	responses := make([]*UserResponse, len(out.Items))
	for i, item := range out.Items {
		responses[i] = ToUserResponse(item)
	}
	return responses
}

// ToUserListMeta projects a use-case ListOutput's pagination into the admin
// page meta (page + perPage + totalPage + totalRecord) — the envelope's `meta`.
// NewPageMeta derives totalPage from totalRecord/perPage.
func ToUserListMeta(out *usersvc.ListOutput) httputil.PageMeta {
	return httputil.NewPageMeta(out.Page, out.PerPage, out.TotalRecord)
}

// ToPublicUserListResponse projects the items of a public list into the
// email+name wire shape — the envelope's `data` payload.
func ToPublicUserListResponse(out *usersvc.PublicListOutput) []*PublicUserResponse {
	responses := make([]*PublicUserResponse, len(out.Items))
	for i, item := range out.Items {
		responses[i] = &PublicUserResponse{Email: item.Email, Name: item.Name}
	}
	return responses
}

// ToPublicUserListMeta projects a public list's cursor seam into the user-facing
// cursor meta (hasMore + nextCursor) — the envelope's `meta`.
func ToPublicUserListMeta(out *usersvc.PublicListOutput) httputil.CursorMeta {
	return httputil.CursorMeta{HasMore: out.HasMore, NextCursor: out.NextCursor}
}

// ToLoginResponse projects a use-case LoginOutput into the wire response.
// tokenType is hardcoded to "Bearer" — clients hand this back as
// "Authorization: Bearer <accessToken>".
func ToLoginResponse(out *usersvc.LoginOutput) *LoginResponse {
	return &LoginResponse{
		AccessToken: out.AccessToken,
		TokenType:   "Bearer",
		ExpiresIn:   out.ExpiresIn,
		User:        ToUserResponse(out.User),
	}
}
