package user

import (
	"github.com/gofiber/fiber/v2"

	"{{.ModuleName}}/internal/infrastructure/config"
	jwtsec "{{.ModuleName}}/internal/infrastructure/jwt"
	"{{.ModuleName}}/internal/transport/http/middleware"
	v1 "{{.ModuleName}}/internal/transport/http/v1"
)

// Registrar registers the user feature's HTTP routes. It implements the
// transport/http.Registrar interface; its Prefix() (/api/v1) comes from the
// embedded v1.Prefixed base, so the prefix is declared once for the section.
//
// The constructor takes the JWT TokenService + rate-limit config so Register
// can build the auth middleware and gate the protected subgroup, and
// throttle the public login endpoint without depending on globals.
type Registrar struct {
	v1.Prefixed
	handler    *Handler
	tokenSvc   *jwtsec.TokenService
	loginLimit config.LoginRateLimitConfig
}

func NewRegistrar(h *Handler, tokenSvc *jwtsec.TokenService, loginLimit config.LoginRateLimitConfig) *Registrar {
	return &Registrar{handler: h, tokenSvc: tokenSvc, loginLimit: loginLimit}
}

// Register mounts:
//   - POST /login             (public — issues bearer token)
//   - POST /users             (public — registration)
//   - GET /public/users       (public — cursor-paginated directory)
//   - GET/PUT/DELETE /users*  (authenticated subgroup)
//
// Splitting at the group level (not per-route) keeps the auth boundary
// obvious; protected routes share one Auth middleware instance.
func (r *Registrar) Register(router fiber.Router) {
	router.Post("/login", middleware.LoginRateLimit(r.loginLimit), r.handler.Login)

	public := router.Group("/users")
	public.Post("/", r.handler.Create)

	pub := router.Group("/public")
	pub.Get("/users", r.handler.PublicList)

	protected := router.Group("/users", middleware.Auth(r.tokenSvc))
	protected.Get("/", r.handler.List)
	protected.Get("/:id", r.handler.GetByID)
	protected.Put("/:id", r.handler.Update)
	protected.Delete("/:id", r.handler.Delete)
}
