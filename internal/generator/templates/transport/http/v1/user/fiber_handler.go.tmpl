package user

import (
	"github.com/go-playground/validator/v10"
	"github.com/gofiber/fiber/v2"

	"{{.ModuleName}}/internal/transport/http/httpwriter"
	usersvc "{{.ModuleName}}/internal/usecase/user"
	"{{.ModuleName}}/pkg/errors"
)

// Handler is the HTTP boundary for user operations. It never logs — the
// Logging middleware reads the AppError back from ctx via the WriteError
// stash and emits one access log per request. Request binding and path-param
// parsing are shared via httpwriter.Bind / httpwriter.ParseID.
type Handler struct {
	userService *usersvc.Service
	validate    *validator.Validate
}

func NewHandler(userService *usersvc.Service, validate *validator.Validate) *Handler {
	return &Handler{userService: userService, validate: validate}
}

func (h *Handler) Create(c *fiber.Ctx) error {
	req, appErr := httpwriter.Bind[CreateUserRequest](c, h.validate)
	if appErr != nil {
		return httpwriter.WriteError(c, appErr)
	}
	user, err := h.userService.Register(c.UserContext(), usersvc.RegisterInput{
		Email:    req.Email,
		Name:     req.Name,
		Password: req.Password,
	})
	if err != nil {
		return httpwriter.WriteError(c, errors.ToAppError(err))
	}
	return httpwriter.WriteJSON(c, fiber.StatusCreated, ToUserResponse(user))
}

func (h *Handler) Login(c *fiber.Ctx) error {
	req, appErr := httpwriter.Bind[LoginRequest](c, h.validate)
	if appErr != nil {
		return httpwriter.WriteError(c, appErr)
	}
	out, err := h.userService.Login(c.UserContext(), usersvc.LoginInput{
		Email:    req.Email,
		Password: req.Password,
	})
	if err != nil {
		return httpwriter.WriteError(c, errors.ToAppError(err))
	}
	return httpwriter.WriteJSON(c, fiber.StatusOK, ToLoginResponse(out))
}

func (h *Handler) GetByID(c *fiber.Ctx) error {
	id, appErr := httpwriter.ParseID(c, "id")
	if appErr != nil {
		return httpwriter.WriteError(c, appErr)
	}
	user, err := h.userService.Get(c.UserContext(), id)
	if err != nil {
		return httpwriter.WriteError(c, errors.ToAppError(err))
	}
	return httpwriter.WriteJSON(c, fiber.StatusOK, ToUserResponse(user))
}

func (h *Handler) Update(c *fiber.Ctx) error {
	id, appErr := httpwriter.ParseID(c, "id")
	if appErr != nil {
		return httpwriter.WriteError(c, appErr)
	}
	req, appErr := httpwriter.Bind[UpdateUserRequest](c, h.validate)
	if appErr != nil {
		return httpwriter.WriteError(c, appErr)
	}
	user, err := h.userService.Update(c.UserContext(), id, usersvc.UpdateInput{Name: req.Name})
	if err != nil {
		return httpwriter.WriteError(c, errors.ToAppError(err))
	}
	return httpwriter.WriteJSON(c, fiber.StatusOK, ToUserResponse(user))
}

func (h *Handler) Delete(c *fiber.Ctx) error {
	id, appErr := httpwriter.ParseID(c, "id")
	if appErr != nil {
		return httpwriter.WriteError(c, appErr)
	}
	if delErr := h.userService.Delete(c.UserContext(), id); delErr != nil {
		return httpwriter.WriteError(c, errors.ToAppError(delErr))
	}
	return c.SendStatus(fiber.StatusNoContent)
}

func (h *Handler) List(c *fiber.Ctx) error {
	q, appErr := httpwriter.BindQuery[ListQuery](c, h.validate)
	if appErr != nil {
		return httpwriter.WriteError(c, appErr)
	}
	users, err := h.userService.List(c.UserContext(), usersvc.ListInput{
		Email:  q.Email,
		Limit:  q.Limit,
		Offset: q.Offset,
	})
	if err != nil {
		return httpwriter.WriteError(c, errors.ToAppError(err))
	}
	return httpwriter.WriteJSON(c, fiber.StatusOK, ToUserListResponse(users))
}
