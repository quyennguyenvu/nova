package user

import (
	"context"
	"strconv"

	"github.com/gofiber/fiber/v2"

	useruc "{{.ModuleName}}/internal/usecase/user"
	"{{.ModuleName}}/pkg/errors"
	"{{.ModuleName}}/pkg/httputil"
	"{{.ModuleName}}/pkg/logctx"
)

// UserHandler is the HTTP boundary for user operations.
type UserHandler struct {
	userService *useruc.Service
}

func NewUserHandler(userService *useruc.Service) *UserHandler {
	return &UserHandler{userService: userService}
}

// mapAndLog converts a wrapped domain/usecase error into an *AppError and,
// for 5xx cases only, emits a single log line carrying the full wrap chain.
// Client errors (4xx) are not logged here — the access log in the Logging
// middleware already records them.
func mapAndLog(ctx context.Context, err error) *errors.AppError {
	app := errors.ToAppError(err)
	if app.Code >= 500 {
		logctx.From(ctx).Error("handler error", "err", err.Error(), "trace", app.Trace())
	}
	return app
}

func (h *UserHandler) Create(c *fiber.Ctx) error {
	var input useruc.CreateUserInput
	if err := c.BodyParser(&input); err != nil {
		return writeErr(c, errors.BadRequest(err.Error()))
	}
	user, err := h.userService.CreateUser(c.UserContext(), input)
	if err != nil {
		return writeErr(c, mapAndLog(c.UserContext(), err))
	}

	resp := ToUserResponse(user)
	return c.Status(fiber.StatusCreated).JSON(httputil.SuccessResponse(resp))
}

func (h *UserHandler) GetByID(c *fiber.Ctx) error {
	id, err := strconv.ParseInt(c.Params("id"), 10, 64)
	if err != nil {
		return writeErr(c, errors.BadRequest("invalid id"))
	}
	user, err := h.userService.GetUser(c.UserContext(), id)
	if err != nil {
		return writeErr(c, mapAndLog(c.UserContext(), err))
	}
	resp := ToUserResponse(user)
	return c.JSON(httputil.SuccessResponse(resp))
}

func (h *UserHandler) Update(c *fiber.Ctx) error {
	id, err := strconv.ParseInt(c.Params("id"), 10, 64)
	if err != nil {
		return writeErr(c, errors.BadRequest("invalid id"))
	}
	var input useruc.UpdateUserInput
	if bindErr := c.BodyParser(&input); bindErr != nil {
		return writeErr(c, errors.BadRequest(bindErr.Error()))
	}
	user, err := h.userService.UpdateUser(c.UserContext(), id, input)
	if err != nil {
		return writeErr(c, mapAndLog(c.UserContext(), err))
	}
	resp := ToUserResponse(user)
	return c.JSON(httputil.SuccessResponse(resp))
}

func (h *UserHandler) Delete(c *fiber.Ctx) error {
	id, err := strconv.ParseInt(c.Params("id"), 10, 64)
	if err != nil {
		return writeErr(c, errors.BadRequest("invalid id"))
	}
	if delErr := h.userService.DeleteUser(c.UserContext(), id); delErr != nil {
		return writeErr(c, mapAndLog(c.UserContext(), delErr))
	}
	return c.SendStatus(fiber.StatusNoContent)
}

func (h *UserHandler) List(c *fiber.Ctx) error {
	limit := c.QueryInt("limit", 10)
	offset := c.QueryInt("offset", 0)
	users, err := h.userService.ListUsers(c.UserContext(), toListFilter(limit, offset))
	if err != nil {
		return writeErr(c, mapAndLog(c.UserContext(), err))
	}

	resp := ToUserListResponse(users)
	return c.JSON(httputil.SuccessResponse(resp))
}

func writeErr(c *fiber.Ctx, app *errors.AppError) error {
	return httputil.WriteError(c, app)
}
