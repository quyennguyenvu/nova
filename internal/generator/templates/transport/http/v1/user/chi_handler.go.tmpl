package user

import (
	"net/http"

	"github.com/go-playground/validator/v10"

	"{{.ModuleName}}/internal/transport/http/httpwriter"
	usersvc "{{.ModuleName}}/internal/usecase/user"
	"{{.ModuleName}}/pkg/errors"
)

// Handler is the HTTP boundary for user operations. It never logs — the
// Logging middleware reads the AppError back from ctx via the WriteError
// stash and emits one access log per request. Request binding and path-param
// parsing are shared via httpwriter.Bind / httpwriter.ParseID.
type Handler struct {
	userService *usersvc.Service
	validate    *validator.Validate
}

func NewHandler(userService *usersvc.Service, validate *validator.Validate) *Handler {
	return &Handler{userService: userService, validate: validate}
}

func (h *Handler) Create(w http.ResponseWriter, r *http.Request) {
	req, appErr := httpwriter.Bind[CreateUserRequest](r, h.validate)
	if appErr != nil {
		httpwriter.WriteError(w, r, appErr)
		return
	}
	user, err := h.userService.Register(r.Context(), usersvc.RegisterInput{
		Email:    req.Email,
		Name:     req.Name,
		Password: req.Password,
	})
	if err != nil {
		httpwriter.WriteError(w, r, errors.ToAppError(err))
		return
	}
	httpwriter.WriteJSON(w, http.StatusCreated, ToUserResponse(user))
}

func (h *Handler) Login(w http.ResponseWriter, r *http.Request) {
	req, appErr := httpwriter.Bind[LoginRequest](r, h.validate)
	if appErr != nil {
		httpwriter.WriteError(w, r, appErr)
		return
	}
	out, err := h.userService.Login(r.Context(), usersvc.LoginInput{
		Email:    req.Email,
		Password: req.Password,
	})
	if err != nil {
		httpwriter.WriteError(w, r, errors.ToAppError(err))
		return
	}
	httpwriter.WriteJSON(w, http.StatusOK, ToLoginResponse(out))
}

func (h *Handler) GetByID(w http.ResponseWriter, r *http.Request) {
	id, appErr := httpwriter.ParseID(r, "id")
	if appErr != nil {
		httpwriter.WriteError(w, r, appErr)
		return
	}
	user, err := h.userService.Get(r.Context(), id)
	if err != nil {
		httpwriter.WriteError(w, r, errors.ToAppError(err))
		return
	}
	httpwriter.WriteJSON(w, http.StatusOK, ToUserResponse(user))
}

func (h *Handler) Update(w http.ResponseWriter, r *http.Request) {
	id, appErr := httpwriter.ParseID(r, "id")
	if appErr != nil {
		httpwriter.WriteError(w, r, appErr)
		return
	}
	req, appErr := httpwriter.Bind[UpdateUserRequest](r, h.validate)
	if appErr != nil {
		httpwriter.WriteError(w, r, appErr)
		return
	}
	user, err := h.userService.Update(r.Context(), id, usersvc.UpdateInput{Name: req.Name})
	if err != nil {
		httpwriter.WriteError(w, r, errors.ToAppError(err))
		return
	}
	httpwriter.WriteJSON(w, http.StatusOK, ToUserResponse(user))
}

func (h *Handler) Delete(w http.ResponseWriter, r *http.Request) {
	id, appErr := httpwriter.ParseID(r, "id")
	if appErr != nil {
		httpwriter.WriteError(w, r, appErr)
		return
	}
	if delErr := h.userService.Delete(r.Context(), id); delErr != nil {
		httpwriter.WriteError(w, r, errors.ToAppError(delErr))
		return
	}
	w.WriteHeader(http.StatusNoContent)
}

func (h *Handler) List(w http.ResponseWriter, r *http.Request) {
	// chi has no struct query binder, so assemble + validate ListQuery here.
	q := ListQuery{Email: r.URL.Query().Get("email")}
	var appErr *errors.AppError
	if q.Limit, appErr = httpwriter.QueryInt(r, "limit"); appErr != nil {
		httpwriter.WriteError(w, r, appErr)
		return
	}
	if q.Offset, appErr = httpwriter.QueryInt(r, "offset"); appErr != nil {
		httpwriter.WriteError(w, r, appErr)
		return
	}
	if appErr = httpwriter.ValidateQuery(h.validate, &q); appErr != nil {
		httpwriter.WriteError(w, r, appErr)
		return
	}
	users, err := h.userService.List(r.Context(), usersvc.ListInput{
		Email:  q.Email,
		Limit:  q.Limit,
		Offset: q.Offset,
	})
	if err != nil {
		httpwriter.WriteError(w, r, errors.ToAppError(err))
		return
	}
	httpwriter.WriteJSON(w, http.StatusOK, ToUserListResponse(users))
}
