package user

import (
	"net/http"
	"strconv"

	"github.com/go-playground/validator/v10"
	"github.com/labstack/echo/v4"

	"{{.ModuleName}}/internal/transport/http/httpwriter"
	usersvc "{{.ModuleName}}/internal/usecase/user"
	"{{.ModuleName}}/pkg/errors"
	"{{.ModuleName}}/pkg/locale"
	"{{.ModuleName}}/pkg/logctx"
)

// Handler is the HTTP boundary for user operations. It never logs — the
// Logging middleware reads the AppError back from ctx via the WriteError
// stash and emits one access log per request.
type Handler struct {
	userService *usersvc.Service
	validate    *validator.Validate
}

func NewHandler(userService *usersvc.Service, validate *validator.Validate) *Handler {
	return &Handler{userService: userService, validate: validate}
}

// bind parses the request body + enforces struct-tag validation. Bind failures
// return the binder's own message; validation failures are logged at warn (with
// the validator's field-by-field detail) and mapped to a generic localized 400
// so clients don't see internal field names.
func (h *Handler) bind(c echo.Context, v any) *errors.AppError {
	log := logctx.From(c.Request().Context())
	if err := c.Bind(v); err != nil {
		return errors.BadRequest(err.Error())
	}
	if err := h.validate.Struct(v); err != nil {
		log.Warn(err.Error())
		return errors.BadRequestL(locale.InvalidRequest)
	}
	return nil
}

func (h *Handler) Create(c echo.Context) error {
	var req CreateUserRequest
	if appErr := h.bind(c, &req); appErr != nil {
		return httpwriter.WriteError(c, appErr)
	}
	user, err := h.userService.Register(c.Request().Context(), usersvc.RegisterInput{
		Email:    req.Email,
		Name:     req.Name,
		Password: req.Password,
	})
	if err != nil {
		return httpwriter.WriteError(c, errors.ToAppError(err))
	}
	return httpwriter.WriteJSON(c, http.StatusCreated, ToUserResponse(user))
}

func (h *Handler) Login(c echo.Context) error {
	var req LoginRequest
	if appErr := h.bind(c, &req); appErr != nil {
		return httpwriter.WriteError(c, appErr)
	}
	out, err := h.userService.Login(c.Request().Context(), usersvc.LoginInput{
		Email:    req.Email,
		Password: req.Password,
	})
	if err != nil {
		return httpwriter.WriteError(c, errors.ToAppError(err))
	}
	return httpwriter.WriteJSON(c, http.StatusOK, ToLoginResponse(out))
}

func (h *Handler) GetByID(c echo.Context) error {
	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
	if err != nil {
		return httpwriter.WriteError(c, errors.BadRequest("invalid id"))
	}
	user, err := h.userService.Get(c.Request().Context(), id)
	if err != nil {
		return httpwriter.WriteError(c, errors.ToAppError(err))
	}
	return httpwriter.WriteJSON(c, http.StatusOK, ToUserResponse(user))
}

func (h *Handler) Update(c echo.Context) error {
	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
	if err != nil {
		return httpwriter.WriteError(c, errors.BadRequest("invalid id"))
	}
	var req UpdateUserRequest
	if appErr := h.bind(c, &req); appErr != nil {
		return httpwriter.WriteError(c, appErr)
	}
	user, err := h.userService.Update(c.Request().Context(), id, usersvc.UpdateInput{Name: req.Name})
	if err != nil {
		return httpwriter.WriteError(c, errors.ToAppError(err))
	}
	return httpwriter.WriteJSON(c, http.StatusOK, ToUserResponse(user))
}

func (h *Handler) Delete(c echo.Context) error {
	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
	if err != nil {
		return httpwriter.WriteError(c, errors.BadRequest("invalid id"))
	}
	if delErr := h.userService.Delete(c.Request().Context(), id); delErr != nil {
		return httpwriter.WriteError(c, errors.ToAppError(delErr))
	}
	return c.NoContent(http.StatusNoContent)
}

func (h *Handler) List(c echo.Context) error {
	limit, _ := strconv.Atoi(c.QueryParam("limit"))
	offset, _ := strconv.Atoi(c.QueryParam("offset"))
	if limit == 0 {
		limit = 10
	}
	users, err := h.userService.List(c.Request().Context(), usersvc.ListInput{Limit: limit, Offset: offset})
	if err != nil {
		return httpwriter.WriteError(c, errors.ToAppError(err))
	}
	return httpwriter.WriteJSON(c, http.StatusOK, ToUserListResponse(users))
}
