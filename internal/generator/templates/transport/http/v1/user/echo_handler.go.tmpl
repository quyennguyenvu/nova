package user

import (
	"context"
	"net/http"
	"strconv"

	"github.com/labstack/echo/v4"

	usersvc "{{.ModuleName}}/internal/usecase/user"
	"{{.ModuleName}}/pkg/errors"
	"{{.ModuleName}}/pkg/httputil"
	"{{.ModuleName}}/pkg/logctx"
)

// UserHandler is the HTTP boundary for user operations.
type UserHandler struct {
	userService *usersvc.Service
}

func NewUserHandler(userService *usersvc.Service) *UserHandler {
	return &UserHandler{userService: userService}
}

// mapAndLog converts a wrapped domain/usecase error into an *AppError and,
// for 5xx cases only, emits a single log line carrying the full wrap chain.
// Client errors (4xx) are not logged here — the access log in the Logging
// middleware already records them.
func mapAndLog(ctx context.Context, err error) *errors.AppError {
	app := errors.ToAppError(err)
	if app.Code >= 500 {
		logctx.From(ctx).Error("handler error", "err", err.Error(), "trace", app.Trace())
	}
	return app
}

func (h *UserHandler) Create(c echo.Context) error {
	var input usersvc.RegisterInput
	if err := c.Bind(&input); err != nil {
		return writeErr(c, errors.BadRequest(err.Error()))
	}
	user, err := h.userService.Register(c.Request().Context(), input)
	if err != nil {
		return writeErr(c, mapAndLog(c.Request().Context(), err))
	}
	resp := ToUserResponse(user)
	return c.JSON(http.StatusCreated, httputil.SuccessResponse(resp))
}

func (h *UserHandler) GetByID(c echo.Context) error {
	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
	if err != nil {
		return writeErr(c, errors.BadRequest("invalid id"))
	}
	user, err := h.userService.Get(c.Request().Context(), id)
	if err != nil {
		return writeErr(c, mapAndLog(c.Request().Context(), err))
	}
	resp := ToUserResponse(user)
	return c.JSON(http.StatusOK, httputil.SuccessResponse(resp))
}

func (h *UserHandler) Update(c echo.Context) error {
	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
	if err != nil {
		return writeErr(c, errors.BadRequest("invalid id"))
	}
	var input usersvc.UpdateInput
	if bindErr := c.Bind(&input); bindErr != nil {
		return writeErr(c, errors.BadRequest(bindErr.Error()))
	}
	user, err := h.userService.Update(c.Request().Context(), id, input)
	if err != nil {
		return writeErr(c, mapAndLog(c.Request().Context(), err))
	}
	resp := ToUserResponse(user)
	return c.JSON(http.StatusOK, httputil.SuccessResponse(resp))
}

func (h *UserHandler) Delete(c echo.Context) error {
	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
	if err != nil {
		return writeErr(c, errors.BadRequest("invalid id"))
	}
	if delErr := h.userService.Delete(c.Request().Context(), id); delErr != nil {
		return writeErr(c, mapAndLog(c.Request().Context(), delErr))
	}
	return c.NoContent(http.StatusNoContent)
}

func (h *UserHandler) List(c echo.Context) error {
	limit, _ := strconv.Atoi(c.QueryParam("limit"))
	offset, _ := strconv.Atoi(c.QueryParam("offset"))
	if limit == 0 {
		limit = 10
	}
	users, err := h.userService.List(c.Request().Context(), toListFilter(limit, offset))
	if err != nil {
		return writeErr(c, mapAndLog(c.Request().Context(), err))
	}
	resp := ToUserListResponse(users)
	return c.JSON(http.StatusOK, httputil.SuccessResponse(resp))
}

func writeErr(c echo.Context, app *errors.AppError) error {
	return httputil.WriteError(c, app)
}
