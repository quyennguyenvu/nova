package user

import (
	"net/http"
	"strconv"

	"github.com/gin-gonic/gin"

	"{{.ModuleName}}/internal/transport/http/httpwriter"
	usersvc "{{.ModuleName}}/internal/usecase/user"
	"{{.ModuleName}}/pkg/errors"
)

// Handler is the HTTP boundary for user operations. It never logs — the
// Logging middleware reads the AppError back from ctx via the WriteError
// stash and emits one access log per request.
type Handler struct {
	userService *usersvc.Service
}

func NewHandler(userService *usersvc.Service) *Handler {
	return &Handler{userService: userService}
}

func (h *Handler) Create(c *gin.Context) {
	var input usersvc.RegisterInput
	if err := c.ShouldBindJSON(&input); err != nil {
		httpwriter.WriteError(c, errors.BadRequest(err.Error()))
		return
	}
	user, err := h.userService.Register(c.Request.Context(), input)
	if err != nil {
		httpwriter.WriteError(c, errors.ToAppError(err))
		return
	}
	httpwriter.WriteJSON(c, http.StatusCreated, ToUserResponse(user))
}

func (h *Handler) Login(c *gin.Context) {
	var req LoginRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		httpwriter.WriteError(c, errors.BadRequest(err.Error()))
		return
	}
	out, err := h.userService.Login(c.Request.Context(), usersvc.LoginInput{
		Email:    req.Email,
		Password: req.Password,
	})
	if err != nil {
		httpwriter.WriteError(c, errors.ToAppError(err))
		return
	}
	httpwriter.WriteJSON(c, http.StatusOK, ToLoginResponse(out))
}

func (h *Handler) GetByID(c *gin.Context) {
	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
	if err != nil {
		httpwriter.WriteError(c, errors.BadRequest("invalid id"))
		return
	}
	user, err := h.userService.Get(c.Request.Context(), id)
	if err != nil {
		httpwriter.WriteError(c, errors.ToAppError(err))
		return
	}
	httpwriter.WriteJSON(c, http.StatusOK, ToUserResponse(user))
}

func (h *Handler) Update(c *gin.Context) {
	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
	if err != nil {
		httpwriter.WriteError(c, errors.BadRequest("invalid id"))
		return
	}
	var input usersvc.UpdateInput
	if bindErr := c.ShouldBindJSON(&input); bindErr != nil {
		httpwriter.WriteError(c, errors.BadRequest(bindErr.Error()))
		return
	}
	user, err := h.userService.Update(c.Request.Context(), id, input)
	if err != nil {
		httpwriter.WriteError(c, errors.ToAppError(err))
		return
	}
	httpwriter.WriteJSON(c, http.StatusOK, ToUserResponse(user))
}

func (h *Handler) Delete(c *gin.Context) {
	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
	if err != nil {
		httpwriter.WriteError(c, errors.BadRequest("invalid id"))
		return
	}
	if delErr := h.userService.Delete(c.Request.Context(), id); delErr != nil {
		httpwriter.WriteError(c, errors.ToAppError(delErr))
		return
	}
	c.Status(http.StatusNoContent)
}

func (h *Handler) List(c *gin.Context) {
	limit, _ := strconv.Atoi(c.DefaultQuery("limit", "10"))
	offset, _ := strconv.Atoi(c.DefaultQuery("offset", "0"))
	users, err := h.userService.List(c.Request.Context(), usersvc.ListInput{Limit: limit, Offset: offset})
	if err != nil {
		httpwriter.WriteError(c, errors.ToAppError(err))
		return
	}
	httpwriter.WriteJSON(c, http.StatusOK, ToUserListResponse(users))
}
