package user

import (
	"github.com/gofiber/fiber/v2"

	jwtsec "{{.ModuleName}}/internal/infrastructure/jwt"
	"{{.ModuleName}}/internal/transport/http/middleware"
)

// Routes is the user feature's HTTP route registrar. It implements the
// transport/http.Registrar interface — mounted at /api/v1 by the app.
//
// The constructor takes the JWT verifier so Register can build the auth
// middleware and gate the protected subgroup. Make-believe public routes
// (Create == register) sit outside that subgroup.
type Routes struct {
	handler  *Handler
	tokenSvc *jwtsec.TokenService
}

func NewRoutes(h *Handler, tokenSvc *jwtsec.TokenService) *Routes {
	return &Routes{handler: h, tokenSvc: tokenSvc}
}

// Prefix is the API version subtree this feature mounts under.
func (*Routes) Prefix() string { return "/api/v1" }

// Register mounts:
//   - POST /login             (public — issues bearer token)
//   - POST /users             (public — registration)
//   - GET/PUT/DELETE /users*  (authenticated subgroup)
//
// Splitting at the group level (not per-route) keeps the auth boundary
// obvious; protected routes share one Auth middleware instance.
func (r *Routes) Register(router fiber.Router) {
	router.Post("/login", r.handler.Login)

	public := router.Group("/users")
	public.Post("/", r.handler.Create)

	protected := router.Group("/users", middleware.Auth(r.tokenSvc))
	protected.Get("/", r.handler.List)
	protected.Get("/:id", r.handler.GetByID)
	protected.Put("/:id", r.handler.Update)
	protected.Delete("/:id", r.handler.Delete)
}
