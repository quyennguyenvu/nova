// Package http builds the framework instance: it installs middleware in the
// correct order, exposes /healthz + /readyz, and lets each feature attach its
// own routes via the Registrar interface. Lifecycle (port binding, graceful
// shutdown) is the job of infrastructure/server.
package http

import (
	"net/http"

	"github.com/gin-gonic/gin"
	"go.opentelemetry.io/contrib/instrumentation/github.com/gin-gonic/gin/otelgin"

	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/transport/http/health"
	"{{.ModuleName}}/internal/transport/http/middleware"
	"{{.ModuleName}}/pkg/observability"
)

// Registrar attaches a feature's routes to a router subtree. The version
// package (transport/http/v1) provides a concrete Registrar implementing
// this interface. Prefix is mounted as a subgroup before Register is called.
// Multiple Registrars may share a Prefix; the slice order in NewRouter
// determines mount order.
type Registrar interface {
	Prefix() string
	Register(gin.IRouter)
}

// NewRouter builds the gin engine: middleware → probes → registrars at their prefixes.
//
// registrars is a slice (not a map) so mount order is deterministic.
func NewRouter(
	cfg *config.Config,
	log observability.Logger,
	checker *health.Checker,
	registrars []Registrar,
) *gin.Engine {
	gin.SetMode(gin.ReleaseMode)
	engine := gin.New()

	// Tracing first so RequestID and Logging see the server span (trace_id).
	engine.Use(otelgin.Middleware(
		cfg.AppName,
		otelgin.WithFilter(func(r *http.Request) bool { return !isProbe(r.URL.Path) }),
	))
	engine.Use(middleware.RequestID())
	engine.Use(middleware.Logging(log))
	engine.Use(middleware.Recovery())
	engine.Use(middleware.CORS(cfg.HTTP.CORS))
	engine.Use(middleware.Locale())

	engine.GET("/healthz", func(c *gin.Context) {
		c.JSON(http.StatusOK, checker.Liveness())
	})
	engine.GET("/readyz", func(c *gin.Context) {
		status := checker.Readiness(c.Request.Context())
		if !status.OK {
			log.Warn("readiness check failed", "details", status.Details)
		}
		code := http.StatusOK
		if !status.OK {
			code = http.StatusServiceUnavailable
		}
		c.JSON(code, status)
	})

	for _, r := range registrars {
		r.Register(engine.Group(r.Prefix()))
	}

	return engine
}

// isProbe reports whether path is a health probe. Probes stay out of traces
// (and access logs) because they carry no application signal.
func isProbe(path string) bool { return path == "/healthz" || path == "/readyz" }
