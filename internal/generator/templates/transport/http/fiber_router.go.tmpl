// Package http builds the framework instance: it installs middleware in the
// correct order, exposes /healthz + /readyz, and lets each feature attach its
// own routes via the Registrar interface. Lifecycle (port binding, graceful
// shutdown) is the job of infrastructure/server.
package http

import (
	"encoding/json"

	"github.com/gofiber/contrib/otelfiber/v2"
	"github.com/gofiber/fiber/v2"

	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/transport/http/health"
	"{{.ModuleName}}/internal/transport/http/middleware"
	"{{.ModuleName}}/pkg/observability"
)

// Registrar attaches a feature's routes to a router subtree. The version
// package (transport/http/v1) provides a concrete Registrar implementing
// this interface. Prefix is mounted as a subgroup before Register is called.
// Multiple Registrars may share a Prefix; the slice order in NewRouter
// determines mount order.
type Registrar interface {
	Prefix() string
	Register(fiber.Router)
}

// NewRouter builds the fiber app: middleware → probes → registrars at their prefixes.
// Order of middleware matters: RequestID first (so every later layer sees the
// ID), Logging second (wraps everything to compute duration & emit one line),
// Recovery inside Logging so panics still produce an access log.
//
// registrars is a slice (not a map) so mount order is deterministic.
//
// /healthz and /readyz sit inside the middleware stack so a panic during a
// readiness check still flows through Recovery; the check itself is cheap.
func NewRouter(
	cfg *config.Config,
	log observability.Logger,
	checker *health.Checker,
	registrars []Registrar,
) *fiber.App {
	app := fiber.New(fiber.Config{
		BodyLimit:         cfg.HTTP.BodyLimit,
		ReadBufferSize:    cfg.HTTP.ReadBufferSize,
		JSONEncoder:       json.Marshal,
		JSONDecoder:       json.Unmarshal,
		ReadTimeout:       cfg.HTTP.ReadTimeout,
		WriteTimeout:      cfg.HTTP.WriteTimeout,
		ProxyHeader:       fiber.HeaderXForwardedFor,
		EnablePrintRoutes: cfg.AppEnv == config.EnvLocal, // Only print routes in local environment for easier debugging
	})

	// Tracing first so RequestID and Logging see the server span (trace_id).
	app.Use(otelfiber.Middleware(otelfiber.WithNext(func(c *fiber.Ctx) bool { return isProbe(c.Path()) })))
	app.Use(middleware.RequestID())
	app.Use(middleware.Logging(log))
	app.Use(middleware.Recovery())
	app.Use(middleware.CORS(cfg.HTTP.CORS))
	app.Use(middleware.Locale())

	app.Get("/healthz", func(c *fiber.Ctx) error {
		return c.JSON(checker.Liveness())
	})
	app.Get("/readyz", func(c *fiber.Ctx) error {
		status := checker.Readiness(c.UserContext())
		if !status.OK {
			log.Warn("readiness check failed", "details", status.Details)
		}
		code := fiber.StatusOK
		if !status.OK {
			code = fiber.StatusServiceUnavailable
		}
		return c.Status(code).JSON(status)
	})

	for _, r := range registrars {
		r.Register(app.Group(r.Prefix()))
	}

	return app
}

// isProbe reports whether path is a health probe. Probes stay out of traces
// (and access logs) because they carry no application signal.
func isProbe(path string) bool { return path == "/healthz" || path == "/readyz" }
