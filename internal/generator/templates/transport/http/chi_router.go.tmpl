// Package http builds the framework instance: it installs middleware in the
// correct order, exposes /healthz + /readyz, and lets each feature attach its
// own routes via the Registrar interface. Lifecycle (port binding, graceful
// shutdown) is the job of infrastructure/server.
package http

import (
	"encoding/json"
	"net/http"

	"github.com/go-chi/chi/v5"

	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/infrastructure/logger"
	"{{.ModuleName}}/internal/transport/http/health"
	"{{.ModuleName}}/internal/transport/http/middleware"
)

// Registrar attaches a feature's routes to a router subtree. Each feature
// package (transport/http/v1/<feature>) provides a concrete Registrar; its
// Prefix() is the subtree it mounts under. Registrars that share a Prefix
// (e.g. every /api/v1 feature) are mounted together under one chi.Route — see
// NewRouter — so the slice order determines mount order.
type Registrar interface {
	Prefix() string
	Register(chi.Router)
}

// NewRouter builds the chi router: middleware → probes → registrars at their prefixes.
//
// registrars is a slice (not a map) so mount order is deterministic.
func NewRouter(
	cfg *config.Config,
	log *logger.Logger,
	checker *health.Checker,
	registrars []Registrar,
) chi.Router {
	router := chi.NewRouter()

	router.Use(middleware.RequestID)
	router.Use(middleware.Logging(log))
	router.Use(middleware.Recovery)
	router.Use(middleware.CORS(cfg.HTTP.CORS))
	router.Use(middleware.Locale)

	router.Get("/healthz", func(w http.ResponseWriter, _ *http.Request) {
		writeJSON(w, http.StatusOK, checker.Liveness())
	})
	router.Get("/readyz", func(w http.ResponseWriter, r *http.Request) {
		status := checker.Readiness(r.Context())
		code := http.StatusOK
		if !status.OK {
			code = http.StatusServiceUnavailable
		}
		writeJSON(w, code, status)
	})

	// chi.Router.Route panics if the same pattern is mounted twice, so group
	// registrars by Prefix and mount each prefix once. The order slice keeps
	// first-seen prefix order; registrars within a prefix keep slice order.
	order := make([]string, 0, len(registrars))
	byPrefix := make(map[string][]Registrar, len(registrars))
	for _, r := range registrars {
		prefix := r.Prefix()
		if _, seen := byPrefix[prefix]; !seen {
			order = append(order, prefix)
		}
		byPrefix[prefix] = append(byPrefix[prefix], r)
	}
	for _, prefix := range order {
		group := byPrefix[prefix]
		router.Route(prefix, func(sub chi.Router) {
			for _, r := range group {
				r.Register(sub)
			}
		})
	}

	return router
}

func writeJSON(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(v)
}
