// Package http builds the framework instance: it installs middleware in the
// correct order, exposes /healthz, and lets each feature attach its own routes
// via the Registrar interface. Lifecycle (port binding, graceful shutdown) is
// the job of infrastructure/server.
package http

import (
	"encoding/json"
	"time"

	"github.com/gofiber/fiber/v2"

	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/infrastructure/logger"
	"{{.ModuleName}}/internal/transport/http/middleware"
)

const (
	readBufferSize = 8 * 1024
	readTimeout    = 30 * time.Second
	bodyLimit      = 10 * 1024 * 1024 // 10 MB
)

// Registrar attaches a feature's routes to a router subtree. Each feature
// (transport/http/v1/<feature>) provides a *Routes implementing this.
type Registrar interface {
	Register(fiber.Router)
}

// NewApp builds the fiber app: middleware → /healthz → registrars at their prefixes.
// Order of middleware matters: RequestID first (so every later layer sees the
// ID), Logging second (wraps everything to compute duration & emit one line),
// Recovery inside Logging so panics still produce an access log.
func NewApp(cfg *config.Config, log *logger.Logger, registrars map[string]Registrar) *fiber.App {
	app := fiber.New(fiber.Config{
		BodyLimit:         bodyLimit,
		ReadBufferSize:    readBufferSize,
		JSONEncoder:       json.Marshal,
		JSONDecoder:       json.Unmarshal,
		ReadTimeout:       readTimeout,
		ProxyHeader:       fiber.HeaderXForwardedFor,
		EnablePrintRoutes: cfg.AppEnv == config.EnvLocal, // Only print routes in local environment for easier debugging
	})

	app.Use(middleware.RequestID())
	app.Use(middleware.Logging(log))
	app.Use(middleware.Recovery())
	app.Use(middleware.CORS())
	app.Use(middleware.Locale())

	app.Get("/healthz", func(c *fiber.Ctx) error {
		return c.JSON(fiber.Map{"status": "ok"})
	})

	for prefix, r := range registrars {
		r.Register(app.Group(prefix))
	}

	return app
}
