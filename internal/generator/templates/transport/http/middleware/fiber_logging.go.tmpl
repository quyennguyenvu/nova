package middleware

import (
	"context"
	"net/http"
	"time"

	"github.com/gofiber/fiber/v2"
	"go.opentelemetry.io/otel/trace"

	"{{.ModuleName}}/pkg/errors"
	"{{.ModuleName}}/pkg/logctx"
	"{{.ModuleName}}/pkg/observability"
	"{{.ModuleName}}/pkg/requestid"
)

func traceIDOr(sc trace.SpanContext) string {
	if !sc.IsValid() {
		return ""
	}
	return sc.TraceID().String()
}

func errMsg(err error) string {
	if err == nil {
		return ""
	}
	return err.Error()
}

// Logging builds a request-scoped logger (enriched with request_id + trace_id)
// used for the single access log, installs an AppError stash slot (handlers
// fill it on 4xx/5xx), and emits exactly ONE access log at the end of the
// request.
//
// Liveness/readiness probes are skipped: k8s hits them every few seconds, so an
// access line per probe drowns out real traffic. They still run through the
// rest of the stack (RequestID, Recovery) so panics during a readiness check
// stay contained — we only suppress the log line, not the safety net.
func Logging(base observability.Logger) fiber.Handler {
	skipPaths := map[string]struct{}{
		"/healthz": {},
		"/readyz":  {},
	}
	return func(c *fiber.Ctx) error {
		// Skip health probes and CORS preflight (OPTIONS) — neither carries
		// app signal and both would drown out real traffic in the logs.
		if _, ok := skipPaths[c.Path()]; ok || c.Method() == http.MethodOptions {
			return c.Next()
		}

		start := time.Now()
		ctx := c.UserContext()
		reqID := requestid.From(ctx)
		sc := trace.SpanContextFromContext(ctx)

		// c.Path() returns the route path only (no query string) — keep it
		// that way so secrets in `?token=...` never reach structured logs.
		// Do NOT switch to c.OriginalURL() or fasthttp.RequestURI().
		// scoped is the request-scoped logger handed to inner layers via
		// logctx: only the correlation fields belong here. client_ip/user_agent
		// are deliberately NOT attached — they're entry-point facts that belong
		// on the single access line below, not repeated on every inner log.
		scoped := base.
			With("request_id", reqID).
			With("trace_id", traceIDOr(sc)).
			With("method", c.Method()).
			With("path", c.Path())
		ctx = logctx.With(ctx, scoped)
		ctx = errors.PrepareAppErrorContext(ctx)
		ctx = prepareAuthSlot(ctx)
		c.SetUserContext(ctx)

		err := c.Next()
		if err != nil {
			// Resolve the error here, inside the access-log scope, so the
			// status on the line is the one the client receives; fiber would
			// otherwise run the ErrorHandler after this middleware returns and
			// the line would read 200.
			if hErr := c.App().ErrorHandler(c, err); hErr != nil {
				_ = c.SendStatus(http.StatusInternalServerError)
			}
		}
		logAccess(ctx, scoped, c, err, start)
		return nil
	}
}

// logAccess emits the single access line for a request. Severity follows the
// status; AppError detail is appended whenever there is something to diagnose.
func logAccess(ctx context.Context, scoped observability.Logger, c *fiber.Ctx, err error, start time.Time) {
	status := c.Response().StatusCode()
	ev := scoped.Info
	if status >= http.StatusInternalServerError {
		ev = scoped.Error
	} else if status >= http.StatusBadRequest {
		ev = scoped.Warn
	}

	fields := []any{
		"status", status,
		"route", c.Route().Path,
		"duration_ms", time.Since(start).Milliseconds(),
		"err", errMsg(err),
		"client_ip", c.IP(),
		"user_agent", string(c.Request().Header.UserAgent()),
	}
	if p := principalFromSlot(ctx); p != nil {
		fields = append(fields, "user_id", p.UserID)
	}
	if app := errors.AppErrorFromContext(ctx); app != nil {
		fields = append(fields, "app_code", app.Code)
		if app.Locale != 0 {
			fields = append(fields, "app_locale", int(app.Locale))
		}
		// Surface the inner cause + trace whenever there's something to
		// diagnose: a server fault (5xx), or any error that wrapped an
		// underlying cause — e.g. a 4xx that failed decoding input or a
		// downstream call. A plain validation 4xx carries no inner Err, so
		// its line stays lean (app_code already names the client mistake)
		// and error-rate alerts stay free of client-driven noise.
		if err != nil || app.Err != nil || status >= http.StatusInternalServerError {
			fields = append(fields, "app_err", app.Error(), "app_trace", app.Trace())
		}
	}
	ev("request", fields...)
}
