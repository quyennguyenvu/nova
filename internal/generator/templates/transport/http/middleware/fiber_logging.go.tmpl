package middleware

import (
	"time"

	"github.com/gofiber/fiber/v2"
	"go.opentelemetry.io/otel/trace"

	"{{.ModuleName}}/internal/infrastructure/logger"
	"{{.ModuleName}}/pkg/errors"
	"{{.ModuleName}}/pkg/logctx"
)

func traceIDOr(sc trace.SpanContext) string {
	if !sc.IsValid() {
		return ""
	}
	return sc.TraceID().String()
}

func errMsg(err error) string {
	if err == nil {
		return ""
	}
	return err.Error()
}

// Logging builds a request-scoped logger (enriched with request_id + trace_id),
// attaches it to ctx so inner layers can retrieve it via logctx.From, installs
// an AppError stash slot (httpwriter.WriteError fills it on 4xx/5xx), and emits
// exactly ONE access log at the end of the request.
func Logging(base *logger.Logger) fiber.Handler {
	return func(c *fiber.Ctx) error {
		start := time.Now()
		ctx := c.UserContext()
		reqID := RequestIDFrom(ctx)
		sc := trace.SpanContextFromContext(ctx)

		scoped := base.
			With("request_id", reqID).
			With("trace_id", traceIDOr(sc)).
			With("method", c.Method()).
			With("path", c.Path())
		ctx = logctx.Into(ctx, scoped)
		ctx = errors.PrepareAppErrorContext(ctx)
		c.SetUserContext(ctx)

		err := c.Next()

		status := c.Response().StatusCode()
		ev := scoped.Info
		if err != nil || status >= 500 {
			ev = scoped.Error
		} else if status >= 400 {
			ev = scoped.Warn
		}

		fields := []any{
			"status", status,
			"duration_ms", time.Since(start).Milliseconds(),
			"err", errMsg(err),
		}
		if app := errors.AppErrorFromContext(ctx); app != nil {
			fields = append(fields, "app_code", app.Code)
			if app.Locale != 0 {
				fields = append(fields, "app_locale", int(app.Locale))
			}
			if status >= 500 {
				fields = append(fields, "app_trace", app.Trace())
			}
		}
		ev("request", fields...)
		return err
	}
}
