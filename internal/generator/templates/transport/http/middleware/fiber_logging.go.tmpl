package middleware

import (
	"time"

	"github.com/gofiber/fiber/v2"
	"go.opentelemetry.io/otel/trace"

	"{{.ModuleName}}/internal/infrastructure/logger"
	"{{.ModuleName}}/pkg/logctx"
)

func traceIDOr(sc trace.SpanContext) string {
	if !sc.IsValid() {
		return ""
	}
	return sc.TraceID().String()
}

func errMsg(err error) string {
	if err == nil {
		return ""
	}
	return err.Error()
}

// Logging builds a request-scoped logger (enriched with request_id + trace_id),
// attaches it to ctx so inner layers can retrieve it via logctx.From, and emits
// exactly ONE access log at the end of the request.
func Logging(base *logger.Logger) fiber.Handler {
	return func(c *fiber.Ctx) error {
		start := time.Now()
		ctx := c.UserContext()
		reqID := RequestIDFrom(ctx)
		sc := trace.SpanContextFromContext(ctx)

		scoped := base.
			With("request_id", reqID).
			With("trace_id", traceIDOr(sc)).
			With("method", c.Method()).
			With("path", c.Path())
		c.SetUserContext(logctx.Into(ctx, scoped))

		err := c.Next()

		ev := scoped.Info
		if err != nil || c.Response().StatusCode() >= 500 {
			ev = scoped.Error
		} else if c.Response().StatusCode() >= 400 {
			ev = scoped.Warn
		}
		ev("request",
			"status", c.Response().StatusCode(),
			"duration_ms", time.Since(start).Milliseconds(),
			"err", errMsg(err),
		)
		return err
	}
}
