package middleware

import (
	"net/http"

	"github.com/google/uuid"

	"{{.ModuleName}}/pkg/httputil"
)

// RequestID injects a unique request ID into the request headers and its context.
// The ID is carried through ctx (see httputil.RequestIDFrom) and echoed back to
// the client in the X-Request-ID header and the response body's "requestId".
func RequestID(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		id := r.Header.Get(httputil.RequestIDHeader)
		if id == "" {
			id = uuid.New().String()
		}
		w.Header().Set(httputil.RequestIDHeader, id)
		r = r.WithContext(httputil.WithRequestID(r.Context(), id))
		next.ServeHTTP(w, r)
	})
}
