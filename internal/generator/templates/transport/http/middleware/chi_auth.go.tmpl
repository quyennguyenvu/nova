package middleware

import (
	"net/http"
	"strings"

	"{{.ModuleName}}/internal/domain/identity"
	jwtsec "{{.ModuleName}}/internal/infrastructure/jwt"
	"{{.ModuleName}}/internal/transport/http/httpwriter"
	"{{.ModuleName}}/pkg/errors"
	"{{.ModuleName}}/pkg/locale"
)

// RFC 6750 §3 challenges: a missing credential gets the bare scheme, a
// rejected one names the reason.
const (
	challengeMissing = `Bearer`
	challengeInvalid = `Bearer error="invalid_token"`
)

// Auth verifies the bearer token via the JWT verifier and attaches the
// resolved *identity.UserPrincipal to the request context. Returns a chi
// middleware factory. Every 401 carries a WWW-Authenticate challenge.
func Auth(tokenSvc *jwtsec.TokenService) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			token := bearerToken(r.Header.Get("Authorization"))
			if token == "" {
				w.Header().Set("WWW-Authenticate", challengeMissing)
				httpwriter.WriteError(w, r, errors.L(locale.Unauthorized).WithCause(errors.New("missing bearer token")))
				return
			}
			principal, err := tokenSvc.ParseAndVerifyAccessToken(r.Context(), token)
			if err != nil {
				app := errors.ToAppError(err)
				if app.Code == http.StatusUnauthorized {
					w.Header().Set("WWW-Authenticate", challengeInvalid)
				}
				httpwriter.WriteError(w, r, app)
				return
			}
			rememberPrincipal(r.Context(), principal)
			next.ServeHTTP(w, r.WithContext(identity.WithUserPrincipal(r.Context(), principal)))
		})
	}
}

// bearerToken extracts the credential from an Authorization header. The
// scheme is case-insensitive (RFC 9110 §11.1).
func bearerToken(h string) string {
	const prefix = "bearer "
	if len(h) < len(prefix) || !strings.EqualFold(h[:len(prefix)], prefix) {
		return ""
	}
	return strings.TrimSpace(h[len(prefix):])
}
