package middleware

import (
	"net/http"
	"strings"

	"{{.ModuleName}}/internal/domain/identity"
	jwtsec "{{.ModuleName}}/internal/infrastructure/jwt"
	"{{.ModuleName}}/internal/transport/http/httpwriter"
	"{{.ModuleName}}/pkg/errors"
)

// Auth verifies the bearer token via the JWT verifier and attaches the
// resolved *identity.UserPrincipal to the request context. Returns a chi
// middleware factory.
func Auth(verifier *jwtsec.Verifier) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			token := bearerToken(r.Header.Get("Authorization"))
			if token == "" {
				httpwriter.WriteError(w, r, errors.Unauthorized("missing bearer token"))
				return
			}
			principal, err := verifier.ParseAndVerifyAccessToken(token)
			if err != nil {
				httpwriter.WriteError(w, r, errors.ToAppError(err))
				return
			}
			next.ServeHTTP(w, r.WithContext(identity.WithUserPrincipal(r.Context(), principal)))
		})
	}
}

func bearerToken(h string) string {
	const prefix = "Bearer "
	if !strings.HasPrefix(h, prefix) {
		return ""
	}
	return strings.TrimSpace(h[len(prefix):])
}
