package middleware

import (
	"github.com/gofiber/fiber/v2"
	"github.com/google/uuid"

	"{{.ModuleName}}/pkg/httputil"
)

// RequestID injects a unique request ID into the request headers and its context.
// The ID is carried through ctx (see httputil.RequestIDFrom) and echoed back to
// the client in the X-Request-ID header and the response body's "requestId".
func RequestID() fiber.Handler {
	return func(c *fiber.Ctx) error {
		id := c.Get(httputil.RequestIDHeader)
		if id == "" {
			id = uuid.New().String()
		}
		c.Set(httputil.RequestIDHeader, id)
		c.Locals("request_id", id)
		c.SetUserContext(httputil.WithRequestID(c.UserContext(), id))
		return c.Next()
	}
}
