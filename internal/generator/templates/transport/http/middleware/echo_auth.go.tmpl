package middleware

import (
	"strings"

	"github.com/labstack/echo/v4"

	"{{.ModuleName}}/internal/domain/identity"
	jwtsec "{{.ModuleName}}/internal/infrastructure/jwt"
	"{{.ModuleName}}/internal/transport/http/httpwriter"
	"{{.ModuleName}}/pkg/errors"
)

// Auth verifies the bearer token via the JWT verifier and attaches the
// resolved *identity.UserPrincipal to the request context.
func Auth(verifier *jwtsec.Verifier) echo.MiddlewareFunc {
	return func(next echo.HandlerFunc) echo.HandlerFunc {
		return func(c echo.Context) error {
			token := bearerToken(c.Request().Header.Get("Authorization"))
			if token == "" {
				return httpwriter.WriteError(c, errors.Unauthorized("missing bearer token"))
			}
			principal, err := verifier.ParseAndVerifyAccessToken(token)
			if err != nil {
				return httpwriter.WriteError(c, errors.ToAppError(err))
			}
			req := c.Request()
			c.SetRequest(req.WithContext(identity.WithUserPrincipal(req.Context(), principal)))
			return next(c)
		}
	}
}

func bearerToken(h string) string {
	const prefix = "Bearer "
	if !strings.HasPrefix(h, prefix) {
		return ""
	}
	return strings.TrimSpace(h[len(prefix):])
}
