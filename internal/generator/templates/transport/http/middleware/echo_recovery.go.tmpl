package middleware

import (
	"runtime/debug"

	"github.com/labstack/echo/v4"

	"{{.ModuleName}}/internal/transport/http/httpwriter"
	"{{.ModuleName}}/pkg/errors"
	"{{.ModuleName}}/pkg/logctx"
)

// Recovery logs panics through the request-scoped logger and returns 500 in
// the standard response envelope. If the panicking handler already committed
// the response (c.Response().Committed), the envelope is skipped — partial
// body is already on the wire and double-write would error.
func Recovery() echo.MiddlewareFunc {
	return func(next echo.HandlerFunc) echo.HandlerFunc {
		return func(c echo.Context) (err error) {
			defer func() {
				r := recover()
				if r == nil {
					return
				}
				committed := c.Response().Committed
				logctx.From(c.Request().Context()).Error("panic recovered",
					"panic", r,
					"stack", string(debug.Stack()),
					"wrote_header", committed,
				)
				if committed {
					return
				}
				err = httpwriter.WriteError(c, errors.InternalServer("internal server error"))
			}()
			return next(c)
		}
	}
}
