package middleware

import (
	"net/http"
	"time"

	"go.opentelemetry.io/otel/trace"

	"{{.ModuleName}}/pkg/errors"
	"{{.ModuleName}}/pkg/httputil"
	"{{.ModuleName}}/pkg/logctx"
	"{{.ModuleName}}/pkg/observability"
)

func traceIDOr(sc trace.SpanContext) string {
	if !sc.IsValid() {
		return ""
	}
	return sc.TraceID().String()
}

type statusRecorder struct {
	http.ResponseWriter
	status int
}

func (s *statusRecorder) WriteHeader(code int) {
	s.status = code
	s.ResponseWriter.WriteHeader(code)
}

// Logging builds a request-scoped logger (request_id + trace_id), attaches it
// to ctx, installs an AppError stash slot (httpwriter.WriteError fills it on
// 4xx/5xx), and emits ONE access log per request with severity by status.
func Logging(base observability.Logger) func(http.Handler) http.Handler {
	skipPaths := map[string]struct{}{
		"/healthz": {},
		"/readyz":  {},
	}
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			if _, ok := skipPaths[r.URL.Path]; ok {
				next.ServeHTTP(w, r)
				return
			}

			start := time.Now()
			ctx := r.Context()
			reqID := httputil.RequestIDFrom(ctx)
			sc := trace.SpanContextFromContext(ctx)

			// URL.Path is path-only (no query string) — keep it that way so
			// secrets in `?token=...` never reach structured logs. Do NOT
			// switch to r.RequestURI or URL.String().
			// scoped is the request-scoped logger handed to inner layers via
			// logctx: only the correlation fields belong here. client_ip/user_agent
			// are deliberately NOT attached — they're entry-point facts that belong
			// on the single access line below, not repeated on every inner log.
			scoped := base.
				With("request_id", reqID).
				With("trace_id", traceIDOr(sc)).
				With("method", r.Method).
				With("path", r.URL.Path)
			ctx = logctx.With(ctx, scoped)
			ctx = errors.PrepareAppErrorContext(ctx)
			r = r.WithContext(ctx)

			rec := &statusRecorder{ResponseWriter: w, status: http.StatusOK}
			next.ServeHTTP(rec, r)

			ev := scoped.Info
			if rec.status >= 500 {
				ev = scoped.Error
			} else if rec.status >= 400 {
				ev = scoped.Warn
			}
			fields := []any{
				"status", rec.status,
				"duration_ms", time.Since(start).Milliseconds(),
				"client_ip", r.RemoteAddr,
				"user_agent", r.UserAgent(),
			}
			if app := errors.AppErrorFromContext(ctx); app != nil {
				fields = append(fields, "app_code", app.Code)
				if app.Locale != 0 {
					fields = append(fields, "app_locale", int(app.Locale))
				}
				// Surface the inner cause + trace whenever there's something to
				// diagnose: a server fault (5xx), or any error that wrapped an
				// underlying cause. A plain validation 4xx carries no inner Err,
				// so its line stays lean (app_code already names the client
				// mistake) and error-rate alerts stay free of client-driven noise.
				if app.Err != nil || rec.status >= 500 {
					fields = append(fields, "app_err", app.Error(), "app_trace", app.Trace())
				}
			}
			ev("request", fields...)
		})
	}
}
