package middleware

import (
	"net/http"
	"strings"

	"github.com/gin-gonic/gin"

	"{{.ModuleName}}/internal/domain/identity"
	jwtsec "{{.ModuleName}}/internal/infrastructure/jwt"
	"{{.ModuleName}}/internal/transport/http/httpwriter"
	"{{.ModuleName}}/pkg/errors"
	"{{.ModuleName}}/pkg/locale"
)

// RFC 6750 §3 challenges: a missing credential gets the bare scheme, a
// rejected one names the reason.
const (
	challengeMissing = `Bearer`
	challengeInvalid = `Bearer error="invalid_token"`
)

// Auth verifies the bearer token via the JWT verifier and attaches the
// resolved *identity.UserPrincipal to the request context. Every 401 carries
// a WWW-Authenticate challenge.
func Auth(tokenSvc *jwtsec.TokenService) gin.HandlerFunc {
	return func(c *gin.Context) {
		token := bearerToken(c.GetHeader("Authorization"))
		if token == "" {
			c.Header("WWW-Authenticate", challengeMissing)
			httpwriter.WriteError(c, errors.L(locale.Unauthorized).WithCause(errors.New("missing bearer token")))
			c.Abort()
			return
		}
		principal, err := tokenSvc.ParseAndVerifyAccessToken(c.Request.Context(), token)
		if err != nil {
			app := errors.ToAppError(err)
			if app.Code == http.StatusUnauthorized {
				c.Header("WWW-Authenticate", challengeInvalid)
			}
			httpwriter.WriteError(c, app)
			c.Abort()
			return
		}
		rememberPrincipal(c.Request.Context(), principal)
		c.Request = c.Request.WithContext(identity.WithUserPrincipal(c.Request.Context(), principal))
		c.Next()
	}
}

// bearerToken extracts the credential from an Authorization header. The
// scheme is case-insensitive (RFC 9110 §11.1).
func bearerToken(h string) string {
	const prefix = "bearer "
	if len(h) < len(prefix) || !strings.EqualFold(h[:len(prefix)], prefix) {
		return ""
	}
	return strings.TrimSpace(h[len(prefix):])
}
