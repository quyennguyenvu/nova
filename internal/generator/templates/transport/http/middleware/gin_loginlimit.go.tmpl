package middleware

import (
	"sync"

	"github.com/gin-gonic/gin"
	"golang.org/x/time/rate"

	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/transport/http/httpwriter"
	"{{.ModuleName}}/pkg/errors"
	"{{.ModuleName}}/pkg/locale"
)

type ipLimiter struct {
	mu       sync.Mutex
	visitors map[string]*rate.Limiter
	rps      rate.Limit
	burst    int
}

func newIPLimiter(cfg config.LoginRateLimitConfig) *ipLimiter {
	rps := rate.Limit(cfg.RPS)
	if rps <= 0 {
		rps = rate.Limit(5.0 / 60.0)
	}
	burst := cfg.Burst
	if burst <= 0 {
		burst = 5
	}
	return &ipLimiter{visitors: make(map[string]*rate.Limiter), rps: rps, burst: burst}
}

func (l *ipLimiter) allow(ip string) bool {
	l.mu.Lock()
	lim, ok := l.visitors[ip]
	if !ok {
		lim = rate.NewLimiter(l.rps, l.burst)
		l.visitors[ip] = lim
	}
	l.mu.Unlock()
	return lim.Allow()
}

// LoginRateLimit returns a per-IP token-bucket limiter intended for the
// /login route. The visitors map grows with distinct client IPs — swap for
// an LRU cache if /login is exposed to high-cardinality traffic.
func LoginRateLimit(cfg config.LoginRateLimitConfig) gin.HandlerFunc {
	l := newIPLimiter(cfg)
	return func(c *gin.Context) {
		if !l.allow(c.ClientIP()) {
			httpwriter.WriteError(c, errors.L(locale.TooManyRequests))
			c.Abort()
			return
		}
		c.Next()
	}
}
