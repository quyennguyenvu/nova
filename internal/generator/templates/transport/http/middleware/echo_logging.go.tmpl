package middleware

import (
	"time"

	"github.com/labstack/echo/v4"
	"go.opentelemetry.io/otel/trace"

	"{{.ModuleName}}/internal/infrastructure/logger"
	"{{.ModuleName}}/pkg/errors"
	"{{.ModuleName}}/pkg/logctx"
)

func traceIDOr(sc trace.SpanContext) string {
	if !sc.IsValid() {
		return ""
	}
	return sc.TraceID().String()
}

func errMsg(err error) string {
	if err == nil {
		return ""
	}
	return err.Error()
}

// Logging builds a request-scoped logger (request_id + trace_id), attaches it
// to ctx, installs an AppError stash slot (httpwriter.WriteError fills it on
// 4xx/5xx), and emits ONE access log per request with severity by status.
func Logging(base *logger.Logger) echo.MiddlewareFunc {
	return func(next echo.HandlerFunc) echo.HandlerFunc {
		return func(c echo.Context) error {
			start := time.Now()
			req := c.Request()
			ctx := req.Context()
			reqID := RequestIDFrom(ctx)
			sc := trace.SpanContextFromContext(ctx)

			scoped := base.
				With("request_id", reqID).
				With("trace_id", traceIDOr(sc)).
				With("method", req.Method).
				With("path", c.Path())
			ctx = logctx.Into(ctx, scoped)
			ctx = errors.PrepareAppErrorContext(ctx)
			c.SetRequest(req.WithContext(ctx))

			err := next(c)

			status := c.Response().Status
			ev := scoped.Info
			if err != nil || status >= 500 {
				ev = scoped.Error
			} else if status >= 400 {
				ev = scoped.Warn
			}
			fields := []any{
				"status", status,
				"duration_ms", time.Since(start).Milliseconds(),
				"err", errMsg(err),
			}
			if app := errors.AppErrorFromContext(ctx); app != nil {
				fields = append(fields, "app_code", app.Code)
				if app.Locale != 0 {
					fields = append(fields, "app_locale", int(app.Locale))
				}
				if status >= 500 {
					fields = append(fields, "app_trace", app.Trace())
				}
			}
			ev("request", fields...)
			return err
		}
	}
}
