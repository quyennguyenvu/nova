package middleware

import (
	"time"

	"github.com/labstack/echo/v4"
	"go.opentelemetry.io/otel/trace"

	"{{.ModuleName}}/internal/infrastructure/logger"
	"{{.ModuleName}}/pkg/logctx"
)

func traceIDOr(sc trace.SpanContext) string {
	if !sc.IsValid() {
		return ""
	}
	return sc.TraceID().String()
}

func errMsg(err error) string {
	if err == nil {
		return ""
	}
	return err.Error()
}

// Logging builds a request-scoped logger (request_id + trace_id), attaches it
// to ctx, and emits ONE access log per request with severity by status.
func Logging(base *logger.Logger) echo.MiddlewareFunc {
	return func(next echo.HandlerFunc) echo.HandlerFunc {
		return func(c echo.Context) error {
			start := time.Now()
			ctx := c.Request().Context()
			reqID := RequestIDFrom(ctx)
			sc := trace.SpanContextFromContext(ctx)

			scoped := base.
				With("request_id", reqID).
				With("trace_id", traceIDOr(sc)).
				With("method", c.Request().Method).
				With("path", c.Path())
			c.SetRequest(c.Request().WithContext(logctx.Into(ctx, scoped)))

			err := next(c)

			status := c.Response().Status
			ev := scoped.Info
			if err != nil || status >= 500 {
				ev = scoped.Error
			} else if status >= 400 {
				ev = scoped.Warn
			}
			ev("request",
				"status", status,
				"duration_ms", time.Since(start).Milliseconds(),
				"err", errMsg(err),
			)
			return err
		}
	}
}
