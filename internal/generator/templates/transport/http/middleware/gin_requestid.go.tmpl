package middleware

import (
	"github.com/gin-gonic/gin"
	"github.com/google/uuid"

	"{{.ModuleName}}/pkg/httputil"
	"{{.ModuleName}}/pkg/requestid"
)

// RequestID injects a unique request ID into the request headers and its context.
// The ID is carried through ctx (see requestid.From) and echoed back to
// the client in the X-Request-ID header and the response body's "requestId".
func RequestID() gin.HandlerFunc {
	return func(c *gin.Context) {
		id := c.GetHeader(httputil.RequestIDHeader)
		if !requestid.Valid(id) {
			id = uuid.New().String()
		}
		c.Header(httputil.RequestIDHeader, id)
		c.Request = c.Request.WithContext(requestid.With(c.Request.Context(), id))
		c.Next()
	}
}
