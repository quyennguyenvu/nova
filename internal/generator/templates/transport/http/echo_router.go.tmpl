// Package http builds the framework instance: it installs middleware in the
// correct order, exposes /healthz + /readyz, and lets each feature attach its
// own routes via the Registrar interface. Lifecycle (port binding, graceful
// shutdown) is the job of infrastructure/server.
package http

import (
	"net/http"

	"github.com/labstack/echo/v4"

	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/infrastructure/logger"
	"{{.ModuleName}}/internal/transport/http/health"
	"{{.ModuleName}}/internal/transport/http/middleware"
)

// Registrar attaches a feature's routes to a router subtree. Each feature
// (transport/http/v1/<feature>) provides a concrete Registrar implementing
// this interface. Prefix is mounted as a subgroup before Register is called.
// Multiple Registrars may share a Prefix; the slice order in NewRouter
// determines mount order.
type Registrar interface {
	Prefix() string
	Register(*echo.Group)
}

// NewRouter builds the echo instance: middleware → probes → registrars at their prefixes.
//
// registrars is a slice (not a map) so mount order is deterministic.
func NewRouter(
	cfg *config.Config,
	log *logger.Logger,
	checker *health.Checker,
	registrars []Registrar,
) *echo.Echo {
	e := echo.New()
	e.HideBanner = true

	e.Use(middleware.RequestID())
	e.Use(middleware.Logging(log))
	e.Use(middleware.Recovery())
	e.Use(middleware.CORS(cfg.HTTP.CORS))
	e.Use(middleware.Locale())

	e.GET("/healthz", func(c echo.Context) error {
		return c.JSON(http.StatusOK, checker.Liveness())
	})
	e.GET("/readyz", func(c echo.Context) error {
		status := checker.Readiness(c.Request().Context())
		code := http.StatusOK
		if !status.OK {
			code = http.StatusServiceUnavailable
		}
		return c.JSON(code, status)
	})

	for _, r := range registrars {
		r.Register(e.Group(r.Prefix()))
	}

	return e
}
