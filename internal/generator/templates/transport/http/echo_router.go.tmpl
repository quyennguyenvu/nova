// Package http builds the framework instance: it installs middleware in the
// correct order, exposes /healthz + /readyz, and lets each feature attach its
// own routes via the Registrar interface. Lifecycle (port binding, graceful
// shutdown) is the job of infrastructure/server.
package http

import (
	"net/http"

	"github.com/labstack/echo/v4"
	// The replacement module (labstack/echo-opentelemetry) targets echo v5; stay on
	// the contrib package until this project moves to v5.
	"go.opentelemetry.io/contrib/instrumentation/github.com/labstack/echo/otelecho" //nolint:staticcheck // SA1019: echo v4

	"{{.ModuleName}}/api/openapi"
	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/transport/http/health"
	"{{.ModuleName}}/internal/transport/http/httpwriter"
	"{{.ModuleName}}/internal/transport/http/middleware"
	"{{.ModuleName}}/pkg/observability"
)

// Registrar attaches a feature's routes to a router subtree. The version
// package (transport/http/v1) provides a concrete Registrar implementing
// this interface. Prefix is mounted as a subgroup before Register is called.
// Multiple Registrars may share a Prefix; the slice order in NewRouter
// determines mount order.
type Registrar interface {
	Prefix() string
	Register(*echo.Group)
}

// NewRouter builds the echo instance: middleware → probes → registrars at their prefixes.
// Timeout sits inside Recovery so a deadline panic is still caught; BodyLimit
// follows it so the failure mode matches the other net/http frameworks.
// Every error that escapes a handler — the router's 404/405, a handler's
// returned error — goes through httpwriter.HandleError so the client always
// sees the standard envelope.
//
// registrars is a slice (not a map) so mount order is deterministic.
func NewRouter(
	cfg *config.Config,
	log observability.Logger,
	checker *health.Checker,
	registrars []Registrar,
) *echo.Echo {
	e := echo.New()
	e.HideBanner = true
	e.HTTPErrorHandler = httpwriter.HandleError
	e.IPExtractor = ipExtractor(cfg.HTTP)

	// Tracing first so RequestID and Logging see the server span (trace_id).
	e.Use(otelecho.Middleware(
		cfg.AppName,
		otelecho.WithSkipper(func(c echo.Context) bool { return isProbe(c.Request().URL.Path) }),
	))
	e.Use(middleware.RequestID())
	e.Use(middleware.Logging(log))
	e.Use(middleware.Recovery())
	e.Use(middleware.Timeout(cfg.HTTP.RequestTimeout))
	e.Use(middleware.BodyLimit(cfg.HTTP.BodyLimit))
	e.Use(middleware.CORS(cfg.HTTP.CORS))
	e.Use(middleware.Locale())

	e.GET("/healthz", func(c echo.Context) error {
		return c.JSON(http.StatusOK, checker.Liveness())
	})
	e.GET("/readyz", func(c echo.Context) error {
		status, err := checker.Readiness(c.Request().Context())
		if err != nil {
			log.Warn("readiness check failed", "err", err)
		}
		code := http.StatusOK
		if !status.OK {
			code = http.StatusServiceUnavailable
		}
		return c.JSON(code, status)
	})
	e.GET("/openapi.yaml", func(c echo.Context) error {
		return c.Blob(http.StatusOK, "application/yaml", openapi.Spec)
	})

	for _, r := range registrars {
		r.Register(e.Group(r.Prefix()))
	}

	return e
}

// ipExtractor honours X-Forwarded-For only from the proxies listed in config.
// echo's default extractor believes the header from anyone, and its XFF
// extractor trusts private ranges unless told otherwise, so with no trusted
// proxies the TCP peer is the client and the header is ignored.
func ipExtractor(cfg config.HTTPConfig) echo.IPExtractor {
	nets, _ := cfg.TrustedProxyNets() // entries are validated by config.Load
	if len(nets) == 0 {
		return echo.ExtractIPDirect()
	}
	opts := []echo.TrustOption{echo.TrustLoopback(false), echo.TrustLinkLocal(false), echo.TrustPrivateNet(false)}
	for _, n := range nets {
		opts = append(opts, echo.TrustIPRange(n))
	}
	return echo.ExtractIPFromXFFHeader(opts...)
}

// isProbe reports whether path is a health probe. Probes stay out of traces
// (and access logs) because they carry no application signal.
func isProbe(path string) bool { return path == "/healthz" || path == "/readyz" }
