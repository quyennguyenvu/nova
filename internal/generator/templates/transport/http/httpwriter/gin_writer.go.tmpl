// Package httpwriter holds the framework-specific HTTP request-binding and
// response-writing helpers. It lives under internal/transport/http (not pkg/)
// because it is bound to a single framework — the envelope it serializes is in
// pkg/httputil (framework-free).
package httpwriter

import (
	"net/http"
	"strconv"

	"github.com/gin-gonic/gin"
	"github.com/go-playground/validator/v10"

	"{{.ModuleName}}/pkg/errors"
	"{{.ModuleName}}/pkg/httputil"
	"{{.ModuleName}}/pkg/locale"
	"{{.ModuleName}}/pkg/requestid"
)

// WriteJSON writes a successful JSON response wrapped in the standard envelope.
func WriteJSON(c *gin.Context, status int, data any) {
	resp := httputil.SuccessResponse(data)
	resp.RequestID = requestid.From(c.Request.Context())
	c.JSON(status, resp)
}

// WriteListJSON writes a paginated list response: the standard success envelope
// with data plus pagination meta (a httputil.CursorMeta for the user-facing
// cursor form, or a httputil.PageMeta for the admin offset form).
func WriteListJSON(c *gin.Context, status int, data, meta any) {
	resp := httputil.SuccessListResponse(data, meta)
	resp.RequestID = requestid.From(c.Request.Context())
	c.JSON(status, resp)
}

// WriteError writes an error JSON response wrapped in the standard envelope.
// The HTTP status is taken from app.Code. The message is translated using the
// language carried in the request context (set by the Locale middleware) when
// app carries a Locale code; otherwise app.Message is used as-is.
// Also stashes app into the request ctx so the Logging middleware can include
// app_code/app_locale fields in the access log without a second mapping pass.
func WriteError(c *gin.Context, app *errors.AppError) {
	ctx := c.Request.Context()
	errors.StashAppError(ctx, app)
	lang := locale.LanguageFromContext(ctx)
	resp := httputil.ErrorResponseFromApp(app, lang)
	resp.RequestID = requestid.From(ctx)
	c.JSON(app.Code, resp)
}

// Bind decodes the request body into a fresh T and runs struct-tag validation.
// A parse failure and a validation failure both map to the same generic
// localized 400 — clients never see binder internals or field names — while the
// underlying cause rides along via WithCause so it surfaces in the access log's
// app_err/app_trace, traceable by request_id.
func Bind[T any](c *gin.Context, validate *validator.Validate) (T, *errors.AppError) {
	var v T
	if err := c.ShouldBindJSON(&v); err != nil {
		return v, bindError(err)
	}
	if err := validate.Struct(&v); err != nil {
		return v, errors.L(locale.InvalidRequest).WithCause(err)
	}
	return v, nil
}

// ParseID reads path parameter name as an int64, mapping a missing or malformed
// value to the same generic localized 400 as Bind.
func ParseID(c *gin.Context, name string) (int64, *errors.AppError) {
	id, err := strconv.ParseInt(c.Param(name), 10, 64)
	if err != nil {
		return 0, errors.L(locale.InvalidRequest).WithCause(err)
	}
	return id, nil
}

// BindQuery decodes the request query string into a fresh T (struct tags:
// `form:"..."`) and runs struct-tag validation, with the same generic 400
// mapping as Bind. Pagination bounds stay in the usecase, so a query DTO
// typically validates only shape (formats, enums), not magnitude.
func BindQuery[T any](c *gin.Context, validate *validator.Validate) (T, *errors.AppError) {
	var v T
	if err := c.ShouldBindQuery(&v); err != nil {
		return v, errors.L(locale.InvalidRequest).WithCause(err)
	}
	if err := validate.Struct(&v); err != nil {
		return v, errors.L(locale.InvalidRequest).WithCause(err)
	}
	return v, nil
}

// bindError maps a body-decoding failure: a body over the configured limit is
// 413 (net/http's MaxBytesReader), anything else the generic 400.
func bindError(err error) *errors.AppError {
	var tooLarge *http.MaxBytesError
	if errors.As(err, &tooLarge) {
		return errors.L(locale.PayloadTooLarge).WithCause(err)
	}
	return errors.L(locale.InvalidRequest).WithCause(err)
}
