// Package health is the framework-agnostic readiness probe. Liveness is a
// trivial process-up signal (use for restart loops); readiness pings every
// downstream dependency the process needs to serve traffic — DB pool, Redis
// — and returns 503 if any is unreachable.
//
// Each check runs under a 1-second deadline so a hung dependency cannot
// cause /readyz itself to back up.
package health

import (
	"context"
{{- if or .HasDatabase .HasRedis}}
	"errors"
	"fmt"
	"time"
{{- end}}
{{- if .HasDatabase}}
{{- if eq .Database "postgres"}}

	"github.com/jackc/pgx/v5/pgxpool"
{{- end}}
{{- if eq .Database "mysql"}}

	"database/sql"
{{- end}}
{{- end}}
{{- if .HasRedis}}

	"{{.ModuleName}}/internal/infrastructure/cache"
{{- end}}
)

// Status is the wire shape of a probe response. Details names each check as
// "ok" or "fail" so an anonymous caller can see which dependency is down
// without learning its error text; the text goes to the log.
type Status struct {
	OK      bool              `json:"ok"`
	Details map[string]string `json:"details,omitempty"`
}

// Checker owns the dependency handles probed by /readyz. Construct via DI.
type Checker struct {
{{- if and .HasDatabase (eq .Database "postgres")}}
	pool *pgxpool.Pool
{{- end}}
{{- if and .HasDatabase (eq .Database "mysql")}}
	db *sql.DB
{{- end}}
{{- if .HasRedis}}
	cache *cache.Client
{{- end}}
}

// NewChecker is the DI provider. Order of parameters mirrors the order
// these dependencies are constructed in wire_gen.go.
func NewChecker(
{{- if and .HasDatabase (eq .Database "postgres")}}
	pool *pgxpool.Pool,
{{- end}}
{{- if and .HasDatabase (eq .Database "mysql")}}
	db *sql.DB,
{{- end}}
{{- if .HasRedis}}
	cacheClient *cache.Client,
{{- end}}
) *Checker {
	return &Checker{
{{- if and .HasDatabase (eq .Database "postgres")}}
		pool: pool,
{{- end}}
{{- if and .HasDatabase (eq .Database "mysql")}}
		db: db,
{{- end}}
{{- if .HasRedis}}
		cache: cacheClient,
{{- end}}
	}
}

// Liveness is a no-op success — the process being able to answer the request
// is the signal. Use for orchestrator restart loops; do NOT couple it to DB
// or cache health (that's what Readiness is for).
func (*Checker) Liveness() Status {
	return Status{OK: true}
}

{{- if or .HasDatabase .HasRedis}}

// Readiness pings every configured dependency under a 1-second deadline.
// Returns OK=false if ANY check fails; the body names the failing check as
// "fail" and the returned error carries every failure's detail for the log.
func (c *Checker) Readiness(ctx context.Context) (Status, error) {
	probeCtx, cancel := context.WithTimeout(ctx, time.Second)
	defer cancel()

	details := map[string]string{}
	var errs []error
	check := func(name string, err error) {
		if err != nil {
			details[name] = "fail"
			errs = append(errs, fmt.Errorf("%s: %w", name, err))
			return
		}
		details[name] = "ok"
	}
{{- if and .HasDatabase (eq .Database "postgres")}}
	check("database", c.pool.Ping(probeCtx))
{{- end}}
{{- if and .HasDatabase (eq .Database "mysql")}}
	check("database", c.db.PingContext(probeCtx))
{{- end}}
{{- if .HasRedis}}
	check("redis", c.cache.Ping(probeCtx).Err())
{{- end}}

	return Status{OK: len(errs) == 0, Details: details}, errors.Join(errs...)
}
{{- else}}

// Readiness has no downstream dependency to probe in this configuration, so
// it reports the same process-up signal as Liveness.
func (*Checker) Readiness(context.Context) (Status, error) {
	return Status{OK: true}, nil
}
{{- end}}
