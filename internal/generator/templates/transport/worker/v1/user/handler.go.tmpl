package user

import (
	"context"
	"encoding/json"

	"{{.ModuleName}}/internal/transport/worker"
	userauditsvc "{{.ModuleName}}/internal/usecase/useraudit"
	"{{.ModuleName}}/pkg/errors"
)

// userCreatedTopic is the wire-level event identifier this handler consumes.
// MUST match the publisher's topic constant (adapter/pubsub.userCreatedTopic).
const userCreatedTopic = "user.created"

// Handler implements worker.Handler for the user.created event. It
// deserializes the inbound JSON, calls userauditsvc.Service.RecordUserCreated,
// and lets the worker's policy translate errors into retries, parking or
// redelivery: input that can never succeed is returned as worker.Poison.
type Handler struct {
	audit *userauditsvc.Service
}

func NewHandler(audit *userauditsvc.Service) *Handler {
	return &Handler{audit: audit}
}

func (*Handler) Topic() string { return userCreatedTopic }

func (h *Handler) Handle(ctx context.Context, payload []byte) error {
	var msg UserCreatedMessage
	if err := json.Unmarshal(payload, &msg); err != nil {
		// Malformed JSON can never succeed: park it on the dead-letter
		// topic/queue instead of retrying it or silently dropping it.
		return worker.Poison(errors.Wrap(err, "user.created: malformed payload"))
	}
	if msg.EventID == "" {
		return worker.Poison(errors.New("user.created: missing eventId"))
	}

	input := userauditsvc.UserCreatedInput{
		EventID:    msg.EventID,
		UserID:     msg.UserID,
		Email:      msg.Email,
		Name:       msg.Name,
		OccurredAt: msg.CreatedAt,
		RawPayload: payload,
	}
	if err := h.audit.RecordUserCreated(ctx, input); err != nil {
		return errors.Wrapf(err, "handle user.created user_id=%d", msg.UserID)
	}
	return nil
}
