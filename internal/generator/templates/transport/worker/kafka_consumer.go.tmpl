package worker

import (
	"context"
	stderrors "errors"

	"github.com/IBM/sarama"

	"{{.ModuleName}}/internal/infrastructure/logger"
)

// kafkaConsumer adapts sarama.ConsumerGroup to the worker.Consumer port.
// One goroutine per partition is owned by sarama; our ConsumeClaim hook
// pulls messages off the partition channel and calls dispatch sequentially.
// Partition order is preserved within a single claim; cross-partition
// ordering is NOT — handlers must tolerate out-of-order delivery if your
// topic has more than one partition.
type kafkaConsumer struct {
	group sarama.ConsumerGroup
	log   *logger.Logger
}

// NewKafkaConsumer wraps the consumer group constructed in
// infrastructure/pubsub.NewKafkaConsumerGroup.
func NewKafkaConsumer(group sarama.ConsumerGroup, log *logger.Logger) Consumer {
	return &kafkaConsumer{group: group, log: log}
}

func (c *kafkaConsumer) Subscribe(ctx context.Context, topics []string, dispatch DispatchFunc) error {
	handler := &kafkaSessionHandler{dispatch: dispatch, log: c.log}

	// sarama's Consume returns each time a rebalance occurs. Loop until
	// the parent context is cancelled (clean shutdown) or the consumer
	// group emits a non-recoverable error.
	for {
		if err := c.group.Consume(ctx, topics, handler); err != nil {
			if stderrors.Is(err, sarama.ErrClosedConsumerGroup) {
				return nil
			}
			return err
		}
		if ctx.Err() != nil {
			return ctx.Err()
		}
	}
}

func (c *kafkaConsumer) Close() error {
	return c.group.Close()
}

// kafkaSessionHandler is sarama's per-session callback bundle. Setup runs
// once at session start, Cleanup once at session end, ConsumeClaim once per
// claimed partition. Errors returned from ConsumeClaim cause sarama to
// rebalance the session.
type kafkaSessionHandler struct {
	dispatch DispatchFunc
	log      *logger.Logger
}

func (*kafkaSessionHandler) Setup(sarama.ConsumerGroupSession) error   { return nil }
func (*kafkaSessionHandler) Cleanup(sarama.ConsumerGroupSession) error { return nil }

func (h *kafkaSessionHandler) ConsumeClaim(sess sarama.ConsumerGroupSession, claim sarama.ConsumerGroupClaim) error {
	for {
		select {
		case msg, ok := <-claim.Messages():
			if !ok {
				return nil
			}
			if err := h.dispatch(sess.Context(), msg.Topic, msg.Value); err != nil {
				// Surface to sarama; the session will rebalance and the
				// message will be redelivered (committed offset is not
				// advanced because we don't MarkMessage on error).
				h.log.Error("kafka: dispatch failed",
					"topic", msg.Topic,
					"partition", msg.Partition,
					"offset", msg.Offset,
					"err", err.Error(),
				)
				return err
			}
			sess.MarkMessage(msg, "")
		case <-sess.Context().Done():
			return nil
		}
	}
}
