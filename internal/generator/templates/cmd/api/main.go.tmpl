package main

import (
	"log"

{{- if eq .HTTPFramework "fiber"}}
	v1 "{{.ModuleName}}/internal/adapter/handler/http/v1"
{{- end}}
{{- if eq .HTTPFramework "gin"}}
	v1 "{{.ModuleName}}/internal/adapter/handler/http/v1"
{{- end}}
{{- if eq .HTTPFramework "chi"}}
	v1 "{{.ModuleName}}/internal/adapter/handler/http/v1"
{{- end}}
{{- if eq .HTTPFramework "echo"}}
	v1 "{{.ModuleName}}/internal/adapter/handler/http/v1"
{{- end}}
	"{{.ModuleName}}/internal/adapter/handler/http/middleware"
	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/infrastructure/di"
)

func main() {
	// Load configuration
{{- if eq .ConfigFormat "yaml"}}
	cfg, err := config.Load("config/config.yaml")
{{- else if eq .ConfigFormat "toml"}}
	cfg, err := config.Load("config/config.toml")
{{- else}}
	cfg, err := config.Load("")
{{- end}}
	if err != nil {
		log.Fatalf("failed to load config: %v", err)
	}

{{- if .UseManualDI}}
	// Initialize dependencies
	container, err := di.NewContainer(cfg)
	if err != nil {
		log.Fatalf("failed to initialize: %v", err)
	}
	defer container.Close()

{{- if eq .HTTPFramework "fiber"}}
	// Register middleware
	app := container.HTTPServer.App()
	app.Use(middleware.RequestID())
	app.Use(middleware.CORS())
	app.Use(middleware.Recovery(container.Logger))
	app.Use(middleware.Logging(container.Logger))

	// Register routes
	v1.RegisterRoutes(app, container.UserHandler)
{{- end}}

{{- if eq .HTTPFramework "gin"}}
	engine := container.HTTPServer.Engine()
	engine.Use(middleware.RequestID())
	engine.Use(middleware.CORS())
	engine.Use(middleware.Recovery(container.Logger))
	engine.Use(middleware.Logging(container.Logger))

	v1.RegisterRoutes(engine, container.UserHandler)
{{- end}}

{{- if eq .HTTPFramework "chi"}}
	router := container.HTTPServer.Router()
	router.Use(middleware.RequestID)
	router.Use(middleware.CORS)
	router.Use(middleware.Recovery(container.Logger))
	router.Use(middleware.Logging(container.Logger))

	v1.RegisterRoutes(router, container.UserHandler)
{{- end}}

{{- if eq .HTTPFramework "echo"}}
	e := container.HTTPServer.Echo()
	e.Use(middleware.RequestID())
	e.Use(middleware.CORS())
	e.Use(middleware.Recovery(container.Logger))
	e.Use(middleware.Logging(container.Logger))

	v1.RegisterRoutes(e, container.UserHandler)
{{- end}}

	// Start server
	container.Logger.Info("starting {{.ProjectName}}", "port", cfg.Server.Port)
	if err := container.HTTPServer.Start(); err != nil {
		log.Fatalf("server error: %v", err)
	}
{{- end}}
}
