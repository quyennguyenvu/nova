package middleware

import (
	"log/slog"
{{- if eq .HTTPFramework "fiber"}}
	"time"
	"github.com/gofiber/fiber/v2"
{{- end}}
{{- if eq .HTTPFramework "gin"}}
	"time"
	"github.com/gin-gonic/gin"
{{- end}}
{{- if eq .HTTPFramework "chi"}}
	"net/http"
	"time"
{{- end}}
{{- if eq .HTTPFramework "echo"}}
	"time"
	"github.com/labstack/echo/v4"
{{- end}}
)

{{- if eq .HTTPFramework "fiber"}}

// Logging returns a Fiber middleware that logs each request.
func Logging(logger *slog.Logger) fiber.Handler {
	return func(c *fiber.Ctx) error {
		start := time.Now()
		err := c.Next()
		duration := time.Since(start)

		logger.Info("request",
			"method", c.Method(),
			"path", c.Path(),
			"status", c.Response().StatusCode(),
			"duration", duration,
			"ip", c.IP(),
			"request_id", c.Get("X-Request-ID"),
		)

		return err
	}
}

{{- end}}

{{- if eq .HTTPFramework "gin"}}

func Logging(logger *slog.Logger) gin.HandlerFunc {
	return func(c *gin.Context) {
		start := time.Now()
		c.Next()
		duration := time.Since(start)

		logger.Info("request",
			"method", c.Request.Method,
			"path", c.Request.URL.Path,
			"status", c.Writer.Status(),
			"duration", duration,
			"ip", c.ClientIP(),
			"request_id", c.GetHeader("X-Request-ID"),
		)
	}
}

{{- end}}

{{- if eq .HTTPFramework "chi"}}

func Logging(logger *slog.Logger) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			start := time.Now()
			next.ServeHTTP(w, r)
			duration := time.Since(start)

			logger.Info("request",
				"method", r.Method,
				"path", r.URL.Path,
				"duration", duration,
				"ip", r.RemoteAddr,
				"request_id", r.Header.Get("X-Request-ID"),
			)
		})
	}
}

{{- end}}

{{- if eq .HTTPFramework "echo"}}

func Logging(logger *slog.Logger) echo.MiddlewareFunc {
	return func(next echo.HandlerFunc) echo.HandlerFunc {
		return func(c echo.Context) error {
			start := time.Now()
			err := next(c)
			duration := time.Since(start)

			logger.Info("request",
				"method", c.Request().Method,
				"path", c.Path(),
				"status", c.Response().Status,
				"duration", duration,
				"ip", c.RealIP(),
				"request_id", c.Request().Header.Get("X-Request-ID"),
			)

			return err
		}
	}
}

{{- end}}
