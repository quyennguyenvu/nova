{{- if eq .MessageQueue "kafka"}}

// Publisher implements domain.UserPublisher using Kafka.
type Publisher struct {
	producer sarama.SyncProducer
}

func NewPublisher(producer sarama.SyncProducer) *Publisher {
	return &Publisher{producer: producer}
}

// Ensure interface compliance at compile time
var _ domain.UserPublisher = (*Publisher)(nil)

func (p *Publisher) publish(ctx context.Context, topic string, payload any) error {
	if err := ctx.Err(); err != nil {
		return errors.Wrapf(err, "publish to %s: context done", topic)
	}
	data, err := json.Marshal(payload)
	if err != nil {
		return errors.Wrapf(err, "publish to %s: marshal event", topic)
	}

	_, _, err = p.producer.SendMessage(&sarama.ProducerMessage{
		Topic: topic,
		Value: sarama.ByteEncoder(data),
	})
	if err != nil {
		return errors.Wrapf(err, "publish to %s", topic)
	}
	return nil
}

func (p *Publisher) Close() error {
	return p.producer.Close()
}

{{- end}}

{{- if eq .MessageQueue "rabbitmq"}}

const rabbitmqExchange = "events"

// Publisher implements domain.UserPublisher using RabbitMQ.
type Publisher struct {
	conn *amqp.Connection
	ch   *amqp.Channel
}

func NewPublisher(conn *amqp.Connection) (*Publisher, error) {
	ch, err := conn.Channel()
	if err != nil {
		return nil, errors.Wrap(err, "open rabbitmq channel")
	}
	if err := ch.ExchangeDeclare(rabbitmqExchange, "topic", true, false, false, false, nil); err != nil {
		_ = ch.Close()
		return nil, errors.Wrap(err, "declare exchange")
	}
	return &Publisher{conn: conn, ch: ch}, nil
}

// Ensure interface compliance at compile time
var _ domain.UserPublisher = (*Publisher)(nil)

func (p *Publisher) publish(ctx context.Context, routingKey string, payload any) error {
	data, err := json.Marshal(payload)
	if err != nil {
		return errors.Wrapf(err, "publish to %s: marshal event", routingKey)
	}
	if err := p.ch.PublishWithContext(ctx, rabbitmqExchange, routingKey, false, false, amqp.Publishing{
		ContentType: "application/json",
		Body:        data,
	}); err != nil {
		return errors.Wrapf(err, "publish to %s", routingKey)
	}
	return nil
}

func (p *Publisher) Close() error {
	if p.ch != nil {
		_ = p.ch.Close()
	}
	return p.conn.Close()
}

{{- end}}

