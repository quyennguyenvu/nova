package postgres

import (
	"context"

	"github.com/jackc/pgx/v5/pgxpool"

	"{{.ModuleName}}/internal/adapter/repository/postgres/mapper"
	"{{.ModuleName}}/internal/domain"
	"{{.ModuleName}}/pkg/errors"
)

var _ domain.UserAuditRepository = (*UserAuditRepository)(nil)

// UserAuditRepository implements domain.UserAuditRepository over the
// sqlc-generated user_audit_log queries. The repo reuses the qx pattern so
// audit writes can participate in the same transaction as other writes
// when a future caller wraps them in TxManager.WithinTx.
type UserAuditRepository struct {
	qx *qx
}

func NewUserAuditRepository(pool *pgxpool.Pool) *UserAuditRepository {
	return &UserAuditRepository{qx: newQX(pool)}
}

func (r *UserAuditRepository) RecordCreated(ctx context.Context, entry *domain.UserAuditEntry) error {
	row, err := r.qx.Q(ctx).RecordUserAudit(ctx, mapper.UserAuditToCreateParams(entry))
	if err != nil {
		return errors.Wrapf(err, "user audit repo: insert user_id=%d", entry.UserID)
	}
	entry.ID = row.ID
	return nil
}
