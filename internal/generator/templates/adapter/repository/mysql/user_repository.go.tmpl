package mysql

import (
	"context"
	"database/sql"
	stderrors "errors"

	"{{.ModuleName}}/internal/adapter/repository/mysql/dbgen"
	"{{.ModuleName}}/internal/adapter/repository/mysql/mapper"
	"{{.ModuleName}}/internal/domain"
	"{{.ModuleName}}/internal/domain/entity"
	"{{.ModuleName}}/pkg/errors"
)

var _ domain.UserRepository = (*UserRepository)(nil)

// UserRepository implements domain.UserRepository using sqlc-generated queries.
// It never calls row.Scan directly — all hydration goes through the mapper package.
type UserRepository struct {
	qx *qx
}

func NewUserRepository(db *sql.DB) *UserRepository {
	return &UserRepository{qx: newQX(db)}
}

func (r *UserRepository) Create(ctx context.Context, user *entity.User) error {
	id, err := r.qx.Q(ctx).CreateUser(ctx, mapper.UserToCreateParams(user))
	if err != nil {
		return errors.Wrapf(err, "user repo: insert email=%s", user.Email)
	}
	user.ID = id
	return nil
}

func (r *UserRepository) GetByID(ctx context.Context, id int64) (*entity.User, error) {
	row, err := r.qx.Q(ctx).GetUserByID(ctx, id)
	if err != nil {
		if stderrors.Is(err, sql.ErrNoRows) {
			return nil, errors.Wrapf(errors.ErrNotFound, "user repo: select id=%d", id)
		}
		return nil, errors.Wrapf(err, "user repo: select id=%d", id)
	}
	return mapper.UserToEntity(row), nil
}

func (r *UserRepository) GetByEmail(ctx context.Context, email string) (*entity.User, error) {
	row, err := r.qx.Q(ctx).GetUserByEmail(ctx, email)
	if err != nil {
		if stderrors.Is(err, sql.ErrNoRows) {
			return nil, errors.Wrapf(errors.ErrNotFound, "user repo: select email=%s", email)
		}
		return nil, errors.Wrapf(err, "user repo: select email=%s", email)
	}
	return mapper.UserToEntity(row), nil
}

func (r *UserRepository) Update(ctx context.Context, user *entity.User) error {
	if err := r.qx.Q(ctx).UpdateUser(ctx, mapper.UserToUpdateParams(user)); err != nil {
		return errors.Wrapf(err, "user repo: update id=%d", user.ID)
	}
	return nil
}

func (r *UserRepository) Delete(ctx context.Context, id int64) error {
	if err := r.qx.Q(ctx).DeleteUser(ctx, id); err != nil {
		return errors.Wrapf(err, "user repo: delete id=%d", id)
	}
	return nil
}

func (r *UserRepository) List(ctx context.Context, filter domain.UserFilter) ([]*entity.User, error) {
	rows, err := r.qx.Q(ctx).ListUsers(ctx, dbgen.ListUsersParams{
		Email:  filter.Email,
		Limit:  int32(filter.Limit),
		Offset: int32(filter.Offset),
	})
	if err != nil {
		return nil, errors.Wrapf(err, "user repo: list")
	}
	return mapper.UsersToEntities(rows), nil
}

func (r *UserRepository) Count(ctx context.Context, filter domain.UserFilter) (int64, error) {
	total, err := r.qx.Q(ctx).CountUsers(ctx, dbgen.CountUsersParams{Email: filter.Email})
	if err != nil {
		return 0, errors.Wrapf(err, "user repo: count")
	}
	return total, nil
}

func (r *UserRepository) ListAfter(ctx context.Context, cursor int64, limit int32) ([]*entity.User, error) {
	rows, err := r.qx.Q(ctx).ListUsersAfter(ctx, dbgen.ListUsersAfterParams{
		Cursor: cursor,
		Limit:  limit,
	})
	if err != nil {
		return nil, errors.Wrapf(err, "user repo: list after cursor=%d", cursor)
	}
	return mapper.UsersToEntities(rows), nil
}
