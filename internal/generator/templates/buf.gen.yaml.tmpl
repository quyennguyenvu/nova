# `make proto-gen` runs `buf generate`. The Go plugins are version-pinned
# `go run` invocations: nothing to install besides buf, and these are the only
# versions to bump.
version: v2
inputs:
  - directory: api/proto
plugins:
  - local: [go, run, google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.12]
    out: api/gen
    opt: paths=source_relative
  - local: [go, run, google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.6.2]
    out: api/gen
    opt: paths=source_relative
