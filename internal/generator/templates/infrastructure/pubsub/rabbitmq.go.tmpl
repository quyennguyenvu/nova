package pubsub

import (
	"errors"
	"fmt"

	amqp "github.com/rabbitmq/amqp091-go"

	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/infrastructure/logger"
)

// NewRabbitMQConnection dials RabbitMQ and returns the cleanup that closes the
// connection (which closes every channel opened on it). Infrastructure —
// connection setup only, no business logic.
func NewRabbitMQConnection(cfg config.RabbitMQConfig, log *logger.Logger) (*amqp.Connection, func(), error) {
	conn, err := amqp.Dial(cfg.URL)
	if err != nil {
		return nil, nil, fmt.Errorf("dial rabbitmq: %w", err)
	}
	cleanup := func() {
		log.Info("[rabbitmq] closing connection ...")
		if closeErr := conn.Close(); closeErr != nil && !errors.Is(closeErr, amqp.ErrClosed) {
			log.Error("[rabbitmq] failed to close connection", "err", closeErr)
		}
	}
	return conn, cleanup, nil
}

// NewRabbitMQChannel opens a channel on the supplied connection. Channels are
// not safe for concurrent use; create one per consumer/publisher. The
// returned cleanup closes the channel — the connection itself is closed by
// the connection-level cleanup in DI.
func NewRabbitMQChannel(conn *amqp.Connection, log *logger.Logger) (*amqp.Channel, func(), error) {
	ch, err := conn.Channel()
	if err != nil {
		return nil, nil, fmt.Errorf("open rabbitmq channel: %w", err)
	}
	cleanup := func() {
		log.Info("[rabbitmq] closing channel ...")
		if closeErr := ch.Close(); closeErr != nil {
			log.Error("[rabbitmq] failed to close channel", "err", closeErr)
		}
	}
	return ch, cleanup, nil
}
