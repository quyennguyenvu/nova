// Package jwtsec issues and verifies access tokens. Default algorithm is
// HS256 (HMAC-SHA-256) — a single shared secret signs and verifies. Swap to
// RS256 by replacing the SigningMethod + key plumbing here without touching
// callers; the TokenService surface (Sign / ParseAndVerifyAccessToken) is
// what middleware and usecases depend on.
package jwtsec

import (
	"strconv"
	"time"

	"github.com/golang-jwt/jwt/v4"

	"{{.ModuleName}}/internal/domain/identity"
	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/pkg/errors"
)

// TokenService is the symmetric-key signer/verifier. One instance per
// process; safe for concurrent use.
type TokenService struct {
	secret         []byte
	issuer         string
	audience       string
	accessTokenTTL time.Duration
}

// minSecretBytes is the HS256 secret floor — RFC 7518 §3.2 requires keys
// of size ≥ hash output (256 bits). Anything shorter weakens the MAC and
// makes brute-force forgery feasible.
const minSecretBytes = 32

func NewTokenService(cfg config.JWTConfig) (*TokenService, error) {
	if len(cfg.Secret) < minSecretBytes {
		return nil, errors.InternalServer(
			"jwt: secret must be at least 32 bytes (256 bits); generate one with `openssl rand -hex 32`",
		)
	}
	ttl := cfg.AccessTokenTTL
	if ttl <= 0 {
		ttl = time.Hour
	}
	return &TokenService{
		secret:         []byte(cfg.Secret),
		issuer:         cfg.Issuer,
		audience:       cfg.Audience,
		accessTokenTTL: ttl,
	}, nil
}

// AccessTokenTTL exposes the configured lifetime so handlers can return it
// in the login response (RFC 6749 expires_in).
func (s *TokenService) AccessTokenTTL() time.Duration { return s.accessTokenTTL }

// Sign issues a signed access token for p. The token's exp/iat/iss/aud are
// derived from config; custom claims (userId, email, …) come from p.
func (s *TokenService) Sign(p *identity.UserPrincipal) (string, error) {
	now := time.Now()
	claims := AccessTokenClaims{
		RegisteredClaims: jwt.RegisteredClaims{
			Issuer:    s.issuer,
			Subject:   formatSubject(p.UserID),
			Audience:  jwt.ClaimStrings{s.audience},
			ExpiresAt: jwt.NewNumericDate(now.Add(s.accessTokenTTL)),
			IssuedAt:  jwt.NewNumericDate(now),
			NotBefore: jwt.NewNumericDate(now),
		},
		UserID:    p.UserID,
		Email:     p.Email,
		Name:      p.Name,
		Phone:     p.Phone,
		DeviceID:  p.DeviceID,
		Platform:  p.Platform,
		SessionID: p.SessionID,
	}
	tkn := jwt.NewWithClaims(jwt.SigningMethodHS256, claims)
	signed, err := tkn.SignedString(s.secret)
	if err != nil {
		return "", errors.Wrap(err, "jwt: sign access token")
	}
	return signed, nil
}

// ParseAndVerifyAccessToken validates tokenStr and projects its claims into a
// UserPrincipal. Returns *AppError(401) on any verification failure so the
// transport boundary can pass the error straight to httpwriter.WriteError.
func (s *TokenService) ParseAndVerifyAccessToken(tokenStr string) (*identity.UserPrincipal, error) {
	var claims AccessTokenClaims
	tkn, err := jwt.ParseWithClaims(
		tokenStr,
		&claims,
		func(t *jwt.Token) (any, error) {
			if _, ok := t.Method.(*jwt.SigningMethodHMAC); !ok {
				return nil, errors.Unauthorized("unexpected signing method")
			}
			return s.secret, nil
		},
		jwt.WithValidMethods([]string{jwt.SigningMethodHS256.Alg()}),
	)
	if err != nil {
		return nil, errors.Wrap(err, "invalid access token")
	}
	if !tkn.Valid {
		return nil, errors.Unauthorized("invalid access token")
	}
	if s.issuer != "" && !claims.VerifyIssuer(s.issuer, true) {
		return nil, errors.Unauthorized("bad issuer")
	}
	if s.audience != "" && !claims.VerifyAudience(s.audience, true) {
		return nil, errors.Unauthorized("bad audience")
	}

	return &identity.UserPrincipal{
		Principal: identity.Principal{
			UserID: claims.UserID,
			Email:  claims.Email,
		},
		Name:      claims.Name,
		Phone:     claims.Phone,
		DeviceID:  claims.DeviceID,
		Platform:  claims.Platform,
		SessionID: claims.SessionID,
	}, nil
}

// formatSubject keeps the JWT sub claim as a decimal string — JSON numbers
// in JWT can lose precision in some libraries; stringify defensively.
func formatSubject(userID int64) string {
	return strconv.FormatInt(userID, 10)
}
