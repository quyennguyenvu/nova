package jwtsec

import (
	"crypto/rsa"
	"encoding/base64"

	"github.com/golang-jwt/jwt/v4"

	"{{.ModuleName}}/internal/domain/identity"
	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/pkg/errors"
)

// Verifier parses and verifies access tokens issued by the identity provider.
// Add per-audience verifier methods (admin, service-to-service) by introducing
// a second public key + claim type — don't overload this one with conditionals.
type Verifier struct {
	identityIssuer    string
	identityPublicKey any
	Audience          string
}

func NewVerifier(cfg *config.Config) (*Verifier, error) {
	jwtCfg := cfg.JWTVerifier

	identityPublicKey, err := getPublicKey(jwtCfg.IdentityPublicKeyBase64)
	if err != nil {
		return nil, errors.Wrap(err, "failed to parse identity public key")
	}

	return &Verifier{
		identityPublicKey: identityPublicKey,
		identityIssuer:    jwtCfg.IdentityIssuer,
		Audience:          jwtCfg.Audience,
	}, nil
}

func getPublicKey(publicKeyBase64 string) (*rsa.PublicKey, error) {
	decodedPublicKey, err := base64.StdEncoding.DecodeString(publicKeyBase64)
	if err != nil {
		return nil, errors.Wrap(err, "failed to decode RSA public key")
	}
	publicKey, err := jwt.ParseRSAPublicKeyFromPEM(decodedPublicKey)
	if err != nil {
		return nil, errors.Wrap(err, "failed to parse RSA public key")
	}
	return publicKey, nil
}

func (v *Verifier) ParseAndVerifyAccessToken(tokenStr string) (*identity.UserPrincipal, error) {
	var claims AccessTokenClaims
	tkn, err := jwt.ParseWithClaims(
		tokenStr,
		&claims,
		func(t *jwt.Token) (any, error) {
			if _, isValid := t.Method.(*jwt.SigningMethodRSA); !isValid {
				return nil, errors.Unauthorized("unexpected_signing_method")
			}
			return v.identityPublicKey, nil
		},
		jwt.WithValidMethods([]string{"RS256"}),
	)
	if err != nil {
		return nil, errors.Wrap(err, "invalid_access_token")
	}
	if !tkn.Valid {
		return nil, errors.Unauthorized("invalid_access_token")
	}
	if !claims.VerifyIssuer(v.identityIssuer, true) {
		return nil, errors.Unauthorized("bad_issuer")
	}
	if !claims.VerifyAudience(v.Audience, true) {
		return nil, errors.Unauthorized("bad_audience")
	}

	return &identity.UserPrincipal{
		Principal: identity.Principal{
			UserID: claims.UserID,
			Email:  claims.Email,
		},
		Name:      claims.Name,
		Phone:     claims.Phone,
		DeviceID:  claims.DeviceID,
		Platform:  claims.Platform,
		SessionID: claims.SessionID,
	}, nil
}
