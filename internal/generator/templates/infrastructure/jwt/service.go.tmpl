// Package jwtsec issues and verifies access tokens using RS256 (RSA-SHA-256,
// asymmetric). The private key signs at login; the public key verifies on
// every request. In a microservices fleet the token-issuing service holds
// both keys (signs + verifies) while downstream services configure only the
// public key and run verify-only — Sign errors when no private key is set.
// Swap to a different algorithm by replacing the SigningMethod + key plumbing
// here without touching callers: middleware depends on the TokenService
// surface (ParseAndVerifyAccessToken), the usecase only on the
// security.TokenIssuer port this type satisfies.
package jwtsec

import (
	"context"
	"crypto/rsa"
	"encoding/base64"
	"strconv"
	"time"

	"github.com/golang-jwt/jwt/v5"

	"{{.ModuleName}}/internal/domain/identity"
	"{{.ModuleName}}/internal/domain/security"
	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/pkg/errors"
	"{{.ModuleName}}/pkg/locale"
	"{{.ModuleName}}/pkg/logctx"
)

// TokenService is the RS256 signer/verifier. One instance per process; safe
// for concurrent use. privateKey is nil on verify-only services.
type TokenService struct {
	privateKey     *rsa.PrivateKey
	publicKey      *rsa.PublicKey
	issuer         string
	audience       string
	accessTokenTTL time.Duration
}

var _ security.TokenIssuer = (*TokenService)(nil)

// NewTokenService parses the base64-encoded PEM keys from config once at
// startup, so request-path verification touches only the in-memory key. The
// public key is mandatory — every service must verify. The private key is
// optional: when absent the service runs verify-only and Sign errors.
func NewTokenService(cfg config.JWTConfig) (*TokenService, error) {
	publicKey, err := parseRSAPublicKey(cfg.PublicKey)
	if err != nil {
		return nil, errors.Wrap(err, "jwt: load public key")
	}

	var privateKey *rsa.PrivateKey
	if cfg.PrivateKey != "" {
		privateKey, err = parseRSAPrivateKey(cfg.PrivateKey)
		if err != nil {
			return nil, errors.Wrap(err, "jwt: load private key")
		}
	}

	ttl := cfg.AccessTokenTTL
	if ttl <= 0 {
		ttl = time.Hour
	}
	return &TokenService{
		privateKey:     privateKey,
		publicKey:      publicKey,
		issuer:         cfg.Issuer,
		audience:       cfg.Audience,
		accessTokenTTL: ttl,
	}, nil
}

// AccessTokenTTL exposes the configured lifetime so handlers can return it
// in the login response (RFC 6749 expires_in).
func (s *TokenService) AccessTokenTTL() time.Duration { return s.accessTokenTTL }

// Sign issues a signed access token for p. The token's exp/iat/iss/aud are
// derived from config; custom claims (userId, email, name) come from p.
// Returns an error on verify-only services (no private key configured).
func (s *TokenService) Sign(p *identity.UserPrincipal) (string, error) {
	if s.privateKey == nil {
		return "", errors.L(locale.InternalError).
			WithCause(errors.New("no signing key configured (verify-only service)"))
	}
	now := time.Now()
	claims := AccessTokenClaims{
		RegisteredClaims: jwt.RegisteredClaims{
			Issuer:    s.issuer,
			Subject:   formatSubject(p.UserID),
			Audience:  jwt.ClaimStrings{s.audience},
			ExpiresAt: jwt.NewNumericDate(now.Add(s.accessTokenTTL)),
			IssuedAt:  jwt.NewNumericDate(now),
			NotBefore: jwt.NewNumericDate(now),
		},
		UserID: p.UserID,
		Email:  p.Email,
		Name:   p.Name,
	}
	tkn := jwt.NewWithClaims(jwt.SigningMethodRS256, claims)
	signed, err := tkn.SignedString(s.privateKey)
	if err != nil {
		return "", errors.Wrap(err, "jwt: sign access token")
	}
	return signed, nil
}

// ParseAndVerifyAccessToken validates tokenStr against the public key and
// projects its claims into a UserPrincipal. Returns *AppError(401) on any
// verification failure so the transport boundary can pass the error straight
// to httpwriter.WriteError. The client always gets a generic localized 401
// (locale.Unauthorized) — the specific reason is logged server-side, never
// returned. ctx is used only to reach the request-scoped logger via logctx.From.
func (s *TokenService) ParseAndVerifyAccessToken(
	ctx context.Context,
	tokenStr string,
) (*identity.UserPrincipal, error) {
	var claims AccessTokenClaims
	opts := []jwt.ParserOption{
		jwt.WithValidMethods([]string{jwt.SigningMethodRS256.Alg()}),
		jwt.WithExpirationRequired(),
	}
	// Issuer and audience are enforced by the parser, so a token signed with
	// our key but minted for another environment fails like any other bad
	// token; classifyParseError still flags it as anomalous.
	if s.issuer != "" {
		opts = append(opts, jwt.WithIssuer(s.issuer))
	}
	if s.audience != "" {
		opts = append(opts, jwt.WithAudience(s.audience))
	}
	tkn, err := jwt.ParseWithClaims(
		tokenStr,
		&claims,
		func(t *jwt.Token) (any, error) {
			if _, ok := t.Method.(*jwt.SigningMethodRSA); !ok {
				return nil, errors.L(locale.Unauthorized).WithCause(errors.New("unexpected signing method"))
			}
			return s.publicKey, nil
		},
		opts...,
	)
	if err != nil {
		logVerifyFailure(ctx, err)
		return nil, errors.L(locale.Unauthorized).WithCause(err)
	}
	if tkn == nil || !tkn.Valid {
		return nil, errors.L(locale.Unauthorized).WithCause(errors.New("token invalid"))
	}

	return &identity.UserPrincipal{
		Principal: identity.Principal{
			UserID: claims.UserID,
			Email:  claims.Email,
		},
		Name: claims.Name,
	}, nil
}

// logVerifyFailure routes a token-parse failure by operational severity rather
// than logging every one. At millions of logins the routine rejections —
// expired tokens, malformed/garbage input from buggy or stale clients — are
// constant background noise and carry no signal, so they go to Debug (silent at
// the default Info level). An invalid signature, an unverifiable token or a
// wrong issuer/audience is the opposite: it means either the public key has
// drifted across the fleet (an ops bug), a token from another environment is
// being replayed, or someone is presenting a forged token, so it goes to Warn.
// The stable `reason` field lets a log-based alert key off the anomalous bucket
// without a metrics pipeline; raw err goes only to the server-side log, never
// the client.
func logVerifyFailure(ctx context.Context, err error) {
	log := logctx.From(ctx)
	reason, anomalous := classifyParseError(err)
	if anomalous {
		log.Warn("jwt verification anomaly", "reason", reason, "err", err.Error())
		return
	}
	log.Debug("jwt verification rejected", "reason", reason)
}

// classifyParseError maps a golang-jwt v5 error to a stable reason string,
// plus whether it is anomalous (worth a Warn). The specific sentinels are
// checked before the generic ErrTokenInvalidClaims they are joined with.
// Anything unrecognised is anomalous so it can never hide in the noise.
func classifyParseError(err error) (string, bool) {
	switch {
	case errors.Is(err, jwt.ErrTokenSignatureInvalid), errors.Is(err, jwt.ErrTokenUnverifiable):
		return "signature_invalid", true
	case errors.Is(err, jwt.ErrTokenInvalidIssuer):
		return "bad_issuer", true
	case errors.Is(err, jwt.ErrTokenInvalidAudience):
		return "bad_audience", true
	case errors.Is(err, jwt.ErrTokenMalformed):
		return "malformed", false
	case errors.Is(err, jwt.ErrTokenExpired):
		return "expired", false
	case errors.Is(err, jwt.ErrTokenNotValidYet), errors.Is(err, jwt.ErrTokenUsedBeforeIssued):
		return "not_yet_valid", false
	case errors.Is(err, jwt.ErrTokenInvalidClaims), errors.Is(err, jwt.ErrTokenRequiredClaimMissing):
		return "claims_invalid", false
	default:
		return "unknown", true
	}
}

// parseRSAPublicKey decodes a base64-encoded PEM block into an RSA public key.
func parseRSAPublicKey(b64 string) (*rsa.PublicKey, error) {
	pemBytes, err := base64.StdEncoding.DecodeString(b64)
	if err != nil {
		return nil, errors.Wrap(err, "base64 decode")
	}
	key, err := jwt.ParseRSAPublicKeyFromPEM(pemBytes)
	if err != nil {
		return nil, errors.Wrap(err, "parse PEM")
	}
	return key, nil
}

// parseRSAPrivateKey decodes a base64-encoded PEM block into an RSA private key.
func parseRSAPrivateKey(b64 string) (*rsa.PrivateKey, error) {
	pemBytes, err := base64.StdEncoding.DecodeString(b64)
	if err != nil {
		return nil, errors.Wrap(err, "base64 decode")
	}
	key, err := jwt.ParseRSAPrivateKeyFromPEM(pemBytes)
	if err != nil {
		return nil, errors.Wrap(err, "parse PEM")
	}
	return key, nil
}

// formatSubject keeps the JWT sub claim as a decimal string — JSON numbers
// in JWT can lose precision in some libraries; stringify defensively.
func formatSubject(userID int64) string {
	return strconv.FormatInt(userID, 10)
}
