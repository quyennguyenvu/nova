package jwtsec

import "github.com/golang-jwt/jwt/v4"

// AccessTokenClaims is the canonical user access-token shape issued by the
// identity provider. Add admin/service-token claim types here as new audiences
// come online — keep them as separate structs so the verifier can dispatch
// on aud without runtime conditionals.
type AccessTokenClaims struct {
	jwt.RegisteredClaims

	DeviceID  string `json:"deviceId"`
	UserID    int32  `json:"userId"`
	Email     string `json:"email"`
	Name      string `json:"name"`
	Phone     string `json:"phone"`
	Platform  string `json:"platform"`
	SessionID string `json:"sessionId"`
}
