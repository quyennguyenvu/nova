package database

import (
	"context"
	"database/sql"
	"fmt"
	"net"
	"strconv"
	"time"

	"github.com/go-sql-driver/mysql"

	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/infrastructure/logger"
)

// pingTimeout bounds the startup connectivity check so a down database fails
// fast instead of hanging boot.
const pingTimeout = 5 * time.Second

// NewMySQLDB creates a new MySQL database connection.
func NewMySQLDB(cfg config.DatabaseConfig, log *logger.Logger) (*sql.DB, func(), error) {
	// NewConfig() seeds the driver defaults (AllowNativePasswords, UTC loc, …)
	// and FormatDSN() escapes every field — a raw fmt.Sprintf corrupts the DSN
	// when the password contains '@', ':', '/' or a space.
	mysqlCfg := mysql.NewConfig()
	mysqlCfg.User = cfg.User
	mysqlCfg.Passwd = cfg.Password
	mysqlCfg.Net = "tcp"
	mysqlCfg.Addr = net.JoinHostPort(cfg.Host, strconv.Itoa(cfg.Port))
	mysqlCfg.DBName = cfg.Name
	mysqlCfg.ParseTime = true

	db, err := sql.Open("mysql", mysqlCfg.FormatDSN())
	if err != nil {
		return nil, nil, fmt.Errorf("failed to open database: %w", err)
	}

	db.SetMaxOpenConns(cfg.MaxOpenConns)
	db.SetMaxIdleConns(cfg.MaxIdleConns)

	ctx, cancel := context.WithTimeout(context.Background(), pingTimeout)
	defer cancel()

	if pingErr := db.PingContext(ctx); pingErr != nil {
		return nil, nil, fmt.Errorf("failed to ping database: %w", pingErr)
	}

	cleanup := func() {
		log.Info("[db] closing connection pool...")
		_ = db.Close()
		log.Info("[db] closed")
	}

	return db, cleanup, nil
}
