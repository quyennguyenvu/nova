package database

import (
	"context"
	"net"
	"net/url"
	"strconv"

	"github.com/jackc/pgx/v5/pgxpool"

	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/infrastructure/logger"
	"{{.ModuleName}}/pkg/errors"
)

// NewPostgresDB creates a new PostgreSQL connection pool.
func NewPostgresDB(cfg config.DatabaseConfig, log *logger.Logger) (*pgxpool.Pool, func(), error) {
	// Build the DSN via net/url so credentials are percent-encoded.
	// A raw fmt.Sprintf corrupts the URL — and breaks pgxpool.ParseConfig —
	// the moment the password contains '@', ':', '/', '?', '#' or a space.
	u := url.URL{
		Scheme:   "postgres",
		User:     url.UserPassword(cfg.User, cfg.Password),
		Host:     net.JoinHostPort(cfg.Host, strconv.Itoa(cfg.Port)),
		Path:     cfg.Name,
		RawQuery: "sslmode=" + cfg.SSLMode,
	}

	poolCfg, err := pgxpool.ParseConfig(u.String())
	if err != nil {
		return nil, nil, errors.Wrap(err, "failed to parse database config")
	}

	poolCfg.MaxConns = cfg.MaxConns
	poolCfg.MinConns = cfg.MinConns
	poolCfg.MaxConnLifetime = cfg.MaxConnLifetime
	poolCfg.MaxConnIdleTime = cfg.MaxConnIdleTime

	ctx, cancel := context.WithTimeout(context.Background(), cfg.ConnectTimeout)
	defer cancel()

	pool, err := pgxpool.NewWithConfig(ctx, poolCfg)
	if err != nil {
		return nil, nil, errors.Wrap(err, "failed to connect to database")
	}

	if pingErr := pool.Ping(ctx); pingErr != nil {
		return nil, nil, errors.Wrap(pingErr, "failed to ping database")
	}

	cleanup := func() {
		log.Info("[db] closing connection pool...")
		pool.Close()
		log.Info("[db] closed")
	}

	return pool, cleanup, nil
}
