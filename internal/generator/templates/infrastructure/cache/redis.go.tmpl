package cache

import (
	"context"
	"fmt"
	"time"

	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/infrastructure/logger"

	"github.com/redis/go-redis/v9"
)

const (
	single   = "single"
	sentinel = "sentinel"
	cluster  = "cluster"
)

// Client is a thin wrapper so callers depend on an interface, not a concrete type.
// Both *redis.Client and *redis.ClusterClient satisfy redis.UniversalClient.
type Client struct {
	redis.UniversalClient
}

// New is the single factory entry-point — picks mode from config.
func New(cfg config.RedisConfig, log *logger.Logger) (*Client, func(), error) {
	var uc redis.UniversalClient

	switch cfg.Mode {
	case single:
		uc = newSingle(cfg)
	case sentinel:
		uc = newSentinel(cfg)
	case cluster:
		uc = newCluster(cfg)
	default:
		return nil, nil, fmt.Errorf("redis: unknown mode %q", cfg.Mode)
	}

	if err := ping(uc, cfg.PingTimeout); err != nil {
		return nil, nil, fmt.Errorf("redis: ping failed (%s): %w", cfg.Mode, err)
	}

	cleanup := func() {
		if err := uc.Close(); err != nil {
			log.Error("failed to close redis client", "error", err)
		}
	}

	return &Client{uc}, cleanup, nil
}

func newSingle(cfg config.RedisConfig) redis.UniversalClient {
	return redis.NewClient(&redis.Options{
		Addr:            cfg.Addrs[0],
		Password:        cfg.Password,
		DB:              cfg.DB,
		PoolSize:        cfg.PoolSize,
		MinIdleConns:    cfg.MinIdleConns,
		MaxIdleConns:    cfg.MaxIdleConns,
		ConnMaxLifetime: cfg.ConnMaxLifetime,
		ConnMaxIdleTime: cfg.ConnMaxIdleTime,
		DialTimeout:     cfg.DialTimeout,
		ReadTimeout:     cfg.ReadTimeout,
		WriteTimeout:    cfg.WriteTimeout,
	})
}

func newSentinel(cfg config.RedisConfig) redis.UniversalClient {
	return redis.NewFailoverClient(&redis.FailoverOptions{
		MasterName:      cfg.MasterName,
		SentinelAddrs:   cfg.Addrs,
		Password:        cfg.Password,
		DB:              cfg.DB,
		PoolSize:        cfg.PoolSize,
		MinIdleConns:    cfg.MinIdleConns,
		ConnMaxLifetime: cfg.ConnMaxLifetime,
		DialTimeout:     cfg.DialTimeout,
		ReadTimeout:     cfg.ReadTimeout,
		WriteTimeout:    cfg.WriteTimeout,
	})
}

func newCluster(cfg config.RedisConfig) redis.UniversalClient {
	return redis.NewClusterClient(&redis.ClusterOptions{
		Addrs:           cfg.Addrs,
		Password:        cfg.Password,
		PoolSize:        cfg.PoolSize,
		MinIdleConns:    cfg.MinIdleConns,
		ConnMaxLifetime: cfg.ConnMaxLifetime,
		DialTimeout:     cfg.DialTimeout,
		ReadTimeout:     cfg.ReadTimeout,
		WriteTimeout:    cfg.WriteTimeout,
		// Route read-only commands to replicas
		RouteRandomly: true,
	})
}

func ping(uc redis.UniversalClient, timeout time.Duration) error {
	ctx, cancel := context.WithTimeout(context.Background(), timeout)
	defer cancel()
	return uc.Ping(ctx).Err()
}
