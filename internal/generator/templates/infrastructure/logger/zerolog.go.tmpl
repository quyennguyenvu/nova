package logger

import (
	"context"
	"io"
	"os"
	"strings"

	"github.com/rs/zerolog"
	"github.com/rs/zerolog/pkgerrors"
	"go.opentelemetry.io/otel/trace"

	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/pkg/observability"
)

var _ observability.Logger = (*Logger)(nil)

// Logger is an instance-based structured logger. Pass it through DI; never use a package global.
type Logger struct {
	zl zerolog.Logger
}

// New builds a Logger from Config. Writes to stdout.
func New(cfg *config.Config) *Logger {
	return NewWithWriter(&cfg.Log, os.Stdout)
}

// NewWithWriter is useful for tests.
func NewWithWriter(cfg *config.LogConfig, w io.Writer) *Logger {
	zerolog.ErrorStackMarshaler = pkgerrors.MarshalStack

	writer := w
	if strings.EqualFold(cfg.Format, "console") {
		writer = zerolog.ConsoleWriter{Out: w}
	}

	zl := zerolog.New(writer).
		Level(parseLevel(cfg.Level)).
		With().
		Timestamp().
		Logger()

	return &Logger{zl: zl}
}

// Nop returns a logger that discards all output. Safe default for ctx fallback.
func Nop() *Logger {
	return &Logger{zl: zerolog.Nop()}
}

// With returns a child logger with the key/value attached to every event.
func (l *Logger) With(key string, value any) *Logger {
	return &Logger{zl: l.zl.With().Interface(key, value).Logger()}
}

// WithFields returns a child logger with multiple fields attached.
func (l *Logger) WithFields(fields map[string]any) *Logger {
	ctx := l.zl.With()
	for k, v := range fields {
		ctx = ctx.Interface(k, v)
	}
	return &Logger{zl: ctx.Logger()}
}

// WithTrace attaches trace_id and span_id from the OTel span in ctx (if any).
func (l *Logger) WithTrace(ctx context.Context) *Logger {
	sc := trace.SpanContextFromContext(ctx)
	if !sc.IsValid() {
		return l
	}
	return &Logger{zl: l.zl.With().
		Str("trace_id", sc.TraceID().String()).
		Str("span_id", sc.SpanID().String()).
		Logger()}
}

func (l *Logger) Debug(msg string, kv ...any) { emit(l.zl.Debug(), msg, kv) }
func (l *Logger) Info(msg string, kv ...any)  { emit(l.zl.Info(), msg, kv) }
func (l *Logger) Warn(msg string, kv ...any)  { emit(l.zl.Warn(), msg, kv) }
func (l *Logger) Error(msg string, kv ...any) { emit(l.zl.Error(), msg, kv) }

// emit writes (key, value) pairs as structured fields. Odd-length input is ignored silently.
func emit(ev *zerolog.Event, msg string, kv []any) {
	if len(kv)%2 != 0 {
		kv = kv[:len(kv)-1]
	}
	for i := 0; i < len(kv); i += 2 {
		key, ok := kv[i].(string)
		if !ok {
			continue
		}
		ev = ev.Interface(key, kv[i+1])
	}
	ev.Msg(msg)
}

func parseLevel(s string) zerolog.Level {
	switch strings.ToLower(s) {
	case "debug":
		return zerolog.DebugLevel
	case "warn":
		return zerolog.WarnLevel
	case "error":
		return zerolog.ErrorLevel
	case "fatal":
		return zerolog.FatalLevel
	default:
		return zerolog.InfoLevel
	}
}
