package logger

import (
	"io"
	"os"
	"path/filepath"
	"strconv"
	"strings"

	"github.com/rs/zerolog"
	"github.com/rs/zerolog/pkgerrors"

	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/pkg/observability"
)

var _ observability.Logger = (*Logger)(nil)

// callerSkip counts the wrapper frames between a caller's logging call and the
// zerolog Event.Caller() invocation inside emit: emit → Logger.<Level> → the
// real call site. Without it every line would report zerolog.go (the wrapper)
// as the source.
const callerSkip = 2

// shortCaller renders the caller as "package/file:line" (the directory holding
// the file + the file), e.g. "redis/user_cache.go:52" — enough to locate the
// source without absolute-path noise.
func shortCaller(_ uintptr, file string, line int) string {
	return filepath.Base(filepath.Dir(file)) + "/" + filepath.Base(file) + ":" + strconv.Itoa(line)
}

// Logger is an instance-based structured logger. Pass it through DI; never use a package global.
type Logger struct {
	zl zerolog.Logger
}

// New builds a Logger from Config. Writes to stdout.
func New(cfg config.LogConfig) *Logger {
	return NewWithWriter(cfg, os.Stdout)
}

// NewWithWriter is useful for tests.
func NewWithWriter(cfg config.LogConfig, w io.Writer) *Logger {
	zerolog.ErrorStackMarshaler = pkgerrors.MarshalStack
	zerolog.CallerMarshalFunc = shortCaller

	writer := w
	if strings.EqualFold(cfg.Format, "console") {
		writer = zerolog.ConsoleWriter{Out: w}
	}

	zl := zerolog.New(writer).
		Level(parseLevel(cfg.Level)).
		With().
		Timestamp().
		Logger()

	return &Logger{zl: zl}
}

// Nop returns a logger that discards all output. Safe default for ctx fallback.
func Nop() *Logger {
	return &Logger{zl: zerolog.Nop()}
}

// With returns a child logger with the key/value attached to every event.
// Returns observability.Logger (not *Logger) so the type satisfies the
// interface — inner layers fork via logctx.From(ctx).With(...) without
// importing this package.
func (l *Logger) With(key string, value any) observability.Logger {
	return &Logger{zl: l.zl.With().Interface(key, value).Logger()}
}

func (l *Logger) Debug(msg string, kv ...any) { emit(l.zl.Debug(), msg, kv) }
func (l *Logger) Info(msg string, kv ...any)  { emit(l.zl.Info(), msg, kv) }
func (l *Logger) Warn(msg string, kv ...any)  { emit(l.zl.Warn(), msg, kv) }
func (l *Logger) Error(msg string, kv ...any) { emit(l.zl.Error(), msg, kv) }

// emit writes (key, value) pairs as structured fields. Odd-length input is
// ignored silently. Callers must not pass a key zerolog populates itself —
// "message" (the msg arg), "time", "level", or "caller" — doing so emits a
// duplicate field in the JSON line.
func emit(ev *zerolog.Event, msg string, kv []any) {
	ev = ev.Caller(callerSkip)
	if len(kv)%2 != 0 {
		kv = kv[:len(kv)-1]
	}
	for i := 0; i < len(kv); i += 2 {
		key, ok := kv[i].(string)
		if !ok {
			continue
		}
		ev = ev.Interface(key, kv[i+1])
	}
	ev.Msg(msg)
}

func parseLevel(s string) zerolog.Level {
	switch strings.ToLower(s) {
	case "debug":
		return zerolog.DebugLevel
	case "warn":
		return zerolog.WarnLevel
	case "error":
		return zerolog.ErrorLevel
	case "fatal":
		return zerolog.FatalLevel
	default:
		return zerolog.InfoLevel
	}
}
