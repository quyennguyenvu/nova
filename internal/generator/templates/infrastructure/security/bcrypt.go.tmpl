// Package security holds concrete implementations of the domain/security
// ports. Bcrypt is the default password hasher — swap implementations here
// without touching domain or usecase code.
package security

import (
	"golang.org/x/crypto/bcrypt"

	"{{.ModuleName}}/internal/domain/security"
	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/pkg/errors"
)

var _ security.PasswordHasher = (*BcryptHasher)(nil)

// BcryptHasher wraps the bcrypt cost parameter so deployments can dial work
// factor without touching callsites. Production deployments with CPU headroom
// should raise the cost (12–13) — see SecurityConfig.BcryptCost.
type BcryptHasher struct {
	cost int
}

// NewBcryptHasher reads the cost from config, clamping invalid values to
// bcrypt.DefaultCost (10). Cost must be in [bcrypt.MinCost, bcrypt.MaxCost].
func NewBcryptHasher(cfg *config.Config) *BcryptHasher {
	cost := cfg.Security.BcryptCost
	if cost < bcrypt.MinCost || cost > bcrypt.MaxCost {
		cost = bcrypt.DefaultCost
	}
	return &BcryptHasher{cost: cost}
}

func (h *BcryptHasher) Hash(plain string) (string, error) {
	out, err := bcrypt.GenerateFromPassword([]byte(plain), h.cost)
	if err != nil {
		return "", errors.Wrap(err, "bcrypt hash")
	}
	return string(out), nil
}

func (h *BcryptHasher) Verify(hash, plain string) error {
	if err := bcrypt.CompareHashAndPassword([]byte(hash), []byte(plain)); err != nil {
		return errors.Wrap(errors.ErrUnauthorized, "bcrypt verify")
	}
	return nil
}
