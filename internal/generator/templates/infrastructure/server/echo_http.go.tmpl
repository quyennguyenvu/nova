package server

import (
	"context"
	"errors"
	"fmt"
	"net/http"

	"github.com/labstack/echo/v4"

	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/infrastructure/logger"
)

// HTTPServer is the lifecycle wrapper around a pre-built echo instance. The
// instance itself (middleware, routes, healthz) is built in transport/http.NewApp.
type HTTPServer struct {
	echo   *echo.Echo
	addr   string
	cfg    config.HTTPConfig
	logger *logger.Logger
}

// NewHTTPServer wraps echo for graceful shutdown. The shutdown context is
// rooted at context.Background(), not the request-lifecycle ctx — by the
// time cleanup runs the parent ctx is already SIGINT-cancelled.
func NewHTTPServer(
	_ context.Context,
	cfg config.HTTPConfig,
	log *logger.Logger,
	e *echo.Echo,
) (*HTTPServer, func(), error) {
	addr := fmt.Sprintf(":%s", cfg.Port)
	s := &HTTPServer{echo: e, addr: addr, cfg: cfg, logger: log}

	cleanup := func() {
		cleanupCtx, cancel := context.WithTimeout(context.Background(), cfg.ShutdownTimeout)
		defer cancel()

		log.Info("shutting down HTTP server", "addr", addr)
		if err := e.Shutdown(cleanupCtx); err != nil {
			log.Error("graceful shutdown failed", "err", err.Error())
			return
		}
		log.Info("server stopped cleanly")
	}

	return s, cleanup, nil
}

func (s *HTTPServer) Start() error {
	s.logger.Info("starting HTTP server", "addr", s.addr)
	if err := s.echo.Start(s.addr); err != nil && !errors.Is(err, http.ErrServerClosed) {
		return err
	}
	return nil
}
