package server

import (
	"context"
	"log/slog"
	"os"
	"os/signal"
	"syscall"
	"time"

{{- if eq .HTTPFramework "fiber"}}
	"github.com/gofiber/fiber/v2"
{{- end}}
{{- if eq .HTTPFramework "gin"}}
	"fmt"
	"net/http"
	"github.com/gin-gonic/gin"
{{- end}}
{{- if eq .HTTPFramework "chi"}}
	"fmt"
	"net/http"
	"github.com/go-chi/chi/v5"
{{- end}}
{{- if eq .HTTPFramework "echo"}}
	"fmt"
	"github.com/labstack/echo/v4"
{{- end}}

	"{{.ModuleName}}/internal/infrastructure/config"
)

// HTTPServer wraps the HTTP server with graceful shutdown.
type HTTPServer struct {
{{- if eq .HTTPFramework "fiber"}}
	app    *fiber.App
{{- end}}
{{- if eq .HTTPFramework "gin"}}
	engine *gin.Engine
	server *http.Server
{{- end}}
{{- if eq .HTTPFramework "chi"}}
	router chi.Router
	server *http.Server
{{- end}}
{{- if eq .HTTPFramework "echo"}}
	echo *echo.Echo
{{- end}}
	cfg    *config.Config
	logger *slog.Logger
}

{{- if eq .HTTPFramework "fiber"}}

// NewHTTPServer creates a new Fiber HTTP server.
func NewHTTPServer(cfg *config.Config, logger *slog.Logger) *HTTPServer {
	app := fiber.New(fiber.Config{
		ReadTimeout:  time.Duration(cfg.Server.ReadTimeout) * time.Second,
		WriteTimeout: time.Duration(cfg.Server.WriteTimeout) * time.Second,
	})

	return &HTTPServer{
		app:    app,
		cfg:    cfg,
		logger: logger,
	}
}

// App returns the underlying Fiber app for route registration.
func (s *HTTPServer) App() *fiber.App {
	return s.app
}

// Start starts the HTTP server and blocks until shutdown.
func (s *HTTPServer) Start() error {
	go func() {
		s.logger.Info("starting HTTP server", "port", s.cfg.Server.Port)
		if err := s.app.Listen(":" + s.cfg.Server.Port); err != nil {
			s.logger.Error("server error", "error", err)
		}
	}()

	quit := make(chan os.Signal, 1)
	signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)
	<-quit

	s.logger.Info("shutting down server...")

	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	return s.app.ShutdownWithContext(ctx)
}

{{- end}}

{{- if eq .HTTPFramework "gin"}}

func NewHTTPServer(cfg *config.Config, logger *slog.Logger) *HTTPServer {
	gin.SetMode(gin.ReleaseMode)

	engine := gin.New()

	srv := &http.Server{
		Addr:         ":" + cfg.Server.Port,
		Handler:      engine,
		ReadTimeout:  time.Duration(cfg.Server.ReadTimeout) * time.Second,
		WriteTimeout: time.Duration(cfg.Server.WriteTimeout) * time.Second,
	}

	return &HTTPServer{
		engine: engine,
		server: srv,
		cfg:    cfg,
		logger: logger,
	}
}

func (s *HTTPServer) Engine() *gin.Engine {
	return s.engine
}

func (s *HTTPServer) Start() error {
	go func() {
		s.logger.Info("starting HTTP server", "port", s.cfg.Server.Port)
		if err := s.server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			s.logger.Error("server error", "error", err)
		}
	}()

	quit := make(chan os.Signal, 1)
	signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)
	<-quit

	s.logger.Info("shutting down server...")

	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	return s.server.Shutdown(ctx)
}

{{- end}}

{{- if eq .HTTPFramework "chi"}}

func NewHTTPServer(cfg *config.Config, logger *slog.Logger) *HTTPServer {
	router := chi.NewRouter()

	srv := &http.Server{
		Addr:         ":" + cfg.Server.Port,
		Handler:      router,
		ReadTimeout:  time.Duration(cfg.Server.ReadTimeout) * time.Second,
		WriteTimeout: time.Duration(cfg.Server.WriteTimeout) * time.Second,
	}

	return &HTTPServer{
		router: router,
		server: srv,
		cfg:    cfg,
		logger: logger,
	}
}

func (s *HTTPServer) Router() chi.Router {
	return s.router
}

func (s *HTTPServer) Start() error {
	go func() {
		s.logger.Info("starting HTTP server", "port", s.cfg.Server.Port)
		if err := s.server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			s.logger.Error("server error", "error", err)
		}
	}()

	quit := make(chan os.Signal, 1)
	signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)
	<-quit

	s.logger.Info("shutting down server...")

	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	return s.server.Shutdown(ctx)
}

{{- end}}

{{- if eq .HTTPFramework "echo"}}

func NewHTTPServer(cfg *config.Config, logger *slog.Logger) *HTTPServer {
	e := echo.New()
	e.HideBanner = true

	return &HTTPServer{
		echo:   e,
		cfg:    cfg,
		logger: logger,
	}
}

func (s *HTTPServer) Echo() *echo.Echo {
	return s.echo
}

func (s *HTTPServer) Start() error {
	go func() {
		addr := fmt.Sprintf(":%s", s.cfg.Server.Port)
		s.logger.Info("starting HTTP server", "port", s.cfg.Server.Port)
		if err := s.echo.Start(addr); err != nil {
			s.logger.Error("server error", "error", err)
		}
	}()

	quit := make(chan os.Signal, 1)
	signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)
	<-quit

	s.logger.Info("shutting down server...")

	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	return s.echo.Shutdown(ctx)
}

{{- end}}
