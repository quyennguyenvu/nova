package server

import (
	"log/slog"
	"net"

	"google.golang.org/grpc"

	"{{.ModuleName}}/internal/infrastructure/config"
)

// GRPCServer wraps the gRPC server.
type GRPCServer struct {
	server *grpc.Server
	cfg    *config.Config
	logger *slog.Logger
}

// NewGRPCServer creates a new gRPC server.
func NewGRPCServer(cfg *config.Config, logger *slog.Logger) *GRPCServer {
	server := grpc.NewServer()

	return &GRPCServer{
		server: server,
		cfg:    cfg,
		logger: logger,
	}
}

// Server returns the underlying gRPC server for service registration.
func (s *GRPCServer) Server() *grpc.Server {
	return s.server
}

// Start starts the gRPC server.
func (s *GRPCServer) Start(port string) error {
	lis, err := net.Listen("tcp", ":"+port)
	if err != nil {
		return err
	}

	s.logger.Info("starting gRPC server", "port", port)
	return s.server.Serve(lis)
}

// Stop gracefully stops the gRPC server.
func (s *GRPCServer) Stop() {
	s.logger.Info("stopping gRPC server...")
	s.server.GracefulStop()
}
