package server

import (
	"context"
	"net"

	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/infrastructure/logger"
	transportgrpc "{{.ModuleName}}/internal/transport/grpc"
)

// GRPCServer owns the listener and the graceful stop of the transport's
// server, the way HTTPServer wraps the router.
type GRPCServer struct {
	srv    *transportgrpc.Server
	addr   string
	logger *logger.Logger
}

// NewGRPCServer wires graceful shutdown around srv. The shutdown context is
// rooted at context.Background() so the timeout isn't collapsed by an
// already-cancelled parent.
func NewGRPCServer(
	_ context.Context,
	cfg config.GRPCConfig,
	log *logger.Logger,
	srv *transportgrpc.Server,
) (*GRPCServer, func(), error) {
	addr := ":" + cfg.Port
	s := &GRPCServer{srv: srv, addr: addr, logger: log}

	cleanup := func() {
		cleanupCtx, cancel := context.WithTimeout(context.Background(), cfg.ShutdownTimeout)
		defer cancel()

		log.Info("shutting down gRPC server", "addr", addr)
		// NOT_SERVING first; a balancer that polls health only sees it when
		// the platform delays the stop signal (a Kubernetes preStop sleep).
		srv.Health.Shutdown()

		done := make(chan struct{})
		go func() {
			srv.GRPC.GracefulStop()
			close(done)
		}()

		select {
		case <-done:
			log.Info("gRPC server stopped cleanly")
		case <-cleanupCtx.Done():
			log.Warn("graceful shutdown timed out, forcing stop")
			srv.GRPC.Stop()
		}
	}

	return s, cleanup, nil
}

// Start binds the listener and serves until the server is stopped.
func (s *GRPCServer) Start() error {
	lis, err := (&net.ListenConfig{}).Listen(context.Background(), "tcp", s.addr)
	if err != nil {
		return err
	}
	s.logger.Info("starting gRPC server", "addr", s.addr)
	return s.srv.GRPC.Serve(lis)
}
