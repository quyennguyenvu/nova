app_name: "{{.ProjectName}}"
app_version: "0.1.0"

log:
  level: "info" # debug | info | warn | error | fatal
  format: "json" # json | console

tracing:
  # Set OTEL_EXPORTER_OTLP_ENDPOINT to a collector address (e.g. "otel-collector:4317")
  # to enable export; empty disables tracing without breaking the app.
  endpoint: ""
  insecure: false
  sample_ratio: 0.1

jwt:
  # JWT_SECRET MUST be set in env (never commit it). Issuer and audience scope
  # the tokens this service accepts on Auth — must match what it signs at login.
  issuer: "{{.ProjectName}}"
  audience: "{{.ProjectName}}"
  access_token_ttl: 1h

security:
  # bcrypt work factor. 10 is bcrypt.DefaultCost; raise to 12-13 in
  # production when CPU headroom allows. Clamped to [4, 31] at construction.
  bcrypt_cost: 10

{{- if .HasHTTP}}

http:
  port: "8080"
  read_timeout: 30s
  write_timeout: 30s
  read_buffer_size: 8192
  body_limit: 10485760 # 10 MB
  shutdown_timeout: 10s
  cors:
    # Production deployments MUST set CORS_ALLOW_ORIGINS (comma-separated env
    # var) to enumerate every allowed origin. Empty here means EVERY
    # cross-origin request is rejected — browsers will see no
    # Access-Control-Allow-Origin header and reject preflights. Never use "*".
    # development.yaml ships localhost defaults so dev tooling works without
    # editing this file.
    allow_origins: []
    allow_methods: ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    allow_headers: ["Origin", "Content-Type", "Accept", "Authorization", "X-Request-ID"]
  login_rate_limit:
    # 5 requests per minute, burst 5 — closes brute-force without locking
    # out legitimate retries. Tune per deployment via env vars.
    rps: 0.0833
    burst: 5
{{- end}}

{{- if .HasGRPC}}

grpc:
  port: "9090"
  shutdown_timeout: 10s
{{- end}}

{{- if .HasCron}}

cron:
  spec: "0 * * * *" # every hour
{{- end}}

{{- if .HasDatabase}}

database:
{{- if eq .Database "postgres"}}
  host: "localhost"
  port: 5432
  name: "{{.ProjectName}}"
  max_conns: 25
  min_conns: 5
  max_conn_lifetime: 5m
  max_conn_idle_time: 1m
  connect_timeout: 10s
{{- end}}
{{- if eq .Database "mysql"}}
  host: "localhost"
  port: 3306
  name: "{{.ProjectName}}"
  max_open_conns: 25
  max_idle_conns: 5
{{- end}}
{{- end}}

{{- if .HasRedis}}

redis:
  mode: "single" # single | sentinel | cluster
  addrs:
    - "localhost:6379"
  db: 0
  pool_size: 10
  min_idle_conns: 2
  max_idle_conns: 5
  conn_max_lifetime: 30s
  conn_max_idle_time: 5s
  dial_timeout: 5s
  read_timeout: 3s
  write_timeout: 3s
  ping_timeout: 5s
{{- end}}

{{- if eq .MessageQueue "kafka"}}

kafka:
  brokers:
    - "localhost:9092"
  producer_retry_max: 3
  # consumer_group_id is required in worker mode. Group membership controls
  # how partitions are distributed across replicas.
  consumer_group_id: "{{.ProjectName}}-worker"
  user_created_topic: "user.created"
{{- end}}

{{- if eq .MessageQueue "rabbitmq"}}

rabbitmq:
  url: "amqp://guest:guest@localhost:5672/" # override via RABBITMQ_URL in production
  exchange: "{{.ProjectName}}.events"
  user_created_queue: "{{.ProjectName}}.user.created"
{{- end}}
