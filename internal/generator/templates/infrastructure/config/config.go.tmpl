package config

import (
	"bytes"
	"embed"
	"fmt"
	"io/fs"
{{- if .HasHTTP}}
	"net"
	"strings"
{{- end}}
	"os"
{{- if or .HasHTTP .HasGRPC .HasDatabase .HasRedis .HasElasticsearch .HasMessageQueue}}
	"time"
{{- end}}

	"github.com/ilyakaznacheev/cleanenv"
	"github.com/joho/godotenv"

	"{{.ModuleName}}/pkg/errors"
)

//go:embed *.{{.ConfigFormat}}
var configFS embed.FS

// Config holds all application configuration.
//
// Defaults live outside this struct:
//   - internal/infrastructure/config/base.yaml — operational tuning
//     (<APP_ENV>.yaml is layered on top when APP_ENV is "development" or "production")
//   - .env.example — secrets and per-deployment endpoints
//
// At runtime every field can be overridden by its env var.
type Config struct {
	AppName    string         `{{.ConfigFormat}}:"app_name"    env:"APP_NAME"`
	AppVersion string         `{{.ConfigFormat}}:"app_version" env:"APP_VERSION"`
	AppEnv     string         `{{.ConfigFormat}}:"app_env"     env:"APP_ENV"`
	// ShutdownTimeout bounds the whole cleanup chain (fx's Stop budget); keep
	// it above the server's shutdown_timeout plus the dependency closes.
	ShutdownTimeout time.Duration `{{.ConfigFormat}}:"shutdown_timeout" env:"APP_SHUTDOWN_TIMEOUT"`
	Log        LogConfig      `{{.ConfigFormat}}:"log"`
	Tracing    TracingConfig  `{{.ConfigFormat}}:"tracing"`
	JWT        JWTConfig      `{{.ConfigFormat}}:"jwt"`
	Security   SecurityConfig `{{.ConfigFormat}}:"security"`
{{- if .HasHTTP}}
	HTTP       HTTPConfig     `{{.ConfigFormat}}:"http"`
{{- end}}
{{- if .HasGRPC}}
	GRPC       GRPCConfig     `{{.ConfigFormat}}:"grpc"`
{{- end}}
{{- if .HasCron}}
	Cron       CronConfig     `{{.ConfigFormat}}:"cron"`
{{- end}}
{{- if .HasDatabase}}
	Database   DatabaseConfig `{{.ConfigFormat}}:"database"`
{{- end}}
{{- if .HasRedis}}
	Redis      RedisConfig    `{{.ConfigFormat}}:"redis"`
{{- end}}
{{- if .HasElasticsearch}}
	Elasticsearch ElasticsearchConfig `{{.ConfigFormat}}:"elasticsearch"`
{{- end}}
{{- if eq .MessageQueue "kafka"}}
	Kafka      KafkaConfig    `{{.ConfigFormat}}:"kafka"`
{{- end}}
{{- if eq .MessageQueue "rabbitmq"}}
	RabbitMQ   RabbitMQConfig `{{.ConfigFormat}}:"rabbitmq"`
{{- end}}
{{- if .HasWorker}}
	Worker     WorkerConfig   `{{.ConfigFormat}}:"worker"`
{{- end}}
}

// LogConfig holds logging configuration.
type LogConfig struct {
	Level  string `{{.ConfigFormat}}:"level"  env:"LOG_LEVEL"`
	Format string `{{.ConfigFormat}}:"format" env:"LOG_FORMAT"`
}

// TracingConfig drives OpenTelemetry. Endpoint empty → no-op tracer.
type TracingConfig struct {
	Endpoint    string  `{{.ConfigFormat}}:"endpoint"     env:"OTEL_EXPORTER_OTLP_ENDPOINT"`
	Insecure    bool    `{{.ConfigFormat}}:"insecure"     env:"OTEL_EXPORTER_OTLP_INSECURE"`
	SampleRatio float64 `{{.ConfigFormat}}:"sample_ratio" env:"OTEL_SAMPLE_RATIO"`
}

// SecurityConfig tunes cryptographic primitives. BcryptCost is clamped to
// [bcrypt.MinCost, bcrypt.MaxCost] in NewBcryptHasher; values outside the
// range fall back to bcrypt.DefaultCost (10). Raise to 12–13 in production
// for stronger password hashing if CPU headroom allows.
type SecurityConfig struct {
	BcryptCost int `{{.ConfigFormat}}:"bcrypt_cost" env:"BCRYPT_COST"`
}

// JWTConfig drives signing (login) and verification (Auth middleware) via
// RS256. Keys are base64-encoded PEM so they survive single-line env vars.
// PublicKey is required on every service (verification). PrivateKey is set
// only on the token-issuing service (signing); downstream services leave it
// empty and run verify-only. Rotate by publishing the new public key to the
// fleet before the issuer starts signing with the new private key.
type JWTConfig struct {
	PrivateKey     string        `env:"JWT_PRIVATE_KEY"`
	PublicKey      string        `env:"JWT_PUBLIC_KEY"`
	Issuer         string        `{{.ConfigFormat}}:"issuer"           env:"JWT_ISSUER"`
	Audience       string        `{{.ConfigFormat}}:"audience"         env:"JWT_AUDIENCE"`
	AccessTokenTTL time.Duration `{{.ConfigFormat}}:"access_token_ttl" env:"JWT_ACCESS_TOKEN_TTL"`
}
{{- if .HasHTTP}}

// HTTPConfig holds HTTP server configuration.
//
// RequestTimeout is the deadline put on every request's context
// (middleware.Timeout); keep it below WriteTimeout so a stalled dependency
// fails the request in the envelope before the socket is closed.
// TrustedProxies lists the reverse proxies (CIDR or IP) whose X-Forwarded-For
// is believed; with none configured the TCP peer is the client and the header
// is ignored, so a client cannot spoof its address to the login limiter or
// the access log.
type HTTPConfig struct {
	Port            string               `{{.ConfigFormat}}:"port"             env:"SERVER_PORT"`
	ReadTimeout     time.Duration        `{{.ConfigFormat}}:"read_timeout"     env:"SERVER_READ_TIMEOUT"`
	WriteTimeout    time.Duration        `{{.ConfigFormat}}:"write_timeout"    env:"SERVER_WRITE_TIMEOUT"`
	RequestTimeout  time.Duration        `{{.ConfigFormat}}:"request_timeout"  env:"SERVER_REQUEST_TIMEOUT"`
	ReadBufferSize  int                  `{{.ConfigFormat}}:"read_buffer_size" env:"SERVER_READ_BUFFER_SIZE"`
	BodyLimit       int                  `{{.ConfigFormat}}:"body_limit"       env:"SERVER_BODY_LIMIT"`
	ShutdownTimeout time.Duration        `{{.ConfigFormat}}:"shutdown_timeout" env:"SERVER_SHUTDOWN_TIMEOUT"`
	TrustedProxies  []string             `{{.ConfigFormat}}:"trusted_proxies"  env:"SERVER_TRUSTED_PROXIES" env-separator:","`
	CORS            CORSConfig           `{{.ConfigFormat}}:"cors"`
	LoginRateLimit  LoginRateLimitConfig `{{.ConfigFormat}}:"login_rate_limit"`
}

// TrustedProxyNets parses TrustedProxies. A bare IP is treated as a /32 (or
// /128) network. Load rejects invalid entries, so later callers may ignore the
// error.
func (c HTTPConfig) TrustedProxyNets() ([]*net.IPNet, error) {
	nets := make([]*net.IPNet, 0, len(c.TrustedProxies))
	for _, raw := range c.TrustedProxies {
		entry := strings.TrimSpace(raw)
		if entry == "" {
			continue
		}
		if !strings.Contains(entry, "/") {
			ip := net.ParseIP(entry)
			if ip == nil {
				return nil, fmt.Errorf("trusted proxy %q is not an IP address or CIDR", raw)
			}
			bits := 32
			if ip.To4() == nil {
				bits = 128
			}
			entry = fmt.Sprintf("%s/%d", ip, bits)
		}
		_, n, err := net.ParseCIDR(entry)
		if err != nil {
			return nil, fmt.Errorf("trusted proxy %q: %w", raw, err)
		}
		nets = append(nets, n)
	}
	return nets, nil
}

// LoginRateLimitConfig throttles POST /login by remote IP. The limiter is a
// token bucket with `RPS` refill rate (requests / second) and `Burst` peak
// capacity. Zero or negative values fall back to a 5-per-minute default so
// the brute-force surface is closed even when the YAML is misconfigured.
type LoginRateLimitConfig struct {
	RPS   float64 `{{.ConfigFormat}}:"rps"   env:"LOGIN_RATE_LIMIT_RPS"`
	Burst int     `{{.ConfigFormat}}:"burst" env:"LOGIN_RATE_LIMIT_BURST"`
}

// CORSConfig is driven entirely from configuration — scaffolded code must not
// default to "*". Each deployment enumerates its allowed origins explicitly.
type CORSConfig struct {
	AllowOrigins []string `{{.ConfigFormat}}:"allow_origins" env:"CORS_ALLOW_ORIGINS" env-separator:","`
	AllowMethods []string `{{.ConfigFormat}}:"allow_methods" env:"CORS_ALLOW_METHODS" env-separator:","`
	AllowHeaders []string `{{.ConfigFormat}}:"allow_headers" env:"CORS_ALLOW_HEADERS" env-separator:","`
}
{{- end}}
{{- if .HasGRPC}}

// GRPCConfig holds gRPC server configuration.
type GRPCConfig struct {
	Port            string        `{{.ConfigFormat}}:"port"             env:"GRPC_PORT"`
	ShutdownTimeout time.Duration `{{.ConfigFormat}}:"shutdown_timeout" env:"GRPC_SHUTDOWN_TIMEOUT"`
}
{{- end}}
{{- if .HasCron}}

// CronConfig holds cron job configuration.
type CronConfig struct {
	Spec string `{{.ConfigFormat}}:"spec" env:"CRON_SPEC"`
}
{{- end}}
{{- if .HasDatabase}}

// DatabaseConfig holds database connection configuration.
type DatabaseConfig struct {
{{- if eq .Database "postgres"}}
	Host     string `{{.ConfigFormat}}:"host" env:"DB_HOST"`
	Port     int    `{{.ConfigFormat}}:"port" env:"DB_PORT"`
	Name     string `{{.ConfigFormat}}:"name" env:"DB_NAME"`
	User     string `env:"DB_USER"`
	Password string `env:"DB_PASSWORD"`
	SSLMode  string `{{.ConfigFormat}}:"ssl_mode" env:"DB_SSL_MODE"`

	// Pool / connection tuning.
	MaxConns        int32         `{{.ConfigFormat}}:"max_conns"          env:"DB_MAX_CONNS"`
	MinConns        int32         `{{.ConfigFormat}}:"min_conns"          env:"DB_MIN_CONNS"`
	MaxConnLifetime time.Duration `{{.ConfigFormat}}:"max_conn_lifetime"  env:"DB_MAX_CONN_LIFETIME"`
	MaxConnIdleTime time.Duration `{{.ConfigFormat}}:"max_conn_idle_time" env:"DB_MAX_CONN_IDLE_TIME"`
	ConnectTimeout  time.Duration `{{.ConfigFormat}}:"connect_timeout"    env:"DB_CONNECT_TIMEOUT"`
{{- end}}
{{- if eq .Database "mysql"}}
	Host     string `{{.ConfigFormat}}:"host" env:"DB_HOST"`
	Port     int    `{{.ConfigFormat}}:"port" env:"DB_PORT"`
	Name     string `{{.ConfigFormat}}:"name" env:"DB_NAME"`
	User     string `env:"DB_USER"`
	Password string `env:"DB_PASSWORD"`
	// TLS is the driver's tls mode: false | true | skip-verify | preferred.
	// "skip-verify" encrypts without authenticating the server (the
	// counterpart of Postgres sslmode=require); register a tls.Config with
	// the CA and use "true" to also authenticate it.
	TLS string `{{.ConfigFormat}}:"tls" env:"DB_TLS"`

	// Pool / connection tuning. ConnectTimeout bounds both the dial and the
	// startup ping.
	MaxOpenConns    int           `{{.ConfigFormat}}:"max_open_conns"     env:"DB_MAX_OPEN_CONNS"`
	MaxIdleConns    int           `{{.ConfigFormat}}:"max_idle_conns"     env:"DB_MAX_IDLE_CONNS"`
	MaxConnLifetime time.Duration `{{.ConfigFormat}}:"max_conn_lifetime"  env:"DB_MAX_CONN_LIFETIME"`
	MaxConnIdleTime time.Duration `{{.ConfigFormat}}:"max_conn_idle_time" env:"DB_MAX_CONN_IDLE_TIME"`
	ConnectTimeout  time.Duration `{{.ConfigFormat}}:"connect_timeout"    env:"DB_CONNECT_TIMEOUT"`
{{- end}}
}
{{- end}}
{{- if .HasRedis}}

// RedisConfig holds Redis cache configuration.
type RedisConfig struct {
	Mode     string   `{{.ConfigFormat}}:"mode"  env:"REDIS_MODE"`
	Addrs    []string `{{.ConfigFormat}}:"addrs" env:"REDIS_ADDRS" env-separator:","`
	DB       int      `{{.ConfigFormat}}:"db"    env:"REDIS_DB"` // ignored in cluster mode
	Password string   `env:"REDIS_PASSWORD"`

	// Sentinel-specific.
	MasterName string `{{.ConfigFormat}}:"master_name" env:"REDIS_MASTER_NAME"`

	// Pool / connection tuning.
	PoolSize        int           `{{.ConfigFormat}}:"pool_size"          env:"REDIS_POOL_SIZE"`
	MinIdleConns    int           `{{.ConfigFormat}}:"min_idle_conns"     env:"REDIS_MIN_IDLE_CONNS"`
	MaxIdleConns    int           `{{.ConfigFormat}}:"max_idle_conns"     env:"REDIS_MAX_IDLE_CONNS"`
	ConnMaxLifetime time.Duration `{{.ConfigFormat}}:"conn_max_lifetime"  env:"REDIS_CONN_MAX_LIFETIME"`
	ConnMaxIdleTime time.Duration `{{.ConfigFormat}}:"conn_max_idle_time" env:"REDIS_CONN_MAX_IDLE_TIME"`

	// Timeouts.
	DialTimeout  time.Duration `{{.ConfigFormat}}:"dial_timeout"  env:"REDIS_DIAL_TIMEOUT"`
	ReadTimeout  time.Duration `{{.ConfigFormat}}:"read_timeout"  env:"REDIS_READ_TIMEOUT"`
	WriteTimeout time.Duration `{{.ConfigFormat}}:"write_timeout" env:"REDIS_WRITE_TIMEOUT"`
	PingTimeout  time.Duration `{{.ConfigFormat}}:"ping_timeout"  env:"REDIS_PING_TIMEOUT"`
}
{{- end}}
{{- if .HasElasticsearch}}

// ElasticsearchConfig holds Elasticsearch connection configuration.
//
// Username/Password (basic auth) and APIKey are alternatives — set whichever
// your cluster uses; both empty targets an unsecured local node.
type ElasticsearchConfig struct {
	Addresses []string `{{.ConfigFormat}}:"addresses" env:"ELASTICSEARCH_ADDRESSES" env-separator:","`
	Username  string   `env:"ELASTICSEARCH_USERNAME"`
	Password  string   `env:"ELASTICSEARCH_PASSWORD"`
	APIKey    string   `env:"ELASTICSEARCH_API_KEY"`

	// Connection tuning.
	MaxRetries  int           `{{.ConfigFormat}}:"max_retries"  env:"ELASTICSEARCH_MAX_RETRIES"`
	PingTimeout time.Duration `{{.ConfigFormat}}:"ping_timeout" env:"ELASTICSEARCH_PING_TIMEOUT"`
}
{{- end}}
{{- if eq .MessageQueue "kafka"}}

// KafkaConfig holds Kafka configuration.
//
// ConsumerGroupID is only read in worker mode (Transport=worker); HTTP-only
// deployments can leave it empty. Topic names are wire contracts owned by the
// handlers and the publisher, not configuration.
type KafkaConfig struct {
	Brokers          []string `{{.ConfigFormat}}:"brokers"            env:"KAFKA_BROKERS" env-separator:","`
	ProducerRetryMax int      `{{.ConfigFormat}}:"producer_retry_max" env:"KAFKA_PRODUCER_RETRY_MAX"`
	ConsumerGroupID  string   `{{.ConfigFormat}}:"consumer_group_id"  env:"KAFKA_CONSUMER_GROUP_ID"`
}
{{- end}}
{{- if eq .MessageQueue "rabbitmq"}}

// RabbitMQConfig holds RabbitMQ configuration. Exchange is shared by the
// publisher and the worker, so a message published here is routable to the
// queue declared there; Queue and Prefetch are only read in worker mode.
type RabbitMQConfig struct {
	URL      string `{{.ConfigFormat}}:"url"      env:"RABBITMQ_URL"`
	Exchange string `{{.ConfigFormat}}:"exchange" env:"RABBITMQ_EXCHANGE"`
	Queue    string `{{.ConfigFormat}}:"queue"    env:"RABBITMQ_QUEUE"`
	Prefetch int    `{{.ConfigFormat}}:"prefetch" env:"RABBITMQ_PREFETCH"`
}
{{- end}}
{{- if .HasWorker}}

// WorkerConfig bounds how the consumer worker handles one message; see
// transport/worker.Policy for what each field means.
type WorkerConfig struct {
	HandlerTimeout time.Duration `{{.ConfigFormat}}:"handler_timeout" env:"WORKER_HANDLER_TIMEOUT"`
	MaxAttempts    int           `{{.ConfigFormat}}:"max_attempts"    env:"WORKER_MAX_ATTEMPTS"`
	RetryBackoff   time.Duration `{{.ConfigFormat}}:"retry_backoff"   env:"WORKER_RETRY_BACKOFF"`
}
{{- end}}

// Load resolves configuration from the embedded base.{{.ConfigFormat}}, overlays the
// per-APP_ENV file, and applies env-var overrides (a ./.env file first, then
// the real environment). Embedding removes the runtime dependency on cwd for
// the YAML — the binary is self-contained.
func Load() (*Config, error) {
	if err := loadDotEnv(); err != nil {
		return nil, errors.Wrap(err, "config .env")
	}

	var cfg Config
	if err := readEmbedded("base.{{.ConfigFormat}}", &cfg); err != nil {
		return nil, errors.Wrap(err, "config base")
	}

	switch env := os.Getenv("APP_ENV"); env {
	case "", EnvLocal:
	case EnvDev, EnvProd:
		envFile := env + ".{{.ConfigFormat}}"
		if err := readEmbedded(envFile, &cfg); err != nil {
			return nil, errors.Wrapf(err, "config env %s", envFile)
		}
	default:
		// A typo must not silently run with base defaults (ssl_mode: disable,
		// debug-friendly limits) in what the operator believes is production.
		return nil, fmt.Errorf("unknown APP_ENV %q (valid: %s, %s, %s)", env, EnvLocal, EnvDev, EnvProd)
	}

	if err := cleanenv.ReadEnv(&cfg); err != nil {
		return nil, errors.Wrap(err, "config env vars")
	}
{{- if .HasDatabase}}
	// Without DB_USER the driver falls back to the OS user, which looks like a
	// permissions bug on the database; fail with the real cause instead.
	if cfg.Database.User == "" {
		return nil, errors.New("config database.user (DB_USER) is required")
	}
{{- end}}
{{- if .HasHTTP}}
	if _, err := cfg.HTTP.TrustedProxyNets(); err != nil {
		return nil, errors.Wrap(err, "config http.trusted_proxies")
	}
{{- end}}

	return &cfg, nil
}

// loadDotEnv reads ./.env into the environment for host runs, so
// `cp .env.example .env && go run main.go api` works. Variables already set
// win (godotenv.Load never overrides), and a missing file is not an error:
// containers inject their environment and ship no .env.
func loadDotEnv() error {
	err := godotenv.Load()
	if err != nil && !errors.Is(err, fs.ErrNotExist) {
		return err
	}
	return nil
}

func readEmbedded(name string, cfg *Config) error {
	data, err := configFS.ReadFile(name)
	if err != nil {
		return fmt.Errorf("read %s: %w", name, err)
	}
	return cleanenv.ParseYAML(bytes.NewReader(data), cfg)
}

// Summary returns the loaded configuration as log fields with every secret
// omitted, so the first log line of a process shows what it actually runs
// with. Only fields that exist in this build are included.
func (c *Config) Summary() []any {
	fields := []any{
		"log_level", c.Log.Level,
		"log_format", c.Log.Format,
		"tracing_endpoint", c.Tracing.Endpoint,
		"tracing_sample_ratio", c.Tracing.SampleRatio,
	}
{{- if .HasHTTP}}
	fields = append(fields, "http_port", c.HTTP.Port, "http_trusted_proxies", c.HTTP.TrustedProxies)
{{- end}}
{{- if .HasGRPC}}
	fields = append(fields, "grpc_port", c.GRPC.Port)
{{- end}}
{{- if .HasDatabase}}
	fields = append(fields, "db_host", c.Database.Host, "db_port", c.Database.Port, "db_name", c.Database.Name)
{{- end}}
{{- if eq .Database "postgres"}}
	fields = append(fields, "db_ssl_mode", c.Database.SSLMode)
{{- end}}
{{- if eq .Database "mysql"}}
	fields = append(fields, "db_tls", c.Database.TLS)
{{- end}}
{{- if .HasRedis}}
	fields = append(fields, "redis_mode", c.Redis.Mode, "redis_addrs", c.Redis.Addrs)
{{- end}}
{{- if eq .MessageQueue "kafka"}}
	fields = append(fields, "kafka_brokers", c.Kafka.Brokers, "kafka_consumer_group", c.Kafka.ConsumerGroupID)
{{- end}}
{{- if eq .MessageQueue "rabbitmq"}}
	// The RabbitMQ URL carries credentials and is never logged.
	fields = append(fields, "rabbitmq_exchange", c.RabbitMQ.Exchange, "rabbitmq_queue", c.RabbitMQ.Queue)
{{- end}}
{{- if .HasWorker}}
	fields = append(fields,
		"worker_max_attempts", c.Worker.MaxAttempts,
		"worker_handler_timeout", c.Worker.HandlerTimeout,
	)
{{- end}}
	return fields
}
