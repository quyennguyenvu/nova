log:
  level: "info" # access and lifecycle lines stay visible; raise only if volume forces it
  format: "json"

{{- if .HasHTTP}}

http:
  read_timeout: 15s
  write_timeout: 15s
  request_timeout: 10s
{{- end}}

{{- if .HasDatabase}}

database:
{{- if eq .Database "postgres"}}
  ssl_mode: "require" # encrypt in transit; use verify-full + sslrootcert to also authenticate the server
  max_conns: 50
  min_conns: 10
  max_conn_lifetime: 30m
  max_conn_idle_time: 5m
{{- end}}
{{- if eq .Database "mysql"}}
  tls: "skip-verify" # encrypt in transit; use "true" with a registered CA to also authenticate the server
  max_open_conns: 50
  max_idle_conns: 10
  max_conn_lifetime: 30m
  max_conn_idle_time: 5m
{{- end}}
{{- end}}

{{- if .HasRedis}}

redis:
  pool_size: 30
  min_idle_conns: 5
  conn_max_lifetime: 5m
{{- end}}
