{{- end}}
	)
}
{{- end}}

{{- if .HasHTTP}}

// InitializeHTTPServer builds the HTTP app graph with fx and returns the same
// (*HTTPApp, func(), error) shape as the Wire variant. fx instantiates only the
// providers HTTPApp's fields transitively need; cleanup runs every OnStop hook
// in reverse construction order.
func InitializeHTTPServer(ctx context.Context) (*HTTPApp, func(), error) {
	var (
		log    *logger.Logger
		srv    *server.HTTPServer
		tracer trace.Tracer
		cfg    *config.Config
	)
	fxApp := fx.New(
		fx.NopLogger,
		fx.Provide(func() context.Context { return ctx }),
		infraModule(),
		httpModule(),
		adapterModule(),
		usecaseModule(),
		transportModule(),
		fx.Populate(&log, &tracer, &srv, &cfg),
	)
	if err := fxApp.Start(ctx); err != nil {
		return nil, nil, fmt.Errorf("fx: start http app: %w", err)
	}
	cleanup := func() {
		// The budget is config so an operator can widen it when a dependency
		// close is slow; a stop that overruns it is logged with the budget so
		// the skipped hooks are visible, not silently dropped.
		stopCtx, cancel := context.WithTimeout(context.Background(), cfg.ShutdownTimeout)
		defer cancel()
		if stopErr := fxApp.Stop(stopCtx); stopErr != nil {
			log.Error("fx: stop", "err", stopErr, "timeout_ms", cfg.ShutdownTimeout.Milliseconds())
		}
	}
	return &HTTPApp{Logger: log, Tracer: tracer, Server: srv}, cleanup, nil
}
{{- end}}

