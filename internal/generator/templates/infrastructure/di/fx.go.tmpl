// This file is the Uber fx counterpart to Wire's wire.go. It produces the same
// Initialize* entry points with identical (*App, func(), error) signatures, so
// the app layer (internal/app) is byte-for-byte the same whichever DI engine
// was selected. fx constructs lazily — only the providers reachable from the
// populated App fields are built, mirroring Wire's pruning of unused providers.
// The providers themselves live in fx_provider.go (the fx analogue of
// provider.go); this file is just the module composition + entry points.

// --- modules ---
// One module per Wire set. infraModule mirrors infraSet; the transport-specific
// modules mirror httpInfraSet / grpcInfraSet / workerInfraSet / cronInfraSet, and are composed
// per entry point so unused transport providers never enter the graph.

func infraModule() fx.Option {
	return fx.Provide(
		config.Load,
		provideJWTConfig,
		provideSecurityConfig,
		logger.New,
		provideObservabilityLogger,
		jwtsec.NewTokenService,
		provideTokenIssuer,
		fx.Annotate(infrasec.NewBcryptHasher, fx.As(new(domainsec.PasswordHasher))),
		provideValidator,
		provideTracingConfig,
		provideTracer,
{{- if .HasDatabase}}
		provideDatabaseConfig,
{{- end}}
{{- if eq .Database "postgres"}}
		providePostgresDB,
{{- end}}
{{- if eq .Database "mysql"}}
		provideMySQLDB,
{{- end}}
{{- if .HasRedis}}
		provideRedisConfig,
		provideRedisCache,
{{- end}}
{{- if .HasElasticsearch}}
		provideElasticsearchConfig,
		provideElasticsearch,
{{- end}}
{{- if eq .MessageQueue "kafka"}}
		provideKafkaConfig,
		provideKafkaProducer,
{{- end}}
{{- if eq .MessageQueue "rabbitmq"}}
		provideRabbitMQConfig,
		provideRabbitMQConnection,
{{- end}}
	)
}

{{- if .HasHTTP}}

