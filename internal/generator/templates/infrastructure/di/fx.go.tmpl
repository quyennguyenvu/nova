func adapterModule() fx.Option {
	return fx.Provide(
{{- if eq .Database "postgres"}}
		fx.Annotate(postgresrepo.NewUserRepository, fx.As(new(domain.UserRepository))),
		fx.Annotate(postgresrepo.NewTxManager, fx.As(new(domain.TxManager))),
{{- if .HasWorker}}
		fx.Annotate(postgresrepo.NewUserAuditRepository, fx.As(new(domain.UserAuditRepository))),
{{- end}}
{{- end}}
{{- if eq .Database "mysql"}}
		fx.Annotate(mysqlrepo.NewUserRepository, fx.As(new(domain.UserRepository))),
		fx.Annotate(mysqlrepo.NewTxManager, fx.As(new(domain.TxManager))),
{{- if .HasWorker}}
		fx.Annotate(mysqlrepo.NewUserAuditRepository, fx.As(new(domain.UserAuditRepository))),
{{- end}}
{{- end}}
{{- if not .HasDatabase}}
		fx.Annotate(memoryrepo.NewUserRepository, fx.As(new(domain.UserRepository))),
		fx.Annotate(memoryrepo.NewTxManager, fx.As(new(domain.TxManager))),
{{- end}}
{{- if eq .MessageQueue "kafka"}}
		fx.Annotate(pubsub.NewPublisher, fx.As(new(domain.UserPublisher))),
{{- end}}
{{- if eq .MessageQueue "rabbitmq"}}
		fx.Annotate(providePublisher, fx.As(new(domain.UserPublisher))),
{{- end}}
	)
}

func usecaseModule() fx.Option {
