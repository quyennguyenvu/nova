package di

import (
	"go.opentelemetry.io/otel/trace"

	"{{.ModuleName}}/internal/infrastructure/logger"
	"{{.ModuleName}}/internal/infrastructure/server"
)

{{- if .HasHTTP}}

// HTTPApp bundles every dependency the HTTP entry point needs from DI. The
// Logger is the single instance wired into every service. Tracer is held here
// so DI emits the tracing provider's cleanup hook (flush spans on shutdown)
// even when no service consumes the tracer constructor argument directly.
type HTTPApp struct {
	Logger *logger.Logger
	Server *server.HTTPServer
	Tracer trace.Tracer
}
{{- end}}

{{- if .HasGRPC}}

// GRPCApp bundles every dependency the gRPC entry point needs from DI. Same
// shape as HTTPApp — keeps the entry point free of multiple Initialize return
// values and makes future additions (admin server, metrics provider) a struct
// field, not a signature change.
type GRPCApp struct {
	Logger *logger.Logger
	Server *server.GRPCServer
	Tracer trace.Tracer
}
{{- end}}
