package di

import (
	"go.opentelemetry.io/otel/trace"

	"{{.ModuleName}}/internal/infrastructure/logger"
{{- if or .HasHTTP .HasGRPC}}
	"{{.ModuleName}}/internal/infrastructure/server"
{{- end}}
{{- if .HasWorker}}
	"{{.ModuleName}}/internal/transport/worker"
{{- end}}
)

{{- if .HasHTTP}}

// HTTPApp bundles every dependency the HTTP entry point needs from DI. The
// Logger is the single instance wired into every service. Tracer is held here
// so DI emits the tracing provider's cleanup hook (flush spans on shutdown)
// even when no service consumes the tracer constructor argument directly.
type HTTPApp struct {
	Logger *logger.Logger
	Server *server.HTTPServer
	Tracer trace.Tracer
}
{{- end}}

{{- if .HasGRPC}}

// GRPCApp bundles every dependency the gRPC entry point needs from DI.
type GRPCApp struct {
	Logger *logger.Logger
	Server *server.GRPCServer
	Tracer trace.Tracer
}
{{- end}}

{{- if .HasWorker}}

// WorkerApp bundles every dependency the consumer worker entry point needs
// from DI. Worker is the orchestrator that owns the broker consumer + the
// handler dispatch map.
type WorkerApp struct {
	Logger *logger.Logger
	Worker *worker.Worker
	Tracer trace.Tracer
}
{{- end}}
