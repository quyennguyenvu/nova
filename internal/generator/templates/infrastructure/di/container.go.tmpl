package di

import (
	"log/slog"

{{- if eq .Database "postgres"}}
	"github.com/jackc/pgx/v5/pgxpool"
{{- end}}
{{- if eq .Database "mysql"}}
	"database/sql"
{{- end}}
{{- if .HasRedis}}
	"github.com/redis/go-redis/v9"
{{- end}}

	v1 "{{.ModuleName}}/internal/adapter/handler/http/v1"
{{- if eq .Database "postgres"}}
	postgresrepo "{{.ModuleName}}/internal/adapter/repository/postgres"
{{- end}}
{{- if eq .Database "mysql"}}
	mysqlrepo "{{.ModuleName}}/internal/adapter/repository/mysql"
{{- end}}
{{- if .HasCache}}
	cacherepo "{{.ModuleName}}/internal/adapter/repository/cache"
{{- end}}
	"{{.ModuleName}}/internal/infrastructure/config"
{{- if eq .Database "postgres"}}
	"{{.ModuleName}}/internal/infrastructure/database"
{{- end}}
{{- if eq .Database "mysql"}}
	"{{.ModuleName}}/internal/infrastructure/database"
{{- end}}
{{- if .HasRedis}}
	infraCache "{{.ModuleName}}/internal/infrastructure/cache"
{{- end}}
	"{{.ModuleName}}/internal/infrastructure/logger"
	"{{.ModuleName}}/internal/infrastructure/server"
	userusecase "{{.ModuleName}}/internal/usecase/user"
)

// Container holds all application dependencies.
type Container struct {
	Config      *config.Config
	Logger      *slog.Logger
{{- if eq .Database "postgres"}}
	DB          *pgxpool.Pool
{{- end}}
{{- if eq .Database "mysql"}}
	DB          *sql.DB
{{- end}}
{{- if .HasRedis}}
	Cache       *redis.Client
{{- end}}
	HTTPServer  *server.HTTPServer
	UserHandler *v1.UserHandler
}

// NewContainer wires all dependencies together.
func NewContainer(cfg *config.Config) (*Container, error) {
	// Logger
	log := logger.New(cfg)

{{- if eq .Database "postgres"}}
	// Database
	db, err := database.NewPostgresDB(cfg)
	if err != nil {
		return nil, err
	}
	log.Info("connected to PostgreSQL")
{{- end}}

{{- if eq .Database "mysql"}}
	db, err := database.NewMySQLDB(cfg)
	if err != nil {
		return nil, err
	}
	log.Info("connected to MySQL")
{{- end}}

{{- if .HasRedis}}
	// Cache
	cacheClient, err := infraCache.NewRedisClient(cfg)
	if err != nil {
		return nil, err
	}
	log.Info("connected to Redis")
{{- end}}

	// Repositories
{{- if eq .Database "postgres"}}
	userRepo := postgresrepo.NewUserRepository(db)
{{- end}}
{{- if eq .Database "mysql"}}
	userRepo := mysqlrepo.NewUserRepository(db)
{{- end}}

{{- if and .HasCache .HasDatabase}}
	// Wrap with cache decorator
{{- if .HasRedis}}
	cachedUserRepo := cacherepo.NewUserCacheRepository(userRepo, cacheClient)
{{- else}}
	cachedUserRepo := cacherepo.NewUserCacheRepository(userRepo)
{{- end}}
	// Use cases
	userService := userusecase.NewService(cachedUserRepo, log)
{{- else if .HasDatabase}}
	// Use cases
	userService := userusecase.NewService(userRepo, log)
{{- end}}

	// Handlers
{{- if .HasDatabase}}
	userHandler := v1.NewUserHandler(userService)
{{- end}}

	// HTTP Server
	httpServer := server.NewHTTPServer(cfg, log)

	return &Container{
		Config:      cfg,
		Logger:      log,
{{- if .HasDatabase}}
		DB:          db,
{{- end}}
{{- if .HasRedis}}
		Cache:       cacheClient,
{{- end}}
		HTTPServer:  httpServer,
{{- if .HasDatabase}}
		UserHandler: userHandler,
{{- end}}
	}, nil
}

// Close cleans up all resources.
func (c *Container) Close() {
{{- if eq .Database "postgres"}}
	if c.DB != nil {
		c.DB.Close()
	}
{{- end}}
{{- if eq .Database "mysql"}}
	if c.DB != nil {
		c.DB.Close()
	}
{{- end}}
{{- if .HasRedis}}
	if c.Cache != nil {
		c.Cache.Close()
	}
{{- end}}
}
