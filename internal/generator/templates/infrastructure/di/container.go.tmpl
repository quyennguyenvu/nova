{{- end}}
)

{{- if .HasHTTP}}

// InitializeHTTPServer wires every dependency the HTTP server needs and returns
// the HTTPApp bundle together with a single cleanup that tears everything down
// in reverse order. ctx flows into the HTTP server so its graceful-shutdown
// can react to cancellation.
func InitializeHTTPServer(ctx context.Context) (*HTTPApp, func(), error) {
	cfg, err := config.Load()
	if err != nil {
		return nil, nil, err
	}

	log := logger.New(cfg.Log)

	tracer, tracingCleanup, err := tracing.Provider(ctx, provideTracingConfig(cfg))
	if err != nil {
		return nil, nil, err
	}

	var cleanups []func()
	cleanups = append(cleanups, tracingCleanup)
	cleanup := func() {
		for i := len(cleanups) - 1; i >= 0; i-- {
			cleanups[i]()
		}
	}
	fail := func(err error) (*HTTPApp, func(), error) {
		cleanup()
		return nil, nil, err
	}

{{- if eq .Database "postgres"}}
	db, dbCleanup, err := database.NewPostgresDB(cfg.Database, log)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, dbCleanup)
	log.Info("connected to PostgreSQL")
{{- end}}
{{- if eq .Database "mysql"}}
	db, dbCleanup, err := database.NewMySQLDB(cfg.Database, log)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, dbCleanup)
	log.Info("connected to MySQL")
{{- end}}

{{- if .HasRedis}}
	cacheClient, cacheCleanup, err := infraCache.New(cfg.Redis, log)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, cacheCleanup)
	log.Info("connected to Redis")
{{- end}}

{{- if eq .MessageQueue "kafka"}}
	producer, producerCleanup, err := infraPubsub.NewKafkaProducer(cfg.Kafka, log)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, producerCleanup)
	publisher := pubsub.NewPublisher(producer)
	log.Info("connected to Kafka")
{{- end}}
{{- if eq .MessageQueue "rabbitmq"}}
	conn, err := infraPubsub.NewRabbitMQConnection(cfg.RabbitMQ)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, func() { _ = conn.Close() })
	publisher, err := pubsub.NewPublisher(conn)
	if err != nil {
		return fail(err)
	}
	log.Info("connected to RabbitMQ")
{{- end}}

	tokenSvc, err := jwtsec.NewTokenService(cfg.JWT)
	if err != nil {
		return fail(err)
	}

	validate := provideValidator()

{{- if .HasDatabase}}
{{- if eq .Database "postgres"}}
	userRepo := postgresrepo.NewUserRepository(db)
{{- end}}
{{- if eq .Database "mysql"}}
	userRepo := mysqlrepo.NewUserRepository(db)
{{- end}}
	hasher := infrasec.NewBcryptHasher(cfg.Security)
{{- if .HasCache}}
{{- if .HasRedis}}
	cachedUserRepo := cacherepo.NewUserCacheRepository(userRepo, cacheClient)
{{- end}}
	userService := usersvc.NewService(cachedUserRepo, hasher, tokenSvc{{- if .HasMessageQueue}}, publisher{{- end}})
{{- else}}
	userService := usersvc.NewService(userRepo, hasher, tokenSvc{{- if .HasMessageQueue}}, publisher{{- end}})
{{- end}}

	userHandler := userv1.NewHandler(userService, validate)
	userRoutes := userv1.NewRoutes(userHandler, tokenSvc, cfg.HTTP.LoginRateLimit)
	checker := health.NewChecker(
{{- if and .HasDatabase (eq .Database "postgres")}}
		db,
{{- end}}
{{- if and .HasDatabase (eq .Database "mysql")}}
		db,
{{- end}}
{{- if .HasRedis}}
		cacheClient,
{{- end}}
	)
	app := transporthttp.NewApp(cfg, log, checker, provideRegistrars(userRoutes))
{{- else}}
	checker := health.NewChecker(
{{- if .HasRedis}}
		cacheClient,
{{- end}}
	)
	app := transporthttp.NewApp(cfg, log, checker, nil)
{{- end}}

	httpServer, httpCleanup, err := server.NewHTTPServer(ctx, cfg.HTTP, log, app)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, httpCleanup)

	return &HTTPApp{Logger: log, Server: httpServer, Tracer: tracer}, cleanup, nil
}
{{- end}}

{{- if .HasGRPC}}

// InitializeGRPCServer wires the gRPC server. Service registration is the
// caller's responsibility — use app.Server.Server() to access the underlying
// *grpc.Server and register your generated service implementations on it.
func InitializeGRPCServer(ctx context.Context) (*GRPCApp, func(), error) {
	cfg, err := config.Load()
	if err != nil {
		return nil, nil, err
	}

	log := logger.New(cfg.Log)

	tracer, tracingCleanup, err := tracing.Provider(ctx, provideTracingConfig(cfg))
	if err != nil {
		return nil, nil, err
	}

	grpcServer, grpcCleanup, err := server.NewGRPCServer(ctx, cfg.GRPC, log)
	if err != nil {
		tracingCleanup()
		return nil, nil, err
	}

	cleanup := func() {
		grpcCleanup()
		tracingCleanup()
	}
	return &GRPCApp{Logger: log, Server: grpcServer, Tracer: tracer}, cleanup, nil
}
{{- end}}

{{- if .HasWorker}}

// InitializeWorker wires the consumer worker. The dep chain is independent
// of HTTP: no transporthttp.NewApp, no health checker, no TokenService — the
// worker only needs the broker consumer + audit repo + audit usecase + the
// per-topic handlers. Cleanup runs in reverse construction order so the
// broker shuts before the DB pool.
func InitializeWorker(ctx context.Context) (*WorkerApp, func(), error) {
	cfg, err := config.Load()
	if err != nil {
		return nil, nil, err
	}

	log := logger.New(cfg.Log)

	tracer, tracingCleanup, err := tracing.Provider(ctx, provideTracingConfig(cfg))
	if err != nil {
		return nil, nil, err
	}

	var cleanups []func()
	cleanups = append(cleanups, tracingCleanup)
	cleanup := func() {
		for i := len(cleanups) - 1; i >= 0; i-- {
			cleanups[i]()
		}
	}
	fail := func(err error) (*WorkerApp, func(), error) {
		cleanup()
		return nil, nil, err
	}

{{- if eq .Database "postgres"}}
	db, dbCleanup, err := database.NewPostgresDB(cfg.Database, log)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, dbCleanup)
	log.Info("connected to PostgreSQL")
{{- end}}
{{- if eq .Database "mysql"}}
	db, dbCleanup, err := database.NewMySQLDB(cfg.Database, log)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, dbCleanup)
	log.Info("connected to MySQL")
{{- end}}

{{- if eq .MessageQueue "kafka"}}
	group, groupCleanup, err := infraPubsub.NewKafkaConsumerGroup(cfg.Kafka, log)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, groupCleanup)
	consumer := worker.NewKafkaConsumer(group, log)
{{- end}}
{{- if eq .MessageQueue "rabbitmq"}}
	conn, err := infraPubsub.NewRabbitMQConnection(cfg.RabbitMQ)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, func() { _ = conn.Close() })
	ch, chCleanup, err := infraPubsub.NewRabbitMQChannel(conn, log)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, chCleanup)
	consumer := worker.NewRabbitMQConsumer(ch, &cfg.RabbitMQ, log)
{{- end}}

{{- if eq .Database "postgres"}}
	auditRepo := postgresrepo.NewUserAuditRepository(db)
{{- end}}
{{- if eq .Database "mysql"}}
	auditRepo := mysqlrepo.NewUserAuditRepository(db)
{{- end}}
	auditService := useraudit.NewService(auditRepo)

	userHandler := workeruser.NewHandler(auditService)
	handlers := provideWorkerHandlers(userHandler)
	w := worker.NewWorker(consumer, log, handlers)

	return &WorkerApp{Logger: log, Worker: w, Tracer: tracer}, cleanup, nil
}
{{- end}}
