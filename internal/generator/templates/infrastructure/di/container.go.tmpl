{{- end}}
{{- if and .HasHTTP .HasMessageQueue}}
	"{{.ModuleName}}/internal/adapter/pubsub"
{{- end}}
	"{{.ModuleName}}/internal/infrastructure/config"
{{- if .HasDatabase}}
	"{{.ModuleName}}/internal/infrastructure/database"
{{- end}}
{{- if .HasRedis}}
	infraCache "{{.ModuleName}}/internal/infrastructure/cache"
{{- end}}
{{- if .HasMessageQueue}}
	infraPubsub "{{.ModuleName}}/internal/infrastructure/pubsub"
{{- end}}
{{- if .HasHTTP}}
	jwtsec "{{.ModuleName}}/internal/infrastructure/jwt"
{{- end}}
	"{{.ModuleName}}/internal/infrastructure/logger"
{{- if .HasHTTP}}
	infrasec "{{.ModuleName}}/internal/infrastructure/security"
{{- end}}
{{- if or .HasHTTP .HasGRPC}}
	"{{.ModuleName}}/internal/infrastructure/server"
{{- end}}
	"{{.ModuleName}}/internal/infrastructure/tracing"
{{- if .HasHTTP}}
	transporthttp "{{.ModuleName}}/internal/transport/http"
	"{{.ModuleName}}/internal/transport/http/health"
{{- if .HasDatabase}}
	userv1 "{{.ModuleName}}/internal/transport/http/v1/user"
