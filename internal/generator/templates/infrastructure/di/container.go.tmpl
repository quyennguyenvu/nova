package di

import (
	"context"

{{- if .HasHTTP}}
{{- if eq .Database "postgres"}}
	postgresrepo "{{.ModuleName}}/internal/adapter/repository/postgres"
{{- end}}
{{- if eq .Database "mysql"}}
	mysqlrepo "{{.ModuleName}}/internal/adapter/repository/mysql"
{{- end}}
{{- if .HasRedis}}
	cacherepo "{{.ModuleName}}/internal/adapter/repository/redis"
{{- end}}
{{- if .HasMessageQueue}}
	"{{.ModuleName}}/internal/adapter/pubsub"
{{- end}}
{{- end}}
	"{{.ModuleName}}/internal/infrastructure/config"
{{- if and .HasHTTP .HasDatabase}}
	"{{.ModuleName}}/internal/infrastructure/database"
{{- end}}
{{- if and .HasHTTP .HasRedis}}
	infraCache "{{.ModuleName}}/internal/infrastructure/cache"
{{- end}}
{{- if and .HasHTTP .HasMessageQueue}}
	infraPubsub "{{.ModuleName}}/internal/infrastructure/pubsub"
{{- end}}
	jwtsec "{{.ModuleName}}/internal/infrastructure/jwt"
	"{{.ModuleName}}/internal/infrastructure/logger"
	infrasec "{{.ModuleName}}/internal/infrastructure/security"
	"{{.ModuleName}}/internal/infrastructure/server"
	"{{.ModuleName}}/internal/infrastructure/tracing"
{{- if .HasHTTP}}
	transporthttp "{{.ModuleName}}/internal/transport/http"
{{- if .HasDatabase}}
	userv1 "{{.ModuleName}}/internal/transport/http/v1/user"
	usersvc "{{.ModuleName}}/internal/usecase/user"
{{- end}}
{{- end}}
)

{{- if .HasHTTP}}

// InitializeHTTPServer wires every dependency the HTTP server needs and returns
// the HTTPApp bundle together with a single cleanup that tears everything down
// in reverse order. ctx flows into the HTTP server so its graceful-shutdown
// can react to cancellation.
func InitializeHTTPServer(ctx context.Context) (*HTTPApp, func(), error) {
	cfg, err := config.Load()
	if err != nil {
		return nil, nil, err
	}

	log := logger.New(cfg)

	tracer, tracingCleanup, err := tracing.Provider(ctx, provideTracingConfig(cfg))
	if err != nil {
		return nil, nil, err
	}

	var cleanups []func()
	cleanups = append(cleanups, tracingCleanup)
	cleanup := func() {
		for i := len(cleanups) - 1; i >= 0; i-- {
			cleanups[i]()
		}
	}
	fail := func(err error) (*HTTPApp, func(), error) {
		cleanup()
		return nil, nil, err
	}

{{- if eq .Database "postgres"}}
	db, dbCleanup, err := database.NewPostgresDB(cfg, log)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, dbCleanup)
	log.Info("connected to PostgreSQL")
{{- end}}
{{- if eq .Database "mysql"}}
	db, dbCleanup, err := database.NewMySQLDB(cfg, log)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, dbCleanup)
	log.Info("connected to MySQL")
{{- end}}

{{- if .HasRedis}}
	cacheClient, cacheCleanup, err := infraCache.New(cfg, log)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, cacheCleanup)
	log.Info("connected to Redis")
{{- end}}

{{- if eq .MessageQueue "kafka"}}
	producer, producerCleanup, err := infraPubsub.NewKafkaProducer(&cfg.Kafka, log)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, producerCleanup)
	publisher := pubsub.NewPublisher(producer)
	log.Info("connected to Kafka")
{{- end}}
{{- if eq .MessageQueue "rabbitmq"}}
	conn, err := infraPubsub.NewRabbitMQConnection(&cfg.RabbitMQ)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, func() { _ = conn.Close() })
	publisher, err := pubsub.NewPublisher(conn)
	if err != nil {
		return fail(err)
	}
	log.Info("connected to RabbitMQ")
{{- end}}

	tokenSvc, err := jwtsec.NewTokenService(cfg)
	if err != nil {
		return fail(err)
	}

{{- if .HasDatabase}}
{{- if eq .Database "postgres"}}
	userRepo := postgresrepo.NewUserRepository(db)
{{- end}}
{{- if eq .Database "mysql"}}
	userRepo := mysqlrepo.NewUserRepository(db)
{{- end}}
	hasher := infrasec.NewDefaultBcryptHasher()
{{- if .HasCache}}
{{- if .HasRedis}}
	cachedUserRepo := cacherepo.NewUserCacheRepository(userRepo, cacheClient)
{{- end}}
	userService := usersvc.NewService(cachedUserRepo, hasher, tokenSvc{{- if .HasMessageQueue}}, publisher{{- end}})
{{- else}}
	userService := usersvc.NewService(userRepo, hasher, tokenSvc{{- if .HasMessageQueue}}, publisher{{- end}})
{{- end}}

	userHandler := userv1.NewHandler(userService)
	userRoutes := userv1.NewRoutes(userHandler, tokenSvc)
	app := transporthttp.NewApp(cfg, log, provideRegistrars(userRoutes))
{{- else}}
	app := transporthttp.NewApp(cfg, log, nil)
{{- end}}

	httpServer, httpCleanup, err := server.NewHTTPServer(ctx, cfg, log, app)
	if err != nil {
		return fail(err)
	}
	cleanups = append(cleanups, httpCleanup)

	return &HTTPApp{Logger: log, Server: httpServer, Tracer: tracer}, cleanup, nil
}
{{- end}}

{{- if .HasGRPC}}

// InitializeGRPCServer wires the gRPC server. Service registration is the
// caller's responsibility — use app.Server.Server() to access the underlying
// *grpc.Server and register your generated service implementations on it.
func InitializeGRPCServer(ctx context.Context) (*GRPCApp, func(), error) {
	cfg, err := config.Load()
	if err != nil {
		return nil, nil, err
	}

	log := logger.New(cfg)

	tracer, tracingCleanup, err := tracing.Provider(ctx, provideTracingConfig(cfg))
	if err != nil {
		return nil, nil, err
	}

	grpcServer, grpcCleanup, err := server.NewGRPCServer(ctx, cfg, log)
	if err != nil {
		tracingCleanup()
		return nil, nil, err
	}

	cleanup := func() {
		grpcCleanup()
		tracingCleanup()
	}
	return &GRPCApp{Logger: log, Server: grpcServer, Tracer: tracer}, cleanup, nil
}
{{- end}}
