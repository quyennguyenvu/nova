// --- lifecycle-wrapped infrastructure providers ---
// Each adapts a Wire-style (T, func(), error) constructor into an fx provider
// that registers the cleanup as an OnStop hook, so fxApp.Stop() runs every
// cleanup in reverse construction order — the fx equivalent of Wire's
// aggregated cleanup func.

func provideTracer(lc fx.Lifecycle, ctx context.Context, cfg tracing.Config) (trace.Tracer, error) {
	tracer, cleanup, err := tracing.Provider(ctx, cfg)
	if err != nil {
		return nil, err
	}
	lc.Append(fx.Hook{OnStop: func(context.Context) error { cleanup(); return nil }})
	return tracer, nil
}

