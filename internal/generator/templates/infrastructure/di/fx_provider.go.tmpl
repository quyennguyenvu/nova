// This file holds the fx providers consumed by the modules in fx.go — the fx
// analogue of provider.go's shared helpers, kept separate so fx.go reads as a
// clean list of modules and Initialize* entry points (mirroring wire.go).

// --- config field providers ---
// fx wires by type, so each sub-config the constructors depend on is projected
// out of *config.Config by a dedicated provider — the equivalent of Wire's
// wire.FieldsOf(new(*config.Config), "<Field>").

func provideLogConfig(c *config.Config) config.LogConfig           { return c.Log }
func provideJWTConfig(c *config.Config) config.JWTConfig           { return c.JWT }
func provideSecurityConfig(c *config.Config) config.SecurityConfig { return c.Security }

// provideObservabilityLogger exposes the concrete *logger.Logger as the
// observability.Logger port. fx matches by exact type, so transport consumers
// that depend on the port (router, middleware, worker, consumer) need this
// bridge. logger.New still provides the concrete for infra consumers and the
// App bundle. fx.As is unusable here — it would replace the concrete in the
// graph, breaking those consumers and fx.Populate(&log *logger.Logger).
func provideObservabilityLogger(l *logger.Logger) observability.Logger { return l }

{{- if .HasDatabase}}
func provideDatabaseConfig(c *config.Config) config.DatabaseConfig { return c.Database }
{{- end}}
{{- if .HasRedis}}
func provideRedisConfig(c *config.Config) config.RedisConfig { return c.Redis }
{{- end}}
{{- if .HasHTTP}}
