package di

import (
	"github.com/go-playground/validator/v10"

	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/infrastructure/tracing"
{{- if .HasHTTP}}
	transporthttp "{{.ModuleName}}/internal/transport/http"
	userv1 "{{.ModuleName}}/internal/transport/http/v1/user"
{{- end}}
{{- if .HasWorker}}
	"{{.ModuleName}}/internal/transport/worker"
	workeruser "{{.ModuleName}}/internal/transport/worker/v1/user"
{{- end}}
)

// provideValidator returns a single concurrent-safe *validator.Validate that
// every handler uses to enforce `validate:"..."` tags on incoming DTOs.
// One instance per process — internal caches make repeated Struct() calls
// cheap once tags have been parsed.
func provideValidator() *validator.Validate {
	return validator.New(validator.WithRequiredStructEnabled())
}

{{- if .HasHTTP}}

// provideRegistrars assembles every feature's Registrar into a slice that
// transport/http.NewRouter consumes in order. Each Registrar carries its own
// Prefix() — the slice order determines mount order, not the prefix string.
// Add new features here as they appear.
//
// The transporthttp.Registrar interface is framework-specific — its Register
// signature is set by whichever router file was generated (fiber/gin/chi/echo).
// As long as each *Registrar type's Register method matches the chosen
// framework's router type, this provider compiles unchanged.
func provideRegistrars(userRegistrar *userv1.Registrar) []transporthttp.Registrar {
	return []transporthttp.Registrar{
		userRegistrar,
	}
}
{{- end}}

// provideTracingConfig projects the app config into the tracing package's
// neutral Config struct, so tracing has no compile-time dep on config.
func provideTracingConfig(cfg *config.Config) tracing.Config {
	return tracing.Config{
		ServiceName:    cfg.AppName,
		ServiceVersion: cfg.AppVersion,
		Environment:    cfg.AppEnv,
		Endpoint:       cfg.Tracing.Endpoint,
		Insecure:       cfg.Tracing.Insecure,
		SampleRatio:    cfg.Tracing.SampleRatio,
	}
}

{{- if .HasWorker}}

// provideWorkerHandlers assembles every worker-side message handler into a
// slice. Each Handler advertises its own Topic() — the Worker dispatches by
// topic at runtime. Add new feature handlers here as they appear.
func provideWorkerHandlers(userHandler *workeruser.Handler) []worker.Handler {
	return []worker.Handler{
		userHandler,
	}
}
{{- end}}
