//go:build wireinject
// +build wireinject

package di

import (
	"context"

{{- if .HasMessageQueue}}
	"{{.ModuleName}}/internal/adapter/pubsub"
{{- end}}
{{- if eq .Database "postgres"}}
	postgresrepo "{{.ModuleName}}/internal/adapter/repository/postgres"
{{- end}}
{{- if eq .Database "mysql"}}
	mysqlrepo "{{.ModuleName}}/internal/adapter/repository/mysql"
{{- end}}
	"{{.ModuleName}}/internal/domain"
	"{{.ModuleName}}/internal/infrastructure/config"
{{- if .HasDatabase}}
	"{{.ModuleName}}/internal/infrastructure/database"
{{- end}}
{{- if .HasRedis}}
	infraCache "{{.ModuleName}}/internal/infrastructure/cache"
{{- end}}
{{- if .HasElasticsearch}}
	infraSearch "{{.ModuleName}}/internal/infrastructure/search"
{{- end}}
	jwtsec "{{.ModuleName}}/internal/infrastructure/jwt"
	"{{.ModuleName}}/internal/infrastructure/logger"
	infrasec "{{.ModuleName}}/internal/infrastructure/security"
	"{{.ModuleName}}/internal/infrastructure/tracing"
	domainsec "{{.ModuleName}}/internal/domain/security"
{{- if .HasMessageQueue}}
	infraPubsub "{{.ModuleName}}/internal/infrastructure/pubsub"
{{- end}}
{{- if or .HasHTTP .HasGRPC}}
	"{{.ModuleName}}/internal/infrastructure/server"
{{- end}}
{{- if .HasHTTP}}
	transporthttp "{{.ModuleName}}/internal/transport/http"
	"{{.ModuleName}}/internal/transport/http/health"
	userv1 "{{.ModuleName}}/internal/transport/http/v1/user"
{{- end}}
{{- if .HasWorker}}
	"{{.ModuleName}}/internal/transport/worker"
	workeruser "{{.ModuleName}}/internal/transport/worker/v1/user"
	"{{.ModuleName}}/internal/usecase/useraudit"
{{- end}}
	usersvc "{{.ModuleName}}/internal/usecase/user"
	"{{.ModuleName}}/pkg/observability"

	"github.com/google/wire"
)

// infraSet provides the foundational dependencies every binary needs:
// config, logger, tracing, DB, redis, and the security primitives
// (TokenService, hasher, validator). Mode-specific providers live in
// httpInfraSet / workerInfraSet so unused Transport modes don't drag in
// providers that would fail at startup (e.g. NewTokenService rejecting
// a missing public key when the worker doesn't need JWTs).
var infraSet = wire.NewSet(
	config.Load,
	wire.FieldsOf(new(*config.Config), "Log", "JWT", "Security"),
	logger.New,
	// Transport depends on the observability.Logger port; bind it to the
	// concrete *logger.Logger here so the App bundle + infra consumers keep
	// the concrete while transport stays decoupled from infrastructure/logger.
	wire.Bind(new(observability.Logger), new(*logger.Logger)),
	jwtsec.NewTokenService,
	infrasec.NewBcryptHasher,
	wire.Bind(new(domainsec.PasswordHasher), new(*infrasec.BcryptHasher)),
	provideValidator,
	provideTracingConfig,
	tracing.Provider,
{{- if .HasDatabase}}
	wire.FieldsOf(new(*config.Config), "Database"),
{{- end}}
{{- if eq .Database "postgres"}}
	database.NewPostgresDB,
{{- end}}
{{- if eq .Database "mysql"}}
	database.NewMySQLDB,
{{- end}}
{{- if .HasRedis}}
	wire.FieldsOf(new(*config.Config), "Redis"),
	infraCache.New,
{{- end}}
{{- if .HasElasticsearch}}
	wire.FieldsOf(new(*config.Config), "Elasticsearch"),
	infraSearch.New,
{{- end}}
{{- if .HasMessageQueue}}
{{- if eq .MessageQueue "kafka"}}
	wire.FieldsOf(new(*config.Config), "Kafka"),
	infraPubsub.NewKafkaProducer,
{{- end}}
{{- if eq .MessageQueue "rabbitmq"}}
	wire.FieldsOf(new(*config.Config), "RabbitMQ"),
	infraPubsub.NewRabbitMQConnection,
{{- end}}
{{- end}}
)

{{- if .HasHTTP}}

// httpInfraSet adds providers only the HTTP transport needs (server, router,
// health checker). Kept separate from infraSet so the worker mode's wire
// graph isn't polluted with HTTP-specific dependencies.
var httpInfraSet = wire.NewSet(
	wire.FieldsOf(new(*config.Config), "HTTP"),
	wire.FieldsOf(new(config.HTTPConfig), "LoginRateLimit"),
	health.NewChecker,
	transporthttp.NewRouter,
	server.NewHTTPServer,
)
{{- end}}

{{- if .HasGRPC}}

var grpcInfraSet = wire.NewSet(
	wire.FieldsOf(new(*config.Config), "GRPC"),
	server.NewGRPCServer,
)
{{- end}}

{{- if .HasWorker}}

// workerInfraSet adds the broker-specific consumer factory + the worker
// orchestrator. The Consumer interface (transport/worker.Consumer) is bound
// to either the Kafka or RabbitMQ implementation depending on cfg.MessageQueue.
var workerInfraSet = wire.NewSet(
{{- if eq .MessageQueue "kafka"}}
	infraPubsub.NewKafkaConsumerGroup,
	worker.NewKafkaConsumer,
{{- end}}
{{- if eq .MessageQueue "rabbitmq"}}
	infraPubsub.NewRabbitMQChannel,
	worker.NewRabbitMQConsumer,
{{- end}}
	worker.NewWorker,
	provideWorkerHandlers,
)
{{- end}}

var adapterSet = wire.NewSet(
{{- if eq .Database "postgres"}}
	postgresrepo.NewUserRepository,
	wire.Bind(new(domain.UserRepository), new(*postgresrepo.UserRepository)),
{{- if .HasWorker}}
	postgresrepo.NewUserAuditRepository,
	wire.Bind(new(domain.UserAuditRepository), new(*postgresrepo.UserAuditRepository)),
{{- end}}
{{- end}}
{{- if eq .Database "mysql"}}
	mysqlrepo.NewUserRepository,
	wire.Bind(new(domain.UserRepository), new(*mysqlrepo.UserRepository)),
{{- if .HasWorker}}
	mysqlrepo.NewUserAuditRepository,
	wire.Bind(new(domain.UserAuditRepository), new(*mysqlrepo.UserAuditRepository)),
{{- end}}
{{- end}}
{{- if .HasMessageQueue}}
	pubsub.NewPublisher,
	wire.Bind(new(domain.UserPublisher), new(*pubsub.Publisher)),
{{- end}}
)

var usecaseSet = wire.NewSet(
	usersvc.NewService,
{{- if .HasWorker}}
	useraudit.NewService,
{{- end}}
)

{{- if .HasHTTP}}
var transportSet = wire.NewSet(
	userv1.NewHandler,
	userv1.NewRegistrar,
	provideRegistrars,
)

// InitializeHTTPServer returns the HTTPApp bundle so the entry point gets
// the same *logger.Logger that DI wired into every service.
func InitializeHTTPServer(ctx context.Context) (*HTTPApp, func(), error) {
	panic(wire.Build(
		infraSet,
		httpInfraSet,
		adapterSet,
		usecaseSet,
		transportSet,
		wire.Struct(new(HTTPApp), "*"),
	))
}
{{- end}}

{{- if .HasGRPC}}

// InitializeGRPCServer wires the gRPC server. Service registration is the
// caller's responsibility — call app.Server.Server() to get the underlying *grpc.Server.
func InitializeGRPCServer(ctx context.Context) (*GRPCApp, func(), error) {
	panic(wire.Build(
		infraSet,
		grpcInfraSet,
		wire.Struct(new(GRPCApp), "*"),
	))
}
{{- end}}

{{- if .HasWorker}}
var workerHandlerSet = wire.NewSet(
	workeruser.NewHandler,
)

// InitializeWorker returns the WorkerApp bundle for the consumer process.
// Wire only constructs providers reachable from WorkerApp's struct fields,
// so HTTP/gRPC-only providers (server.NewHTTPServer, transporthttp.NewRouter,
// health.NewChecker, transportSet) aren't dragged into the worker binary.
func InitializeWorker(ctx context.Context) (*WorkerApp, func(), error) {
	panic(wire.Build(
		infraSet,
		workerInfraSet,
		workerHandlerSet,
		adapterSet,
		usecaseSet,
		wire.Struct(new(WorkerApp), "*"),
	))
}
{{- end}}
