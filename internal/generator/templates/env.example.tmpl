# Server
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10
{{- if .HasDatabase}}

# Database
{{- if eq .Database "postgres"}}
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME={{.ProjectName}}
DB_SSL_MODE=disable
{{- end}}
{{- if eq .Database "mysql"}}
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME={{.ProjectName}}
{{- end}}
{{- end}}
{{- if .HasRedis}}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
{{- end}}

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
