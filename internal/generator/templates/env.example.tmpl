# Copy to .env and fill in real values. .env is .gitignored and must NEVER
# be committed. Every field has a default in base.yaml; entries here override
# the YAML at runtime via cleanenv.ReadEnv.

# Environment switch: selects which config/<APP_ENV>.yaml is layered onto base.yaml.
# Valid values: development | production. Leave unset (or "local") to skip overlay.
APP_ENV=local

# ── JWT signer (required) ───────────────────────────────────
# HS256 shared secret. Use 256+ bits of randomness, e.g. `openssl rand -hex 32`.
# Rotating invalidates every live token — plan rollouts.
JWT_SECRET=<set-me>
JWT_ISSUER={{.ProjectName}}
JWT_AUDIENCE={{.ProjectName}}
JWT_ACCESS_TOKEN_TTL=1h

# ── CORS (required for production) ──────────────────────────
# Comma-separated origin list. Empty disables CORS responses entirely. Never "*" in prod.
CORS_ALLOW_ORIGINS=
{{- if .HasDatabase}}

# ── Database credentials ────────────────────────────────────
{{- if eq .Database "postgres"}}
DB_HOST=localhost
DB_PORT=5432
DB_NAME={{.ProjectName}}
DB_USER=<set-me>
DB_PASSWORD=<set-me>
DB_SSL_MODE=disable

# Used by Makefile (migrate) and sqlc — not read by the Go config.
MIGRATE_DATABASE_URL=postgres://<user>:<password>@localhost:5432/{{.ProjectName}}?sslmode=disable
{{- end}}
{{- if eq .Database "mysql"}}
DB_HOST=localhost
DB_PORT=3306
DB_NAME={{.ProjectName}}
DB_USER=<set-me>
DB_PASSWORD=<set-me>

# Used by Makefile (migrate) and sqlc — not read by the Go config.
MIGRATE_DATABASE_URL=<user>:<password>@tcp(localhost:3306)/{{.ProjectName}}
{{- end}}
{{- end}}

{{- if .HasRedis}}

# ── Redis ───────────────────────────────────────────────────
# Override REDIS_ADDRS / REDIS_PASSWORD per environment. Pool tuning lives in
# base.yaml (and production.yaml) but every field below can be overridden via
# its REDIS_* env var if a deploy needs it.
REDIS_ADDRS=localhost:6379
REDIS_PASSWORD=

# Sentinel example:
# REDIS_MODE=sentinel
# REDIS_ADDRS=sentinel1:26379,sentinel2:26379,sentinel3:26379
# REDIS_MASTER_NAME=mymaster

# Cluster example:
# REDIS_MODE=cluster
# REDIS_ADDRS=node1:6379,node2:6379,node3:6379
{{- end}}

{{- if eq .MessageQueue "kafka"}}

# ── Kafka ───────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
# Required in worker mode; ignored otherwise.
KAFKA_CONSUMER_GROUP_ID={{.ProjectName}}-worker
KAFKA_USER_CREATED_TOPIC=user.created
{{- end}}

{{- if eq .MessageQueue "rabbitmq"}}

# ── RabbitMQ (contains credentials) ─────────────────────────
RABBITMQ_URL=amqp://<user>:<password>@localhost:5672/
RABBITMQ_EXCHANGE={{.ProjectName}}.events
RABBITMQ_USER_CREATED_QUEUE={{.ProjectName}}.user.created
{{- end}}

# ── Observability (optional) ────────────────────────────────
# Set to your collector endpoint to enable OTLP export, e.g. otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SAMPLE_RATIO=0.1
