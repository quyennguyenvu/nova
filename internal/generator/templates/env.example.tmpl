# Server
APP_ENV=local
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10

{{- if .HasDatabase}}
# Database

{{- if eq .Database "postgres"}}
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME={{.ProjectName}}
DB_SSL_MODE=disable
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{.ProjectName}}
{{- end}}

{{- if eq .Database "mysql"}}
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME={{.ProjectName}}
MIGRATE_DATABASE_URL=root:root@tcp(localhost:3306)/{{.ProjectName}}
{{- end}}
{{- end}}

{{- if .HasRedis}}
# Redis
# ── Single node (local dev) ──────────────────
REDIS_MODE=single
REDIS_ADDRS=localhost:6379
REDIS_DB=0

# ── Sentinel (staging HA) ────────────────────
REDIS_MODE=sentinel
REDIS_ADDRS=sentinel1:26379,sentinel2:26379,sentinel3:26379
REDIS_MASTER_NAME=mymaster
REDIS_PASSWORD=secret
REDIS_POOL_SIZE=20

# ── Cluster (production) ─────────────────────
REDIS_MODE=cluster
REDIS_ADDRS=node1:6379,node2:6379,node3:6379
REDIS_PASSWORD=secret
REDIS_POOL_SIZE=50
REDIS_MIN_IDLE_CONNS=5
REDIS_CONN_MAX_LIFETIME=30m
REDIS_READ_TIMEOUT=3s
{{- end}}

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
