# Copy to .env and fill in real values. .env is .gitignored and must NEVER
# be committed. The binary loads ./.env itself on host runs; variables that
# are already set in the environment always win over it, and containers
# inject their environment instead of shipping a .env.
#
# This file holds ONLY secrets and per-deployment endpoints — values that are
# unsafe to commit or that differ on every machine/deploy. Everything else
# (timeouts, pool sizes, log level, issuer/audience, topic & queue names, …)
# has a default in base.yaml with per-env overrides in <APP_ENV>.yaml. Any of
# those can still be overridden here at runtime via its env var (cleanenv.ReadEnv).
#
# Every value below is sourceable as-is; the ones marked "required" fail at
# startup until set.

# Environment switch: selects which config/<APP_ENV>.yaml is layered onto base.yaml.
# Valid values: local | development | production (anything else is rejected).
APP_ENV=local

# ── JWT (RS256, asymmetric) ─────────────────────────────────
# Required. Base64-encoded PEM keys. Generate a pair:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl rsa -in jwt.key -pubout -out jwt.pub
#   base64 < jwt.pub | tr -d '\n'   # → JWT_PUBLIC_KEY
#   base64 < jwt.key | tr -d '\n'   # → JWT_PRIVATE_KEY
# Every service sets JWT_PUBLIC_KEY (to verify). Only the token-issuing
# service sets JWT_PRIVATE_KEY; leave it empty elsewhere (verify-only).
# issuer / audience / ttl default in base.yaml.
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# ── CORS (per-deployment) ───────────────────────────────────
# Comma-separated origin list; production MUST set this. Empty disables CORS
# entirely. Never "*". Dev defaults ship in development.yaml.
CORS_ALLOW_ORIGINS=

# ── Reverse proxies (per-deployment) ────────────────────────
# Comma-separated CIDRs or IPs of the load balancers in front of this service.
# X-Forwarded-For is trusted only from these; empty means clients connect
# directly and the header is ignored.
SERVER_TRUSTED_PROXIES=
{{- if .HasDatabase}}

# ── Database (endpoint + credentials) ───────────────────────
# Dev defaults matching docker-compose; change them in any shared environment.
{{- if eq .Database "postgres"}}
# host/port/name/ssl_mode default in base.yaml — override via DB_HOST / DB_PORT / DB_NAME / DB_SSL_MODE.
DB_HOST=localhost
DB_NAME={{.ProjectName}}
DB_USER={{.ProjectName}}
DB_PASSWORD={{.ProjectName}}

# Read by `make migrate-up`/`migrate-down` (from the environment, else this
# file); the Go config ignores it.
MIGRATE_DATABASE_URL=postgres://{{.ProjectName}}:{{.ProjectName}}@localhost:5432/{{.ProjectName}}?sslmode=disable
{{- end}}
{{- if eq .Database "mysql"}}
# host/port/name/tls default in base.yaml — override via DB_HOST / DB_PORT / DB_NAME / DB_TLS.
DB_HOST=localhost
DB_NAME={{.ProjectName}}
DB_USER={{.ProjectName}}
DB_PASSWORD={{.ProjectName}}

# Read by `make migrate-up`/`migrate-down` (from the environment, else this
# file); the Go config ignores it. Quoted: the parentheses are shell syntax.
MIGRATE_DATABASE_URL="mysql://{{.ProjectName}}:{{.ProjectName}}@tcp(localhost:3306)/{{.ProjectName}}"
{{- end}}
{{- end}}

{{- if .HasRedis}}

# ── Redis (endpoint + secret) ───────────────────────────────
# Pool/timeout tuning lives in base.yaml; only the endpoint and password belong
# here. Topology overrides (sentinel/cluster) shown below — every redis field is
# still overridable via its REDIS_* var if a deploy needs it.
REDIS_ADDRS=localhost:6379
REDIS_PASSWORD=

# Sentinel example:
# REDIS_MODE=sentinel
# REDIS_ADDRS=sentinel1:26379,sentinel2:26379,sentinel3:26379
# REDIS_MASTER_NAME=mymaster

# Cluster example:
# REDIS_MODE=cluster
# REDIS_ADDRS=node1:6379,node2:6379,node3:6379
{{- end}}

{{- if .HasElasticsearch}}

# ── Elasticsearch (endpoint + credentials) ──────────────────
# addresses / max_retries / ping_timeout default in base.yaml. Set basic-auth
# credentials or an API key here for a secured cluster; leave blank for a local
# unsecured node.
ELASTICSEARCH_ADDRESSES=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
{{- end}}

{{- if eq .MessageQueue "kafka"}}

# ── Kafka (endpoint) ────────────────────────────────────────
# consumer_group_id defaults in base.yaml.
KAFKA_BROKERS=localhost:9092
{{- end}}

{{- if eq .MessageQueue "rabbitmq"}}

# ── RabbitMQ (contains credentials) ─────────────────────────
# Dev default matching docker-compose; exchange, queue and prefetch default in base.yaml.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
{{- end}}

# ── Observability (per-deployment endpoint) ─────────────────
# Set to your collector endpoint to enable OTLP export, e.g. otel-collector:4317.
# insecure / sample_ratio tuning lives in base.yaml.
OTEL_EXPORTER_OTLP_ENDPOINT=
