# Environment switch: selects which config/<APP_ENV>.yaml is layered onto base.yaml.
# Valid values: development | production. Leave unset (or "local") to skip overlay.
APP_ENV=local

# ── JWT verifier (required) ─────────────────────────────────
# Base64-encoded PEM of the RSA public keys issued by your identity provider.
IDENTITY_PUBLIC_KEY_BASE64=
IDENTITY_ADMIN_PUBLIC_KEY_BASE64=
IDENTITY_ISSUER=
JWT_AUDIENCE=

{{- if .HasDatabase}}

# ── Database credentials ────────────────────────────────────
{{- if eq .Database "postgres"}}
DB_HOST=localhost
DB_PORT=5432
DB_NAME={{.ProjectName}}
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

# Used by Makefile (migrate) and sqlc — not read by the Go config.
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{.ProjectName}}?sslmode=disable
{{- end}}
{{- if eq .Database "mysql"}}
DB_HOST=localhost
DB_PORT=3306
DB_NAME={{.ProjectName}}
DB_USER=root
DB_PASSWORD=root

# Used by Makefile (migrate) and sqlc — not read by the Go config.
MIGRATE_DATABASE_URL=root:root@tcp(localhost:3306)/{{.ProjectName}}
{{- end}}
{{- end}}

{{- if .HasRedis}}

# ── Redis ───────────────────────────────────────────────────
# Override REDIS_ADDRS / REDIS_PASSWORD per environment. Pool tuning lives in
# base.yaml (and production.yaml) but every field below can be overridden via
# its REDIS_* env var if a deploy needs it.
REDIS_ADDRS=localhost:6379
REDIS_PASSWORD=

# Sentinel example:
# REDIS_MODE=sentinel
# REDIS_ADDRS=sentinel1:26379,sentinel2:26379,sentinel3:26379
# REDIS_MASTER_NAME=mymaster

# Cluster example:
# REDIS_MODE=cluster
# REDIS_ADDRS=node1:6379,node2:6379,node3:6379
{{- end}}

{{- if eq .MessageQueue "kafka"}}

# ── Kafka ───────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
{{- end}}

{{- if eq .MessageQueue "rabbitmq"}}

# ── RabbitMQ (contains credentials) ─────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
{{- end}}
