openapi: "3.0.3"
info:
  title: {{.ProjectName}} API
  description: REST API for {{.ProjectName}} built with Clean Architecture
  version: "1.0.0"

servers:
  - url: http://localhost:8080
    description: Local development

# Authenticated endpoints carry `Authorization: Bearer <accessToken>` issued
# by POST /api/v1/login; the scheme is case-insensitive. Public endpoints are
# explicitly marked. Every JSON body is the standard envelope: success, data or
# error, optional meta, and requestId (the X-Request-ID the response carries).
# A body over the configured limit is refused with 413 and a request that
# outlives the server's deadline answers 504, on every route.
security:
  - bearerAuth: []

paths:
  /healthz:
    get:
      summary: Liveness probe
      security: []
      responses:
        "200":
          description: Process is alive
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ProbeStatus"

  /readyz:
    get:
      summary: Readiness probe — pings every configured dependency
      security: []
      responses:
        "200":
          description: All dependencies reachable
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ProbeStatus"
        "503":
          description: At least one dependency failed; details names it as "fail", never its error text
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ProbeStatus"

  /api/v1/login:
    post:
      summary: Exchange credentials for a bearer token
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/LoginRequest"
      responses:
        "200":
          description: Token issued
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/LoginResponseEnvelope"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          description: Invalid credentials (the same answer and timing for an unknown email)
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "413":
          $ref: "#/components/responses/PayloadTooLarge"
        "429":
          $ref: "#/components/responses/TooManyRequests"

  /api/v1/users:
    post:
      summary: Register a new user
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateUserInput"
      responses:
        "201":
          description: User created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UserResponseEnvelope"
        "400":
          $ref: "#/components/responses/BadRequest"
        "409":
          description: Email already exists
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "413":
          $ref: "#/components/responses/PayloadTooLarge"
        "429":
          $ref: "#/components/responses/TooManyRequests"
    get:
      summary: List users (page-based admin form)
      parameters:
        - name: page
          in: query
          description: 1-based page number; values below 1 read as 1
          schema:
            type: integer
            default: 1
        - name: perPage
          in: query
          description: Page size; values outside 1–500 fall back to 10
          schema:
            type: integer
            default: 10
            maximum: 500
        - name: email
          in: query
          description: Exact-match email filter
          schema:
            type: string
            format: email
      responses:
        "200":
          description: One page of users plus page meta
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UserListResponseEnvelope"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"

  /api/v1/public/users:
    get:
      summary: Public directory (cursor-paginated, email and name only)
      security: []
      parameters:
        - name: cursor
          in: query
          description: Opaque token from the previous page's meta.nextCursor; omit for the first page
          schema:
            type: string
        - name: limit
          in: query
          description: Page size; values outside 1–500 fall back to 10
          schema:
            type: integer
            default: 10
            maximum: 500
      responses:
        "200":
          description: One page of the directory plus cursor meta
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicUserListResponseEnvelope"
        "400":
          description: Malformed cursor
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

  /api/v1/users/{id}:
    parameters:
      - name: id
        in: path
        required: true
        schema:
          type: integer
          format: int64
    get:
      summary: Get user by ID
      responses:
        "200":
          description: User found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UserResponseEnvelope"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "404":
          $ref: "#/components/responses/NotFound"
    put:
      summary: Update the authenticated user's own profile
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdateUserInput"
      responses:
        "200":
          description: User updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UserResponseEnvelope"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "413":
          $ref: "#/components/responses/PayloadTooLarge"
    delete:
      summary: Delete the authenticated user's own account
      responses:
        "204":
          description: User deleted (no body)
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  headers:
    Retry-After:
      description: Seconds to wait before retrying
      schema:
        type: integer
    WWW-Authenticate:
      description: RFC 6750 bearer challenge, e.g. `Bearer error="invalid_token"`
      schema:
        type: string

  responses:
    BadRequest:
      description: Malformed body, query or path parameter
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
    Unauthorized:
      description: Missing or invalid bearer token
      headers:
        WWW-Authenticate:
          $ref: "#/components/headers/WWW-Authenticate"
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
    Forbidden:
      description: Authenticated as a different user
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
    NotFound:
      description: No such user
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
    PayloadTooLarge:
      description: Body exceeds the configured limit (http.body_limit)
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
    TooManyRequests:
      description: Credential endpoint throttled for this client address
      headers:
        Retry-After:
          $ref: "#/components/headers/Retry-After"
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"

  schemas:
    # ── Request bodies ────────────────────────────────────────────
    LoginRequest:
      type: object
      required: [email, password]
      properties:
        email: { type: string, format: email }
        password: { type: string }

    CreateUserInput:
      type: object
      required: [email, name, password]
      properties:
        email: { type: string, format: email }
        name: { type: string, minLength: 2, maxLength: 100 }
        password: { type: string, minLength: 8, maxLength: 72, description: "At most 72 bytes (the bcrypt bound)" }

    UpdateUserInput:
      type: object
      properties:
        name: { type: string, minLength: 2, maxLength: 100 }

    # ── Response payloads ─────────────────────────────────────────
    UserResponse:
      type: object
      properties:
        id: { type: integer, format: int64 }
        email: { type: string }
        name: { type: string }
        createdAt: { type: string, format: date-time }
        updatedAt: { type: string, format: date-time }

    PublicUserResponse:
      type: object
      description: Public projection, the name only; the directory is unauthenticated
      properties:
        name: { type: string }

    LoginResponse:
      type: object
      properties:
        accessToken: { type: string }
        tokenType: { type: string, example: Bearer }
        expiresIn: { type: integer, format: int64, description: "Lifetime in seconds (RFC 6749 expires_in)" }
        user: { $ref: "#/components/schemas/UserResponse" }

    PageMeta:
      type: object
      description: Page-based (admin) pagination; page and perPage echo the clamped values actually queried
      properties:
        page: { type: integer }
        perPage: { type: integer }
        totalPage: { type: integer }
        totalRecord: { type: integer, format: int64 }

    CursorMeta:
      type: object
      description: Keyset (public) pagination; nextCursor is empty once hasMore is false
      properties:
        hasMore: { type: boolean }
        nextCursor: { type: string }

    ProbeStatus:
      type: object
      properties:
        ok: { type: boolean }
        details:
          type: object
          description: Per-check outcome, "ok" or "fail"
          additionalProperties: { type: string }

    # ── Response envelopes ────────────────────────────────────────
    UserResponseEnvelope:
      type: object
      properties:
        success: { type: boolean }
        data: { $ref: "#/components/schemas/UserResponse" }
        requestId: { type: string }

    UserListResponseEnvelope:
      type: object
      properties:
        success: { type: boolean }
        data:
          type: array
          items: { $ref: "#/components/schemas/UserResponse" }
        meta: { $ref: "#/components/schemas/PageMeta" }
        requestId: { type: string }

    PublicUserListResponseEnvelope:
      type: object
      properties:
        success: { type: boolean }
        data:
          type: array
          items: { $ref: "#/components/schemas/PublicUserResponse" }
        meta: { $ref: "#/components/schemas/CursorMeta" }
        requestId: { type: string }

    LoginResponseEnvelope:
      type: object
      properties:
        success: { type: boolean }
        data: { $ref: "#/components/schemas/LoginResponse" }
        requestId: { type: string }

    ErrorResponse:
      type: object
      properties:
        success: { type: boolean, example: false }
        error:
          type: object
          properties:
            code: { type: integer, description: "Locale code identifier (negative), stable across languages" }
            message: { type: string, description: "Translated per Accept-Language" }
        requestId: { type: string }
