#!/bin/sh

echo "=== Running pre-commit checks... ==="

echo "\n>>> [1/3] make fmt"
make fmt
if [ $? -ne 0 ]; then
  echo "FAILED: make fmt"
  exit 1
fi
if [ -n "$(git diff)" ]; then
  echo "FAILED: make fmt produced changes. Please review, stage them, and commit again."
  echo "Run 'git diff' to see what changed."
  exit 1
fi

echo "\n>>> [2/3] make lint"
make lint
if [ $? -ne 0 ]; then
  echo "FAILED: make lint"
  exit 1
fi

echo "\n>>> [3/3] go build"
go build
if [ $? -ne 0 ]; then
  echo "FAILED: go build"
  echo "Build errors must be fixed before committing."
  exit 1
fi

echo "\n=== All pre-commit checks passed. ==="
