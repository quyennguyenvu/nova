### Setup

```bash
# Clone the repository
git clone https://{{.ModuleName}}.git
cd {{.ProjectName}}

# Copy environment variables; the binary loads ./.env on host runs
# (real environment variables win over it).
cp .env.example .env
{{- if not .HasWorker}}

# Generate an RS256 keypair and add the base64-encoded PEMs to .env.
# Only the token-issuing service needs JWT_PRIVATE_KEY; verify-only services
# set JWT_PUBLIC_KEY alone.
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
openssl rsa -in jwt.key -pubout -out jwt.pub
sed -i.bak "s|^JWT_PUBLIC_KEY=.*|JWT_PUBLIC_KEY=$(base64 < jwt.pub | tr -d '\n')|" .env
sed -i.bak "s|^JWT_PRIVATE_KEY=.*|JWT_PRIVATE_KEY=$(base64 < jwt.key | tr -d '\n')|" .env && rm .env.bak
{{- end}}

# Generate code and resolve dependencies. `make gen` runs{{if eq .QueryGen "sqlc"}} sqlc,{{end}}{{if .HasGRPC}} buf,{{end}} go mod tidy{{if .UseWire}}, wire{{end}} in the order that works.
make gen
{{- if and .IncludeDocker .HasDependencies}}

# Start infrastructure only — the app itself runs on the host below
docker compose up -d{{if eq .Database "mysql"}} mysql{{else if .HasDatabase}} postgres{{end}}{{if .HasRedis}} redis{{end}}{{if eq .MessageQueue "kafka"}} kafka{{end}}{{if eq .MessageQueue "rabbitmq"}} rabbitmq{{end}}{{if .HasElasticsearch}} elasticsearch{{end}}
{{- end}}
{{- if .HasDatabase}}

# Run migrations
make migrate-up
{{- end}}

# Run the server
{{- if .HasWorker}}
go run main.go worker
{{- else if .HasGRPC}}
go run main.go grpc
{{- else}}
go run main.go api
{{- end}}
```
