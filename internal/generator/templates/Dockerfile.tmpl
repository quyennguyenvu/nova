# syntax=docker/dockerfile:1.7

# This image assumes the repository contains the committed code generated by
# `make gen`{{if .UseWire}} (wire_gen.go{{if eq .QueryGen "sqlc"}}, internal/adapter/repository/{{.Database}}/dbgen/{{end}}){{else if eq .QueryGen "sqlc"}} (internal/adapter/repository/{{.Database}}/dbgen/){{end}}.
# Run `make gen` locally after `nova new` and commit before building images.

# ── Build stage ──────────────────────────────────────────────────────────
FROM golang:{{.GoVersion}}-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /out/api .

# ── Runtime stage ────────────────────────────────────────────────────────
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S app && adduser -S app -G app

WORKDIR /app

COPY --from=builder /out/api /app/api
{{- if eq .ConfigFormat "yaml"}}
COPY --from=builder /src/internal/infrastructure/config /app/config
{{- end}}
{{- if .HasSQL}}
{{- if eq .QueryGen "sqlc"}}
COPY --from=builder /src/sqlc/migrations /app/migrations
{{- else}}
COPY --from=builder /src/migrations /app/migrations
{{- end}}
{{- end}}

USER app
EXPOSE 8080

# Probes the readiness endpoint, not the liveness one, so the container is
# only "healthy" once DB/cache are reachable. start-period=10s gives the app
# time to dial dependencies on cold boot.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/readyz >/dev/null 2>&1 || exit 1

ENTRYPOINT ["/app/api"]
CMD ["api"]
