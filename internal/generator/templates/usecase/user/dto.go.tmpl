package user

import "time"

// Input/output DTOs — what the use case consumes and returns.
// The transport layer owns json/validate tags; the assembler maps to/from these.

type RegisterInput struct {
	Email    string
	Name     string
	Password string
}

type UpdateInput struct {
	Name string
}

// ListInput is the use case's read-side filter shape. Transport hands raw
// filter values in; the service converts to domain.UserFilter internally so
// transport never imports the domain package. Email is an optional exact-match
// filter — empty means "no email filter".
type ListInput struct {
	Email  string
	Limit  int
	Offset int
}

// Output is the use-case's return shape — the transport layer projects it
// into the wire format. Entities never cross this boundary.
type Output struct {
	ID        int64
	Email     string
	Name      string
	CreatedAt time.Time
	UpdatedAt time.Time
}

// LoginInput is the credential payload accepted by Service.Login.
type LoginInput struct {
	Email    string
	Password string
}

// LoginOutput bundles the access token, its lifetime, and the user profile
// the transport layer projects into the response.
type LoginOutput struct {
	AccessToken string
	ExpiresIn   int64 // seconds; RFC 6749 expires_in
	User        *Output
}
