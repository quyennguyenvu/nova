package user

import "time"

// Input/output DTOs — what the use case consumes and returns.
// The transport layer owns json/validate tags; the assembler maps to/from these.

type RegisterInput struct {
	Email    string
	Name     string
	Password string
}

type UpdateInput struct {
	Name string
}

// ListInput is the use case's read-side filter shape. Transport hands raw
// ints in; the service converts to domain.UserFilter internally so transport
// never imports the domain package.
type ListInput struct {
	Limit  int
	Offset int
}

// Output is the use-case's return shape — the transport layer projects it
// into the wire format. Entities never cross this boundary.
type Output struct {
	ID        int64
	Email     string
	Name      string
	CreatedAt time.Time
	UpdatedAt time.Time
}
