// Service implements the user use case. It never calls the logger directly —
// it wraps errors with errors.Wrapf and lets the transport boundary log once.
//
// Note the JWT TokenService dependency: Login lives on this service rather
// than a separate auth feature because authentication IS a user concern in
// the scaffold. Split it out when admin/service-account auth diverges from
// end-user auth.
type Service struct {
	userRepo  domain.UserRepository
	hasher    security.PasswordHasher
	tokenSvc  *jwtsec.TokenService
{{- if .HasMessageQueue}}
	publisher domain.UserPublisher
{{- end}}

	// timing hash for Login's unknown-email path; built on first use.
	dummyMu   sync.Mutex
	dummyHash string
}

func NewService(
	userRepo domain.UserRepository,
	hasher security.PasswordHasher,
	tokenSvc *jwtsec.TokenService,
{{- if .HasMessageQueue}}
	publisher domain.UserPublisher,
{{- end}}
) *Service {
	return &Service{
		userRepo: userRepo,
		hasher:   hasher,
		tokenSvc: tokenSvc,
{{- if .HasMessageQueue}}
		publisher: publisher,
{{- end}}
	}
}

func (s *Service) Register(ctx context.Context, input RegisterInput) (*Output, error) {
	if len(input.Password) > security.MaxPasswordLen {
		return nil, errors.L(locale.InvalidRequest).
			WithCause(fmt.Errorf("password longer than %d bytes", security.MaxPasswordLen))
	}
	// Treat ErrNotFound as the only "ok, proceed" outcome; any other error
	// from the lookup (DB outage, network) must propagate so we don't
	// race-create a duplicate row when the uniqueness check itself failed.
	existing, err := s.userRepo.GetByEmail(ctx, input.Email)
	switch {
	case err == nil && existing != nil:
		// Locale-coded error: transport translates UserEmailExists with input.Email
		// substituted into the user's language (e.g. "Email foo@bar already exists").
		return nil, errors.L(locale.UserEmailExists, input.Email).WithCause(errors.New("email already registered"))
	case err != nil && !errors.Is(err, errors.ErrNotFound):
		return nil, errors.Wrapf(err, "register user email=%s: lookup", input.Email)
	}

	hash, err := s.hasher.Hash(input.Password)
	if err != nil {
		return nil, errors.Wrapf(err, "register user email=%s: hash", input.Email)
	}

	now := time.Now()
	user := &entity.User{
		Email:        input.Email,
		Name:         input.Name,
		PasswordHash: hash,
		CreatedAt:    now,
		UpdatedAt:    now,
	}
	if createErr := s.userRepo.Create(ctx, user); createErr != nil {
		return nil, errors.Wrapf(createErr, "register user email=%s", input.Email)
	}

{{- if .HasMessageQueue}}
	// best-effort publish — user is already persisted; broker outage shouldn't fail the request.
	// Failure is logged so it can drive an alert; the API still returns success.
	if pubErr := s.publisher.PublishUserCreated(ctx, domain.UserCreated{
		UserID:    user.ID,
		Email:     user.Email,
		Name:      user.Name,
		CreatedAt: user.CreatedAt,
	}); pubErr != nil {
		logctx.From(ctx).Error("publish user.created failed",
			"user_id", user.ID,
			"err", pubErr,
		)
	}

{{- end}}

	return toOutput(user), nil
}

func (s *Service) Get(ctx context.Context, id int64) (*Output, error) {
	user, err := s.userRepo.GetByID(ctx, id)
	if err != nil {
		return nil, errors.Wrapf(err, "get user id=%d", id)
	}
	return toOutput(user), nil
}

func (s *Service) Update(ctx context.Context, id int64, input UpdateInput) (*Output, error) {
	if err := requireSelf(ctx, id); err != nil {
		return nil, err
	}
	user, err := s.userRepo.GetByID(ctx, id)
	if err != nil {
		return nil, errors.Wrapf(err, "update user id=%d: load", id)
	}

	if input.Name != "" {
		user.Name = input.Name
	}

	if updateErr := s.userRepo.Update(ctx, user); updateErr != nil {
		return nil, errors.Wrapf(updateErr, "update user id=%d: persist", id)
	}
	return toOutput(user), nil
}

func (s *Service) Delete(ctx context.Context, id int64) error {
	if err := requireSelf(ctx, id); err != nil {
		return err
	}
	if err := s.userRepo.Delete(ctx, id); err != nil {
		return errors.Wrapf(err, "delete user id=%d", id)
	}
	return nil
}

// requireSelf enforces that the authenticated principal is the user being
// mutated. It lives here, not in the handler, so every transport applies the
// same rule: no principal is 401, another user's id is 403. Widen it (roles,
// an admin audience) here when the product needs it.
func requireSelf(ctx context.Context, id int64) error {
	p, ok := identity.UserPrincipalFromContext(ctx)
	if !ok {
		return errors.L(locale.Unauthorized).WithCause(errors.New("no principal in context"))
	}
	if p.UserID != id {
		return errors.L(locale.Forbidden).WithCause(fmt.Errorf("user %d may not modify user %d", p.UserID, id))
	}
	return nil
}

// List page-bounds: defaults + caps live here so every transport (HTTP, gRPC,
// CLI) inherits the same policy. Transport hands raw ints in; we clamp before
// they ever reach the repo.
const (
	listDefaultPerPage = 10
	listMaxPerPage     = 500
)

// List returns one admin (page-based) page of users plus the totals needed to
// render "page N of M". It runs the page query and a COUNT against the same
// filter; the COUNT ignores Limit/Offset. Page/PerPage in the result are the
// clamped values, so the caller's page meta matches what was actually queried.
func (s *Service) List(ctx context.Context, input ListInput) (*ListOutput, error) {
	perPage := input.PerPage
	if perPage <= 0 || perPage > listMaxPerPage {
		perPage = listDefaultPerPage
	}
	page := input.Page
	if page <= 0 {
		page = 1
	}
	// Offsets are int32 at the repo boundary; refuse pages that cannot be
	// addressed instead of letting the conversion wrap negative.
	offset := int64(page-1) * int64(perPage)
	if offset > math.MaxInt32 {
		return nil, errors.L(locale.InvalidRequest).WithCause(fmt.Errorf("page %d out of range", page))
	}
	filter := domain.UserFilter{
		Email:  input.Email,
		Limit:  int32(perPage),
		Offset: int32(offset),  //nolint:gosec // bounded by the MaxInt32 check above
	}
	users, err := s.userRepo.List(ctx, filter)
	if err != nil {
		return nil, errors.Wrapf(err, "list users page=%d perPage=%d", page, perPage)
	}
	total, err := s.userRepo.Count(ctx, filter)
	if err != nil {
		return nil, errors.Wrapf(err, "count users email=%s", input.Email)
	}
	items := make([]*Output, len(users))
	for i, u := range users {
		items[i] = toOutput(u)
	}
	return &ListOutput{
		Items:       items,
		Page:        page,
		PerPage:     perPage,
		TotalRecord: total,
	}, nil
}

// PublicList returns one cursor-paginated page of the public user directory
// (email + name), for unauthenticated callers. It reads limit+1 rows so it can
// report HasMore without a second query, trims the extra, and encodes the last
// kept id as the next opaque cursor. Keyset paging (id > cursor) stays stable
// under concurrent inserts and avoids deep-OFFSET scans.
func (s *Service) PublicList(ctx context.Context, input PublicListInput) (*PublicListOutput, error) {
	limit := input.Limit
	if limit <= 0 || limit > listMaxPerPage {
		limit = listDefaultPerPage
	}
	cursor, err := decodeCursor(input.Cursor)
	if err != nil {
		// Opaque token the client got from us; a malformed one is a bad request.
		return nil, errors.L(locale.InvalidRequest).WithCause(err)
	}

	users, err := s.userRepo.ListAfter(ctx, cursor, int32(limit+1))
	if err != nil {
		return nil, errors.Wrapf(err, "public list users cursor=%d limit=%d", cursor, limit)
	}

	hasMore := len(users) > limit
	if hasMore {
		users = users[:limit]
	}
	items := make([]*PublicOutput, len(users))
	for i, u := range users {
		items[i] = &PublicOutput{Email: u.Email, Name: u.Name}
	}
	var next string
	if hasMore && len(users) > 0 {
		next = encodeCursor(users[len(users)-1].ID)
	}
	return &PublicListOutput{Items: items, NextCursor: next, HasMore: hasMore}, nil
}

// encodeCursor turns a row id into the opaque token clients echo back as the
// next cursor. It is base64(id) — not encryption, just an opaque handle so
// clients can't forge offsets. decodeCursor reverses it; "" means start.
func encodeCursor(id int64) string {
	return base64.RawURLEncoding.EncodeToString([]byte(strconv.FormatInt(id, 10)))
}

func decodeCursor(s string) (int64, error) {
	if s == "" {
		return 0, nil
	}
	raw, err := base64.RawURLEncoding.DecodeString(s)
	if err != nil {
		return 0, err
	}
	return strconv.ParseInt(string(raw), 10, 64)
}

// timingHash returns the hash used to equalize the cost of an unknown-email
// login with a wrong-password login (bcrypt.CompareHashAndPassword is
// CPU-bound, so a fast "not found" would be an enumeration oracle). It is
// computed on first use; if hashing fails the login fails closed rather than
// answering quickly.
func (s *Service) timingHash() (string, error) {
	s.dummyMu.Lock()
	defer s.dummyMu.Unlock()
	if s.dummyHash == "" {
		h, err := s.hasher.Hash("dummy-password-for-timing-uniformity")
		if err != nil {
			return "", err
		}
		s.dummyHash = h
	}
	return s.dummyHash, nil
}

// Login verifies email+password and returns a signed access token + the user
// profile. Returns InvalidCredentials (401) for both "no such user" and "bad
// password" so attackers can't enumerate accounts via status or timing — the
// unknown-user path consumes a bcrypt verify against the timing hash so
// wall-clock time matches the bad-password path.
func (s *Service) Login(ctx context.Context, input LoginInput) (*LoginOutput, error) {
	dummy, err := s.timingHash()
	if err != nil {
		return nil, errors.Wrap(err, "login: timing hash")
	}

	user, err := s.userRepo.GetByEmail(ctx, input.Email)
	if err != nil {
		if errors.Is(err, errors.ErrNotFound) {
			_ = s.hasher.Verify(dummy, input.Password)
			return nil, errors.L(locale.InvalidCredentials).WithCause(errors.New("account not found"))
		}
		return nil, errors.Wrapf(err, "login email=%s: lookup", input.Email)
	}

	if verifyErr := s.hasher.Verify(user.PasswordHash, input.Password); verifyErr != nil {
		return nil, errors.L(locale.InvalidCredentials).WithCause(verifyErr)
	}

	principal := &identity.UserPrincipal{
		Principal: identity.Principal{UserID: user.ID, Email: user.Email},
		Name:      user.Name,
	}
	token, err := s.tokenSvc.Sign(principal)
	if err != nil {
		return nil, errors.Wrapf(err, "login email=%s: sign", input.Email)
	}

	return &LoginOutput{
		AccessToken: token,
		ExpiresIn:   int64(s.tokenSvc.AccessTokenTTL().Seconds()),
		User:        toOutput(user),
	}, nil
}

func toOutput(u *entity.User) *Output {
	return &Output{
		ID:        u.ID,
		Email:     u.Email,
		Name:      u.Name,
		CreatedAt: u.CreatedAt,
		UpdatedAt: u.UpdatedAt,
	}
}
