name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

# This pipeline assumes the repository contains the committed code generated
# by `make gen` ({{if .UseWire}}wire_gen.go{{end}}{{if and .UseWire (eq .QueryGen "sqlc")}}, {{end}}{{if eq .QueryGen "sqlc"}}internal/adapter/repository/{{.Database}}/dbgen/{{end}}).
# Run `make gen` locally after `nova new` and commit the output before pushing.

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '{{.GoVersion}}'
          cache: true

      - name: golangci-lint
        uses: golangci/golangci-lint-action@v6
        with:
          version: latest

  tidy:
    name: go mod tidy
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '{{.GoVersion}}'
          cache: true

      # Catches forgotten dep updates: re-running tidy should be a no-op on
      # a clean PR; any drift fails the job.
      - name: Verify go.mod/go.sum are tidy
        run: |
          go mod tidy
          git diff --exit-code go.mod go.sum

  test:
    name: Test
    runs-on: ubuntu-latest
{{- if .HasDatabase}}

    services:
{{- if eq .Database "postgres"}}
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: {{.ProjectName}}_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
{{- end}}
{{- if eq .Database "mysql"}}
      mysql:
        image: mysql:8
        env:
          MYSQL_ROOT_PASSWORD: root
          MYSQL_DATABASE: {{.ProjectName}}_test
        ports:
          - 3306:3306
        options: >-
          --health-cmd="mysqladmin ping -uroot -proot"
          --health-interval=10s
          --health-timeout=5s
          --health-retries=5
{{- end}}
{{- if .HasRedis}}
      redis:
        image: redis:7-alpine
        ports:
          - 6379:6379
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
{{- end}}
{{- end}}

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '{{.GoVersion}}'
          cache: true

      - name: Run tests
        run: go test -v -race -coverprofile=coverage.out ./...
        # JWT_SECRET is a CI-only fixture so config.Load passes the
        # min-entropy check in NewTokenService. Real deployments inject a
        # rotating production secret via a secrets manager.
        env:
          JWT_SECRET: ci-test-secret-must-be-at-least-32-bytes-long
          JWT_ISSUER: {{.ProjectName}}
          JWT_AUDIENCE: {{.ProjectName}}
{{- if .HasDatabase}}
{{- if eq .Database "postgres"}}
          DB_HOST: localhost
          DB_PORT: 5432
          DB_USER: postgres
          DB_PASSWORD: postgres
          DB_NAME: {{.ProjectName}}_test
          DB_SSL_MODE: disable
{{- end}}
{{- if eq .Database "mysql"}}
          DB_HOST: 127.0.0.1
          DB_PORT: 3306
          DB_USER: root
          DB_PASSWORD: root
          DB_NAME: {{.ProjectName}}_test
{{- end}}
{{- end}}
{{- if .HasRedis}}
          REDIS_MODE: single
          REDIS_ADDRS: localhost:6379
{{- end}}

      - name: Upload coverage
        uses: actions/upload-artifact@v4
        with:
          name: coverage
          path: coverage.out
          if-no-files-found: ignore

  build:
    name: Build
    runs-on: ubuntu-latest
    needs: [lint, tidy, test]
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '{{.GoVersion}}'
          cache: true

      - name: Build
        run: go build -ldflags="-w -s" -o bin/api .
