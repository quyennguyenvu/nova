name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

# This pipeline assumes the repository contains the committed code generated
# by `make gen` ({{if .UseWire}}wire_gen.go{{end}}{{if and .UseWire (eq .QueryGen "sqlc")}}, {{end}}{{if eq .QueryGen "sqlc"}}internal/adapter/repository/{{.Database}}/dbgen/{{end}}).
# Run `make gen` locally after `nova new` and commit the output before pushing.

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '{{.GoVersion}}'
          cache: true

      # v8 of the action drives golangci-lint v2 (the generated config is a
      # v2 config); the version is pinned so a release cannot change the verdict.
      - name: golangci-lint
        uses: golangci/golangci-lint-action@v8
        with:
          version: v2.11.4

  tidy:
    name: go mod tidy
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '{{.GoVersion}}'
          cache: true

      # Catches forgotten dep updates: re-running tidy should be a no-op on
      # a clean PR; any drift fails the job.
      - name: Verify go.mod/go.sum are tidy
        run: |
          go mod tidy
          git diff --exit-code go.mod go.sum

  test:
    name: Test
    runs-on: ubuntu-latest
    # No service containers and no fixtures: the rendered tests are hermetic
    # (fakes for every port, driver errors built by hand). Add services here
    # only when an integration test needs them.
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '{{.GoVersion}}'
          cache: true

      - name: Run tests
        run: go test -v -race -coverprofile=coverage.out ./...

      - name: Upload coverage
        uses: actions/upload-artifact@v4
        with:
          name: coverage
          path: coverage.out
          if-no-files-found: ignore

  build:
    name: Build
    runs-on: ubuntu-latest
    needs: [lint, tidy, test]
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '{{.GoVersion}}'
          cache: true

      - name: Build
        run: go build -trimpath -ldflags="-w -s" -o bin/api .
